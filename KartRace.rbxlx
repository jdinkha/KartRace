	Gust = { "rbxasset://sounds/action_falling.mp3", 1.4 }, -- wind howling while a gust blows you sideways (and around every windy stretch)
	Respawn = { "rbxassetid://76613566776682", 0.6 }, -- a warpy whoosh as you're put back on the track
	CountdownBeep = { "rbxassetid://124455167265111", 0.6, 1.5 }, -- 3, 2, 1 (and higher for GO!)
	Victory = { "rbxassetid://1836473422", 0.6 }, -- you crossed the finish line!
	TimeUp = { "rbxassetid://190705984", 0.6 }, -- the race ended before you finished
