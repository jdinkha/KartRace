	LightGreen = Color3.fromRGB(60, 255, 90),
	Lava = Color3.fromRGB(235, 90, 20),
	Ice = Color3.fromRGB(175, 225, 255),
	OffRoad = Color3.fromRGB(100, 175, 80),
	Hazard = Color3.fromRGB(255, 200, 30),
	HazardDark = Color3.fromRGB(35, 35, 35),
	Tunnel = Color3.fromRGB(95, 90, 100),
	TunnelLight = Color3.fromRGB(255, 230, 160),
}

-- The glowing arches over the track cycle through these
local RAINBOW = {
	Color3.fromRGB(255, 70, 70),
	Color3.fromRGB(255, 160, 40),
	Color3.fromRGB(255, 230, 60),
