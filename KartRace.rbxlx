	Color3.fromRGB(150, 100, 60),
}

------------------------------------------------------------------------
-- THEMES  —  how each style of track looks: colours, sky and weather.
-- Any colour a theme doesn't list comes from COLORS above.
------------------------------------------------------------------------
local THEMES = {
	Sky = {
		RainbowCurbs = true, -- rainbow stripes along both edges of the road
		OffRoad = Color3.fromRGB(110, 195, 90), -- grass verges
		OffRoadMaterial = Enum.Material.Grass,
		Rock = Color3.fromRGB(245, 248, 255), -- "Rock" obstacles here are soft white cloud pillars
		RockMaterial = Enum.Material.SmoothPlastic,
		Ground = Color3.fromRGB(236, 244, 255), -- a soft sea of clouds below the track
		GroundMaterial = Enum.Material.SmoothPlastic,
		RoadMaterial = Enum.Material.Asphalt,
		PillarMaterial = Enum.Material.Concrete,
		Gates = RAINBOW, -- colours of the glowing arches over the road
		Crowd = { "Bunny", "Owl", "Bee", "Cat", "Dog", "Fox" }, -- characters cheering in the grandstand (see the Mascots module)
		ClockTime = 14.5,
		Atmosphere = { Density = 0.3, Offset = 0.25, Color = Color3.fromRGB(199, 225, 255), Decay = Color3.fromRGB(104, 132, 170), Glare = 0.2, Haze = 1.2 },
		Clouds = { Cover = 0.6, Density = 0.6, Color = Color3.fromRGB(255, 255, 255) },
	},
	Lava = {
		Road = Color3.fromRGB(50, 44, 46),
		RoadMaterial = Enum.Material.Basalt,
		CurbA = Color3.fromRGB(255, 120, 30),
		CurbB = Color3.fromRGB(40, 32, 32),
		Wall = Color3.fromRGB(100, 42, 30),
		WallStripe = Color3.fromRGB(255, 150, 40),
		Pillar = Color3.fromRGB(62, 52, 52),
		PillarMaterial = Enum.Material.Basalt,
		Gates = { Color3.fromRGB(255, 70, 30), Color3.fromRGB(255, 150, 30), Color3.fromRGB(255, 225, 70) },
		Crowd = { "Dragon", "Fox", "Robot", "Bear" },
		Ground = Color3.fromRGB(225, 85, 20), -- a glowing sea of lava under the track
