local bigTween: Tween? = nil
local function showBig(text: string, color: Color3?, hold: number?)
	if bigTween then
		bigTween:Cancel()
	end
	bigLabel.Text = text
	bigLabel.TextColor3 = color or WHITE
	bigLabel.TextTransparency = 0
	bigLabel.TextStrokeTransparency = 0
	bigLabel.Size = UDim2.fromScale(0.9, 0.25)
	TweenService:Create(bigLabel, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromScale(0.8, 0.2) }):Play()
	local fade = TweenService:Create(
		bigLabel,
		TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, hold or 0.6),
		{ TextTransparency = 1, TextStrokeTransparency = 1 }
	)
	bigTween = fade
	fade:Play()
end

local feedVersion = 0
local function showFeed(text: string)
	feedVersion += 1
	local version = feedVersion
	feedLabel.Text = text
	feedLabel.TextTransparency = 0
	feedLabel.TextStrokeTransparency = 0.4
	task.delay(3, function()
		if feedVersion == version then
			feedLabel.TextTransparency = 1
			feedLabel.TextStrokeTransparency = 1
		end
	end)
end

local hintVersion = 0
local function showHint()
	local text
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		text = "Thumbstick: drive & steer  •  Hold DRIFT while turning  •  RESET: back to checkpoint"
	elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
		text = "RT: gas  •  LT: brake  •  Stick: steer  •  Hold RB while turning: drift  •  Y: respawn"
	else
		text = "W/S: gas & brake  •  A/D: steer  •  Hold Space while turning: drift  •  R: respawn"
	end
	hintVersion += 1
	local version = hintVersion
	hintLabel.Text = text
	hintLabel.Visible = true
	task.delay(8, function()
		if hintVersion == version then
			hintLabel.Visible = false
		end
	end)
end

local resultsVersion = 0
local function showResults(list: { any })
	for _, child in resultsFrame:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	textLabel({ LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 34), Text = "RACE RESULTS", TextColor3 = PLACE_COLORS[1] }, resultsFrame)
	for i, entry in list do
		if i > 12 then
			break
		end
		local row = make("Frame", { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1 }, resultsFrame)
		local place = if typeof(entry.place) == "number" then entry.place else nil
		local color = if place then (PLACE_COLORS[place] or WHITE) else Color3.fromRGB(150, 150, 160)
		textLabel({ Size = UDim2.fromScale(0.18, 1), Text = if place then ordinal(place) else "DNF", TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Left }, row)
		textLabel({ Position = UDim2.fromScale(0.2, 0), Size = UDim2.fromScale(0.52, 1), Text = tostring(entry.name), TextXAlignment = Enum.TextXAlignment.Left }, row)
		textLabel({
			Position = UDim2.fromScale(0.72, 0),
			Size = UDim2.fromScale(0.28, 1),
			Text = if typeof(entry.time) == "number" then formatTime(entry.time) else "—",
			TextColor3 = Color3.fromRGB(190, 190, 200),
			TextXAlignment = Enum.TextXAlignment.Right,
		}, row)
	end
	resultsFrame.Visible = true
	resultsVersion += 1
	local version = resultsVersion
	task.delay(7, function()
		if resultsVersion == version then
			resultsFrame.Visible = false
		end
	end)
end

------------------------------------------------------------------------
-- DRIVING
------------------------------------------------------------------------
type DriveState = {
	kart: Model,
	track: Instance?, -- the race track we're driving on
	hitbox: BasePart,
	seat: VehicleSeat,
	align: AlignOrientation,
	humanoid: Humanoid,
	heading: number,
	boostTime: number,
	drifting: boolean,
	driftDir: number,
	driftTime: number,
	sparkTier: number,
	camPos: Vector3?,
	lastFallRequest: number,
	sparks: { ParticleEmitter },
	flame: ParticleEmitter?,
	effects: { Instance },
	rideHeight: number, -- how high the kart's centre floats above the road
	groundUp: Vector3, -- smoothed "up" of the road under the kart
	lastVelocity: Vector3?, -- the velocity we set last frame (to notice wall hits)
	wasGrounded: boolean,
	wallGrace: number, -- seconds before wall hits count (right after GO/respawn the server may still be moving the kart)
	shake: number, -- camera shake after a wall hit, fades to 0
	spin: number, -- seconds left of a spin-out after a hazard hit
	pop: number, -- seconds left of ignoring the road (so a geyser can throw the kart up)
	hazardGrace: number, -- seconds before the next hazard hit counts
	bumped: { [Instance]: number }, -- other karts we just bumped, and when we can bump them again
	driftSound: Sound, -- tyre squeal while drifting
	airTime: number, -- seconds in the air so far (for the landing thump)
	lastHitSound: number, -- when a wall hit last made a sound (so scraping isn't a machine gun)
}

local drive: DriveState? = nil
local driftHeld = false

-- Only the road surface counts as ground (not walls or decorations)
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.FilterDescendantsInstances = {} -- set to the current track's Road folder when you get in a kart

-- Local-only particle effects (only you see your sparks in this MVP)
local function createEffects(hitbox: BasePart): ({ ParticleEmitter }, ParticleEmitter?, { Instance })
	local sparks: { ParticleEmitter } = {}
	local effects: { Instance } = {}
	for _, name in { "RearLeft", "RearRight" } do
		local attachment = hitbox:FindFirstChild(name)
		if attachment then
			local emitter = Instance.new("ParticleEmitter")
			emitter.Name = "DriftSparks"
			emitter.Rate = 70
			emitter.Lifetime = NumberRange.new(0.12, 0.25)
			emitter.Speed = NumberRange.new(8, 14)
			emitter.SpreadAngle = Vector2.new(35, 35)
			emitter.Size = NumberSequence.new(0.35, 0)
			emitter.LightEmission = 1
			emitter.EmissionDirection = Enum.NormalId.Back
			emitter.Enabled = false
			emitter.Parent = attachment
			table.insert(sparks, emitter)
			table.insert(effects, emitter)
		end
	end
	local flame: ParticleEmitter? = nil
	local exhaust = hitbox:FindFirstChild("Exhaust")
	if exhaust then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "BoostFlame"
		emitter.Texture = "rbxasset://textures/particles/fire_main.dds"
		emitter.Color = ColorSequence.new(Color3.fromRGB(255, 210, 90), Color3.fromRGB(255, 80, 20))
		emitter.Rate = 90
		emitter.Lifetime = NumberRange.new(0.15, 0.3)
		emitter.Speed = NumberRange.new(10, 16)
		emitter.Size = NumberSequence.new(1.1, 0.2)
		emitter.LightEmission = 1
		emitter.EmissionDirection = Enum.NormalId.Back
		emitter.Enabled = false
		emitter.Parent = exhaust
		flame = emitter
		table.insert(effects, emitter)
	end
	return sparks, flame, effects
end

type Ground = {
	normal: Vector3, -- which way is "up" on the road here
	distance: number, -- from the kart's centre down to the road
	boost: boolean, -- touching a boost pad?
	grip: number, -- 1 = normal road, lower = slippery (ice)
}

-- How grippy a piece of road is (ice has a "Grip" attribute below 1)
local function gripOf(part: Instance): number
	local grip = part:GetAttribute("Grip")
	return if typeof(grip) == "number" then math.clamp(grip, 0.05, 1) else 1
end

-- Feels for the road under the kart. Returns nil when the kart is in the air.
local function senseGround(d: DriveState): Ground?
	local cf = d.hitbox.CFrame
	local down = -cf.UpVector
	local falling = math.max(0, d.hitbox.AssemblyLinearVelocity:Dot(down))
	-- look a bit further when dropping fast, so landings get caught in time
	local ray = down * (d.rideHeight + HANDLING.STICK_DISTANCE + falling * 0.05)

	local center = workspace:Raycast(cf.Position, ray, rayParams)
	local boost = center ~= nil and center.Instance:GetAttribute("BoostPad") == true
	local grip = if center then gripOf(center.Instance) else 1
	local corners: { RaycastResult } = {}
	local cornerCount = 0
	for i, offset in GROUND_PROBES do
		local hit = workspace:Raycast(cf:PointToWorldSpace(offset), ray, rayParams)
		if hit then
			corners[i] = hit
			cornerCount += 1
			if hit.Instance:GetAttribute("BoostPad") then
				boost = true
			end
		end
	end

	-- All four corners over the road: use the plane through them. This averages
	-- out seams and creases, so the kart glides instead of twitching.
	if cornerCount == 4 then
		local fl, fr, bl, br = corners[1].Position, corners[2].Position, corners[3].Position, corners[4].Position
		local normal = (fr - bl):Cross(fl - br)
		if normal.Magnitude > 1e-3 then
			normal = normal.Unit
			if normal.Y < 0 then
				normal = -normal
			end
			if normal.Y > 0.5 then
				local middle = (fl + fr + bl + br) / 4
				return { normal = normal, distance = (cf.Position - middle):Dot(normal), boost = boost, grip = grip }
			end
		end
	end
	-- Otherwise (e.g. right at the lip of the jump) trust the middle ray alone
	if center and center.Normal.Y > 0.3 then
		return { normal = center.Normal, distance = (cf.Position - center.Position):Dot(center.Normal), boost = boost, grip = grip }
	end
	return nil
end

-- Hazards (lava, fire bars, snowballs, geysers, wind) live in the track's
-- Hazards folder. The kart feels for them with a spatial query each frame.
local hazardParams = OverlapParams.new()
hazardParams.FilterType = Enum.RaycastFilterType.Include

-- Is a timed hazard (geyser, wind gust) going right now? Also returns how
-- many seconds into its cycle it is. Uses the server clock, so it's the same
-- moment on every player's screen.
local function hazardCycle(item: Instance, now: number): (boolean, number)
	local period = numberAttr(item, "Period")
	if period <= 0 then
		return true, 0
	end
	local t = (now + numberAttr(item, "Offset")) % period
	return t < numberAttr(item, "Active"), t
end

-- Knocks the kart away from `from` (and `lift` upwards), slows it and spins it out
local function knockBack(d: DriveState, velocity: Vector3, from: Vector3, power: number, lift: number): Vector3
	local away = d.hitbox.Position - from
	away = Vector3.new(away.X, 0, away.Z)
	if away.Magnitude < 0.1 then
		away = -CFrame.Angles(0, d.heading, 0).LookVector
	end
	d.spin = HANDLING.SPIN_TIME
	d.hazardGrace = HANDLING.HAZARD_GRACE
	d.drifting = false
	d.boostTime = 0
	d.shake = 1
	if lift > 0 then
		d.pop = 0.2
	end
	return Vector3.new(velocity.X, 0, velocity.Z) * 0.35 + away.Unit * power + Vector3.yAxis * lift
end

-- Whatever hazards the kart is touching right now act on its velocity
local function touchHazards(d: DriveState, velocity: Vector3, dt: number): Vector3
	local hazards = if d.track then d.track:FindFirstChild("Hazards") else nil
	if not hazards then
		return velocity
	end
	hazardParams.FilterDescendantsInstances = { hazards }
	local now = workspace:GetServerTimeNow()
	for _, part in workspace:GetPartsInPart(d.hitbox, hazardParams) do
		local kind = part:GetAttribute("Hazard")
		if kind == "Wind" then
			local push = part:GetAttribute("Push")
			if typeof(push) == "Vector3" and hazardCycle(part, now) then
				velocity += push * dt
			end
		elseif d.hazardGrace > 0 then
			continue
		elseif kind == "Burn" then
			-- Lava: stop, and ask the server to put us back at the last checkpoint
			velocity *= 0.3
			if os.clock() - d.lastFallRequest > 1 then
				d.lastFallRequest = os.clock()
				showBig("TOO HOT!", Color3.fromRGB(255, 120, 40), 0.5)
				playSound("Fire", d.hitbox)
				raceEvent:FireServer("Respawn", "Lava")
			end
		elseif kind == "Bonk" then
			velocity = knockBack(d, velocity, part.Position, HANDLING.BONK_SPEED, 15)
			playSound(if part.Name == "Snowball" then "Snowball" else "Fire", d.hitbox, 1.2)
		elseif kind == "Launch" then
			velocity = knockBack(d, velocity, part.Position, HANDLING.BONK_SPEED * 0.4, HANDLING.LAUNCH_SPEED)
			playSound("Geyser", d.hitbox)
		end
	end
	return velocity
end

-- On tracks with "Bumping", karts that touch shove each other apart. Every
-- player's device only ever pushes its own kart (karts still pass through
-- each other in the physics), so there's no laggy tug-of-war between devices.
local function bumpKarts(d: DriveState, velocity: Vector3): Vector3
	local power = if d.track then d.track:GetAttribute("Bumping") else nil
	local karts = d.kart.Parent
	if typeof(power) ~= "number" or power <= 0 or not karts then
		return velocity
	end
	local now = os.clock()
	local myPos = d.hitbox.Position
	for _, other in karts:GetChildren() do
		local box = if other ~= d.kart and other:IsA("Model") then other.PrimaryPart else nil
		if not box or box.Anchored or (d.bumped[other] or 0) > now then
			continue
		end
		local otherVelocity = box.AssemblyLinearVelocity
		local offset = myPos - (box.Position + otherVelocity * HANDLING.BUMP_LEAD)
		local flat = Vector3.new(offset.X, 0, offset.Z)
		if math.abs(offset.Y) > 4 or flat.Magnitude >= HANDLING.BUMP_RADIUS then
			continue
		end
		d.bumped[other] = now + 0.35
		local away = if flat.Magnitude > 0.1 then flat.Unit else CFrame.Angles(0, d.heading, 0).RightVector
		local closing = math.max(0, (otherVelocity - velocity):Dot(away)) -- how fast we were coming together
		velocity += away * math.min((HANDLING.BUMP_SPEED + closing * HANDLING.BUMP_TRANSFER) * power, HANDLING.BUMP_MAX)
		d.shake = math.max(d.shake, 0.4)
		playSound("KartBump", d.hitbox, 0.9 + math.random() * 0.25)
	end
	return velocity
end

local function driveStep(dt: number)
	local d = drive
	if not d then
		return
	end
	local hitbox = d.hitbox

	-- Frozen on the grid during the countdown
	if hitbox.Anchored then
		d.heading = headingOf(hitbox.CFrame)
		d.boostTime = 0
		d.drifting = false
		d.lastVelocity = nil
		d.wallGrace = 0.5
		return
	end
	d.wallGrace = math.max(0, d.wallGrace - dt)
	d.hazardGrace = math.max(0, d.hazardGrace - dt)
	d.spin = math.max(0, d.spin - dt)
	d.pop = math.max(0, d.pop - dt)

	-- (no driving while spinning out after a hazard hit)
	local canDrive = raceState:GetAttribute("Phase") == "Racing" and player:GetAttribute("Finished") ~= true and d.spin <= 0
	local throttle = if canDrive then d.seat.ThrottleFloat else 0
	local steer = if canDrive then d.seat.SteerFloat else 0

	-- What's under the kart? (nothing, for a moment after a geyser throws it up)
	local ground = if d.pop > 0 then nil else senseGround(d)
	local grounded = ground ~= nil
	if grounded then
		if d.airTime > 0.4 then -- thump when landing a jump
			playSound("Land", hitbox, 1, math.clamp(d.airTime / 1.5, 0.4, 1))
		end
		d.airTime = 0
	else
		d.airTime += dt
	end
	if ground and ground.boost then
		if d.boostTime < 0.2 then
			playSound("Boost", hitbox)
		end
		d.boostTime = math.max(d.boostTime, HANDLING.PAD_BOOST_TIME)
	end
	-- Ease the kart's "up" toward the road's tilt (or back to level in the air)
	local targetUp = if ground then ground.normal else Vector3.yAxis
	d.groundUp = d.groundUp:Lerp(targetUp, 1 - math.exp(-HANDLING.TILT_SPEED * dt)).Unit
	local up = if grounded then d.groundUp else Vector3.yAxis
	local velocity = hitbox.AssemblyLinearVelocity

	-- Hit a wall? If something shoved the kart sideways since last frame, bounce
	-- off a little and turn to slide along the wall instead of grinding into it.
	if grounded and d.wasGrounded and d.lastVelocity and d.wallGrace <= 0 then
		local shove = velocity - d.lastVelocity
		shove -= up * shove:Dot(up) -- ignore up/down bumps
		if shove.Magnitude > WALL_HIT_MIN then
			local away = shove.Unit
			local look = CFrame.Angles(0, d.heading, 0).LookVector
			local into = look:Dot(away)
			if into < -0.05 then
				local along = look - away * into
				if along.Magnitude > 0.05 then
					d.heading += angleDiff(headingOfDirection(along), d.heading) * HANDLING.WALL_SLIDE
				end
			end
			velocity += away * math.min(shove.Magnitude * HANDLING.WALL_BOUNCE, 12)
			d.shake = math.clamp(shove.Magnitude / 40, 0.15, 1)
			if os.clock() - d.lastHitSound > 0.15 then
				d.lastHitSound = os.clock()
				playSound("WallHit", hitbox, 0.9 + math.random() * 0.2, math.clamp(shove.Magnitude / 30, 0.3, 1))
			end
		end
	end

	-- Hazards, wind and other karts
	velocity = touchHazards(d, velocity, dt)
	velocity = bumpKarts(d, velocity)
	if d.pop > 0 and grounded then -- a geyser just threw us: let go of the road
		ground, grounded, up = nil, false, Vector3.yAxis
	end

	-- Forward / right along the road surface
	local flatLook = CFrame.Angles(0, d.heading, 0).LookVector
	local forward = (flatLook - up * flatLook:Dot(up)).Unit
	local right = forward:Cross(up)
	local forwardSpeed = velocity:Dot(forward)
	local sideSpeed = velocity:Dot(right)
	local upSpeed = velocity:Dot(up)

	-- Drifting: hold the drift button while turning at speed.
	-- The longer you hold it, the bigger the boost when you let go.
	if d.drifting then
		if grounded then
			d.driftTime += dt
		end
		if not canDrive or forwardSpeed < HANDLING.DRIFT_MIN_SPEED * 0.6 then
			d.drifting = false -- lost too much speed (e.g. hit a wall): no boost
		elseif not driftHeld then
			if d.driftTime >= HANDLING.MINI_TURBO_2 then
				d.boostTime = math.max(d.boostTime, 1.1)
				playSound("Boost", hitbox, 1.15, 1.2)
			elseif d.driftTime >= HANDLING.MINI_TURBO_1 then
				d.boostTime = math.max(d.boostTime, 0.6)
				playSound("Boost", hitbox, 1.3, 1)
			end
			d.drifting = false
		end
	elseif driftHeld and canDrive and grounded and forwardSpeed > HANDLING.DRIFT_MIN_SPEED and math.abs(steer) > 0.3 then
		d.drifting = true
		d.driftDir = if steer > 0 then 1 else -1
		d.driftTime = 0
	end

	d.boostTime = math.max(0, d.boostTime - dt)
	local boosting = d.boostTime > 0

	-- Speed (only when wheels are on the ground)
	if grounded then
		if throttle > 0 then
			if forwardSpeed < 0 then
				forwardSpeed += HANDLING.BRAKE * dt
			else
				forwardSpeed += HANDLING.ACCELERATION * throttle * dt
			end
		elseif throttle < 0 then
			if forwardSpeed > 0 then
				forwardSpeed += HANDLING.BRAKE * throttle * dt
			else
				forwardSpeed += HANDLING.ACCELERATION * throttle * dt
			end
		else
			local decel = if canDrive then HANDLING.COAST_DECEL else HANDLING.BRAKE * 0.5
			forwardSpeed = moveToward(forwardSpeed, 0, decel * dt)
		end

		local topSpeed = if boosting then HANDLING.BOOST_SPEED else HANDLING.MAX_SPEED
		if boosting then
			forwardSpeed = math.max(forwardSpeed, HANDLING.BOOST_SPEED)
		end
		if forwardSpeed > topSpeed then
			forwardSpeed = math.max(topSpeed, forwardSpeed - 60 * dt) -- ease down after a boost
		end
		forwardSpeed = math.max(forwardSpeed, -HANDLING.REVERSE_SPEED)

		local grip = (if d.drifting then HANDLING.DRIFT_GRIP else HANDLING.GRIP) * (if ground then ground.grip else 1)
		sideSpeed *= math.exp(-grip * dt)
	end

	-- Steering
	local turn
	if d.drifting then
		-- steering into the drift tightens it, steering out widens it
		turn = d.driftDir * (0.7 + 0.45 * steer * d.driftDir) * HANDLING.DRIFT_TURN
	else
		local speedFactor = math.clamp(math.abs(forwardSpeed) / 25, 0, 1)
		turn = steer * speedFactor * (if forwardSpeed < -1 then -1 else 1)
	end
	if not grounded then
		turn *= HANDLING.AIR_STEER
	end
	d.heading -= turn * HANDLING.TURN_RATE * dt

	-- Up/down: on the road, a spring holds the kart at its ride height (so it
	-- follows hills and banks smoothly). In the air, gravity is softened so
	-- jumps feel a bit floaty on purpose.
	if ground then
		upSpeed = math.clamp((d.rideHeight - ground.distance) * HANDLING.HOVER_STIFFNESS, -40, 40)
	else
		upSpeed += workspace.Gravity * (1 - HANDLING.AIR_GRAVITY) * dt
	end
	local newVelocity = forward * forwardSpeed + right * sideSpeed + up * upSpeed
	d.lastVelocity = newVelocity
	d.wasGrounded = grounded
	if grounded then
		-- cancel the gravity physics is about to add; the spring does the holding up
		newVelocity += Vector3.yAxis * (workspace.Gravity * dt)
	end
	hitbox.AssemblyLinearVelocity = newVelocity

	-- Point the kart along the heading, tilted to match the ground
	local tiltUp = d.groundUp
	local look = CFrame.Angles(0, d.heading, 0).LookVector
	local alongGround = look - tiltUp * look:Dot(tiltUp)
	if alongGround.Magnitude > 1e-3 then
		local target = CFrame.lookAt(Vector3.zero, alongGround.Unit, tiltUp)
		if d.drifting then
			target *= CFrame.Angles(0, -d.driftDir * math.rad(HANDLING.DRIFT_BODY_ANGLE), 0)
		end
		if d.spin > 0 then -- one full spin after a hazard hit (the camera doesn't spin with it)
			target *= CFrame.Angles(0, (1 - d.spin / HANDLING.SPIN_TIME) * math.pi * 2, 0)
		end
		d.align.CFrame = target
	end

	-- Fell off the track? Ask to be put back (the server also checks this by itself)
	local killY = if d.track then d.track:GetAttribute("KillY") else nil
	if typeof(killY) == "number" and hitbox.Position.Y < killY and os.clock() - d.lastFallRequest > 1 then
		d.lastFallRequest = os.clock()
		raceEvent:FireServer("Respawn")
	end

	-- Effects
	local tier = 0
	if d.drifting then
		tier = if d.driftTime >= HANDLING.MINI_TURBO_2 then 3 elseif d.driftTime >= HANDLING.MINI_TURBO_1 then 2 else 1
	end
	if tier ~= d.sparkTier then
		d.sparkTier = tier
		for _, emitter in d.sparks do
			emitter.Enabled = tier > 0
			if tier > 0 then
				emitter.Color = ColorSequence.new(SPARK_COLORS[tier])
			end
		end
	end
	if d.flame then
		d.flame.Enabled = boosting
	end
	-- Tyre squeal while drifting, a little higher once a boost is charged
	local squealing = d.drifting and grounded
	if squealing ~= d.driftSound.IsPlaying then
		if squealing then
			d.driftSound:Play()
		else
			d.driftSound:Stop()
		end
	end
	d.driftSound.PlaybackSpeed = 0.9 + tier * 0.08
end

local function cameraStep(dt: number)
	local d = drive
	if not d or not d.hitbox.Parent then
		return
	end
	local camera = workspace.CurrentCamera
	local pos = d.hitbox.Position
	local look = CFrame.Angles(0, d.heading, 0).LookVector
	local desired = pos - look * CAMERA.DISTANCE + Vector3.new(0, CAMERA.HEIGHT, 0)
	local previous = d.camPos
	local camPos: Vector3 = if previous then previous:Lerp(desired, 1 - math.exp(-CAMERA.SMOOTHING * dt)) else desired
	d.camPos = camPos
	local shake = Vector3.zero
	if d.shake > 0 then -- little rattle after bumping a wall
		d.shake = math.max(0, d.shake - dt * 3)
		shake = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * (d.shake * 1.2)
	end
	camera.CFrame = CFrame.lookAt(camPos + shake, pos + look * CAMERA.LOOK_AHEAD + Vector3.new(0, 2, 0))
	local targetFov = if d.boostTime > 0 then CAMERA.BOOST_FOV else CAMERA.FOV
	camera.FieldOfView += (targetFov - camera.FieldOfView) * (1 - math.exp(-6 * dt))
end

local function onDriftInput(_: string, inputState: Enum.UserInputState): Enum.ContextActionResult
	if inputState == Enum.UserInputState.Begin then
		driftHeld = true
	elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
		driftHeld = false
	end
	return Enum.ContextActionResult.Sink -- also stops Space from trying to jump
end

local function onRespawnInput(_: string, inputState: Enum.UserInputState): Enum.ContextActionResult
	if inputState == Enum.UserInputState.Begin then
		raceEvent:FireServer("Respawn")
	end
	return Enum.ContextActionResult.Sink
end

local function stopDriving()
	local d = drive
	if not d then
		return
	end
	drive = nil
	driftHeld = false
	ContextActionService:UnbindAction("KartDrift")
	ContextActionService:UnbindAction("KartRespawn")
	RunService:UnbindFromRenderStep("KartCamera")
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = CAMERA.FOV
	if d.humanoid.Parent then
		d.humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		camera.CameraSubject = d.humanoid
	end
	for _, effect in d.effects do
		effect:Destroy()
	end
end

local function startDriving(seat: VehicleSeat, humanoid: Humanoid)
	if drive and drive.seat == seat then
		return
	end
	stopDriving()

	local kart = seat.Parent
	if not kart or not kart:IsA("Model") then
		return
	end
	local hitbox = (kart.PrimaryPart or kart:WaitForChild("Hitbox", 5)) :: BasePart?
	local align = if hitbox then hitbox:WaitForChild("KartAlign", 5) :: AlignOrientation? else nil
	if not hitbox or not align or humanoid.SeatPart ~= seat then
		return
	end

	local sparks, flame, effects = createEffects(hitbox)
	local driftSound = loopSound("Drift", hitbox, false)
	table.insert(effects, driftSound)
	-- The ground sensor only looks at the current track's road
	local track = workspace:FindFirstChild("RaceTrack")
	local road = if track then track:WaitForChild("Road", 5) else nil
	rayParams.FilterDescendantsInstances = if road then { road } else {}
	local rideHeight = kart:GetAttribute("RideHeight")
	drive = {
		kart = kart,
		track = track,
		hitbox = hitbox,
		seat = seat,
		align = align,
		humanoid = humanoid,
		heading = headingOf(hitbox.CFrame),
		boostTime = 0,
		drifting = false,
		driftDir = 1,
		driftTime = 0,
		sparkTier = 0,
		camPos = nil,
		lastFallRequest = 0,
		sparks = sparks,
		flame = flame,
		effects = effects,
		rideHeight = if typeof(rideHeight) == "number" then rideHeight else 1.1,
		groundUp = hitbox.CFrame.UpVector,
		lastVelocity = nil,
		wasGrounded = false,
		wallGrace = 0.5,
		shake = 0,
		spin = 0,
		pop = 0,
		hazardGrace = 0.5,
		bumped = {},
		driftSound = driftSound,
		airTime = 0,
		lastHitSound = 0,
	}

	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	ContextActionService:BindActionAtPriority("KartDrift", onDriftInput, true, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Space, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonR1)
	ContextActionService:SetTitle("KartDrift", "DRIFT")
	ContextActionService:BindAction("KartRespawn", onRespawnInput, true, Enum.KeyCode.R, Enum.KeyCode.ButtonY)
	ContextActionService:SetTitle("KartRespawn", "RESET")

	workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
	RunService:BindToRenderStep("KartCamera", Enum.RenderPriority.Camera.Value + 1, cameraStep)
end

local function watchCharacter(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	local function update()
		local seat = humanoid.SeatPart
		if seat and seat:IsA("VehicleSeat") and seat:GetAttribute("KartSeat") then
			task.spawn(startDriving, seat, humanoid)
		elseif drive and drive.humanoid == humanoid then
			stopDriving()
		end
	end
	humanoid:GetPropertyChangedSignal("SeatPart"):Connect(update)
	update()
end

player.CharacterAdded:Connect(watchCharacter)
player.CharacterRemoving:Connect(stopDriving)
if player.Character then
	task.spawn(watchCharacter, player.Character)
end

------------------------------------------------------------------------
-- MOVING HAZARDS  (fire bars, snowballs, geysers and wind gusts). Every
-- player's device moves them itself, timed by the server clock, so they're
-- smooth and everyone sees them in the same place at the same moment.
------------------------------------------------------------------------
local hazardTrack: Instance? = nil
local movers: { Instance } = {}
local moverConnection: RBXScriptConnection? = nil

local function addMover(item: Instance)
	if item:GetAttribute("Origin") or item:GetAttribute("From") or item:FindFirstChildOfClass("ParticleEmitter") then
		table.insert(movers, item)
	end
end

local STAND_UP = CFrame.Angles(0, 0, math.rad(90)) -- turns a cylinder upright

local function animateHazards()
	-- The track gets replaced when a new one wins the vote: pick up its hazards
	local track = workspace:FindFirstChild("RaceTrack")
	if track ~= hazardTrack then
		local folder = if track then track:FindFirstChild("Hazards") else nil
		if track and not folder then
			return -- still arriving; try again next frame
		end
		hazardTrack = track
		table.clear(movers)
		if moverConnection then
			moverConnection:Disconnect()
			moverConnection = nil
		end
		if folder then
			for _, item in folder:GetChildren() do
				addMover(item)
			end
			moverConnection = folder.ChildAdded:Connect(addMover)
		end
	end

	local now = workspace:GetServerTimeNow()
	for _, item in movers do
		local origin = item:GetAttribute("Origin")
		local from, to = item:GetAttribute("From"), item:GetAttribute("To")
		if item:IsA("Model") and typeof(origin) == "CFrame" and item:GetAttribute("Speed") then
			-- Fire bar: spin around its post
			item:PivotTo(origin * CFrame.Angles(0, math.rad((numberAttr(item, "Speed") * now) % 360), 0))
		elseif item:IsA("Model") and typeof(origin) == "CFrame" then
			-- Geyser: bubble as a warning, then shoot up a column of lava
			local column = item:FindFirstChild("Column") :: BasePart?
			local vent = item:FindFirstChild("Vent")
			local active, t = hazardCycle(item, now)
			if column then
				column.CanQuery = active
				column.Transparency = if active then 0.1 else 1
				if active then
					local grow = math.clamp(math.min(t / 0.15, (numberAttr(item, "Active") - t) / 0.25), 0.05, 1)
					local height = numberAttr(item, "Height") * grow
					column.Size = Vector3.new(height, column.Size.Y, column.Size.Z)
					column.CFrame = origin * CFrame.new(0, height / 2, 0) * STAND_UP
				end
			end
			local warning = if vent then vent:FindFirstChildOfClass("ParticleEmitter") else nil
			if warning then
				warning.Enabled = active or t > numberAttr(item, "Period") - 1
			end
		elseif item:IsA("BasePart") and typeof(from) == "Vector3" and typeof(to) == "Vector3" then
			-- Snowball: roll smoothly from one side to the other and back
			local period = math.max(numberAttr(item, "Period"), 0.5)
			local phase = ((now + numberAttr(item, "Offset")) % period) / period
			local s = (1 - math.cos(phase * math.pi * 2)) / 2
			local path = to - from
			local axis = if path.Magnitude > 0.1 then Vector3.yAxis:Cross(path.Unit) else Vector3.xAxis
			item.CFrame = CFrame.new(from:Lerp(to, s)) * CFrame.fromAxisAngle(axis, s * path.Magnitude / (item.Size.X / 2))
		elseif item:IsA("BasePart") then
			-- Wind: show the snow streaks while a gust is blowing
			local streaks = item:FindFirstChildOfClass("ParticleEmitter")
			if streaks then
				streaks.Enabled = (hazardCycle(item, now))
			end
		end
	end
end

-- Runs right before each physics step, so the velocity we set is exactly what gets simulated
RunService.PreSimulation:Connect(function(dt)
	animateHazards()
	local d = drive
	if d and not d.hitbox.Parent then
		stopDriving()
	elseif d then
		driveStep(dt)
	end
end)

-- Confetti burst from your kart when you cross the finish line (only you see it)
local function celebrate()
	local d = drive
	local attachment = d and d.hitbox:FindFirstChild("Center")
	if not attachment then
		return
	end
	local confetti = Instance.new("ParticleEmitter")
	confetti.Name = "Confetti"
	confetti.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
		ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 60)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 220, 120)),
		ColorSequenceKeypoint.new(0.75, Color3.fromRGB(70, 160, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 100, 255)),
	})
	confetti.Lifetime = NumberRange.new(1.2, 2)
	confetti.Speed = NumberRange.new(25, 45)
	confetti.SpreadAngle = Vector2.new(50, 50)
	confetti.EmissionDirection = Enum.NormalId.Top
	confetti.Acceleration = Vector3.new(0, -40, 0)
	confetti.Drag = 1.5
	confetti.Size = NumberSequence.new(0.5)
	confetti.Rotation = NumberRange.new(0, 360)
	confetti.RotSpeed = NumberRange.new(-200, 200)
	confetti.LightEmission = 0.3
	confetti.Rate = 0
	confetti.Parent = attachment
	confetti:Emit(80)
	task.delay(3, function()
		confetti:Destroy()
	end)
end

------------------------------------------------------------------------
-- RACE EVENTS
------------------------------------------------------------------------
local myFinishTime: number? = nil

raceState:GetAttributeChangedSignal("Phase"):Connect(function()
	local phase = raceState:GetAttribute("Phase")
	local racing = player:GetAttribute("Racing") == true
	if phase == "Countdown" then
		myFinishTime = nil
		resultsFrame.Visible = false
		if racing then
			showHint()
		end
	elseif phase == "Racing" and racing then
		showBig("GO!", Color3.fromRGB(90, 255, 120), 0.5)
		playSound("CountdownBeep", nil, 1.6, 1.2) -- the high "GO!" beep
	elseif phase == "Reveal" then
		local name = raceState:GetAttribute("TrackName")
		if typeof(name) == "string" then
			showBig(string.upper(name) .. "!", trackColor(trackInfo(raceState:GetAttribute("TrackId"))), 2.2)
		end
	end
end)

raceState:GetAttributeChangedSignal("Countdown"):Connect(function()
	if raceState:GetAttribute("Phase") == "Countdown" and player:GetAttribute("Racing") == true then
		local n = numberAttr(raceState, "Countdown")
		if n > 0 then
			showBig(tostring(n), Color3.fromRGB(255, 230, 80), 0.4)
			playSound("CountdownBeep")
		end
	end
end)

raceEvent.OnClientEvent:Connect(function(action: string, ...)
	if action == "Respawned" then
		local cf, reason = ...
		local d = drive
		if d and typeof(cf) == "CFrame" then
			d.kart:PivotTo(cf)
			d.hitbox.AssemblyLinearVelocity = Vector3.zero
			d.hitbox.AssemblyAngularVelocity = Vector3.zero
			d.heading = headingOf(cf)
			d.boostTime = 0
			d.drifting = false
			d.camPos = nil
			d.groundUp = Vector3.yAxis
			d.lastVelocity = nil
			d.wasGrounded = false
			d.wallGrace = 0.5
			d.spin = 0
			d.pop = 0
			d.hazardGrace = HANDLING.HAZARD_GRACE
		end
		if reason == "Fell" then -- (lava already said "TOO HOT!")
			showBig("WHOOPS!", Color3.fromRGB(255, 170, 60), 0.5)
		end
		playSound("Respawn")
	elseif action == "RacerFinished" then
		local userId, name, place, finishTime = ...
		if userId == player.UserId then
			myFinishTime = finishTime
			showBig("FINISH!  " .. ordinal(place), PLACE_COLORS[place] or WHITE, 1.6)
			celebrate()
			playSound("Victory")
		else
			showFeed(string.format("%s finished %s!", tostring(name), ordinal(place)))
		end
	elseif action == "TimeUp" then
		showBig("TIME'S UP!", Color3.fromRGB(255, 90, 90), 1.2)
		playSound("TimeUp")
	elseif action == "Results" then
		local list = ...
		if typeof(list) == "table" then
			showResults(list)
		end
	end
end)

------------------------------------------------------------------------
-- TRACK VOTE  (cards at the top of the screen while you wait in the lobby)
------------------------------------------------------------------------
local voteFrame = make("Frame", {
	Name = "TrackVote",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 52),
	Size = UDim2.new(0.94, 0, 0.3, 0),
	BackgroundTransparency = 1,
	Visible = false,
}, gui) :: Frame
make("UISizeConstraint", { MaxSize = Vector2.new(720, 170) }, voteFrame)
textLabel({ Name = "Title", Size = UDim2.fromScale(1, 0.2), Text = "VOTE FOR THE NEXT TRACK!", TextColor3 = PLACE_COLORS[1] }, voteFrame)

type VoteCard = { button: TextButton, stroke: UIStroke, name: TextLabel, blurb: TextLabel, votes: TextLabel }
local voteCards: { VoteCard } = {}
for k = 1, 3 do
	local button = make("TextButton", {
		Name = "Option" .. k,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale((k - 0.5) / 3, 0.24),
		Size = UDim2.fromScale(0.315, 0.76),
		BackgroundColor3 = Color3.fromRGB(20, 20, 32),
		BackgroundTransparency = 0.12,
		Text = "",
		Visible = false,
	}, voteFrame) :: TextButton
	make("UICorner", { CornerRadius = UDim.new(0, 12) }, button)
	local stroke = make("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = 2 }, button) :: UIStroke
	local name = textLabel({ Name = "TrackName", Position = UDim2.fromScale(0.06, 0.08), Size = UDim2.fromScale(0.88, 0.3) }, button)
	local blurb = textLabel({
		Name = "Blurb",
		Position = UDim2.fromScale(0.06, 0.4),
		Size = UDim2.fromScale(0.88, 0.32),
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(205, 205, 220),
		TextStrokeTransparency = 1,
	}, button)
	local votes = textLabel({ Name = "Votes", Position = UDim2.fromScale(0.06, 0.76), Size = UDim2.fromScale(0.88, 0.18) }, button)
	button.Activated:Connect(function()
		raceEvent:FireServer("Vote", k)
	end)
	voteCards[k] = { button = button, stroke = stroke, name = name, blurb = blurb, votes = votes }
end

-- Shows the cards during the lobby countdown and keeps the vote counts up to date
local function updateVote(phase: any, racing: boolean)
	local show = phase == "Intermission" and not racing
	voteFrame.Visible = show
	if not show then
		return
	end
	local myVote = player:GetAttribute("Vote")
	for k, card in voteCards do
		local info = trackInfo(raceState:GetAttribute("Option" .. k))
		card.button.Visible = info ~= nil
		if info then
			local color = trackColor(info)
			local count = numberAttr(raceState, "Votes" .. k)
			local mine = myVote == k
			card.name.Text = tostring(info:GetAttribute("DisplayName"))
			card.name.TextColor3 = color
			card.blurb.Text = tostring(info:GetAttribute("Blurb"))
			card.votes.Text = (if mine then "YOUR PICK  •  " else "") .. count .. (if count == 1 then " vote" else " votes")
			card.stroke.Color = color
			card.stroke.Thickness = if mine then 4 else 2
			card.stroke.Transparency = if mine then 0 else 0.55
		end
	end
end

------------------------------------------------------------------------
-- WEATHER  (falling snow or floating embers around you, on tracks that have it)
------------------------------------------------------------------------
local weatherKind: any = nil
local weatherPart: BasePart? = nil

local function updateWeather()
	local track = workspace:FindFirstChild("RaceTrack")
	local kind = if track then track:GetAttribute("Weather") else nil
	if kind ~= weatherKind then
		weatherKind = kind
		if weatherPart then
			weatherPart:Destroy()
			weatherPart = nil
		end
		if kind == "Snow" or kind == "Embers" then
			local snow = kind == "Snow"
			local part = make("Part", {
				Name = "Weather",
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				Transparency = 1,
				Size = Vector3.new(160, 1, 160),
			})
			make("ParticleEmitter", {
				Color = if snow then ColorSequence.new(WHITE) else ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 80, 20)),
				LightEmission = if snow then 0.3 else 1,
				Size = if snow then NumberSequence.new(0.45) else NumberSequence.new(0.4, 0),
				Lifetime = if snow then NumberRange.new(5, 7) else NumberRange.new(3, 5),
				Rate = if snow then 150 else 60,
				Speed = if snow then NumberRange.new(10, 15) else NumberRange.new(4, 10),
				SpreadAngle = Vector2.new(20, 20),
				Acceleration = if snow then Vector3.new(3, 0, 2) else Vector3.new(0, 3, 0),
				EmissionDirection = if snow then Enum.NormalId.Bottom else Enum.NormalId.Top,
				RotSpeed = NumberRange.new(-90, 90),
			}, part)
			part.Parent = workspace.CurrentCamera -- only you see it, and it follows your camera
			weatherPart = part
		end
	end
	if weatherPart then
		local height = if weatherKind == "Snow" then 35 else -25
		weatherPart.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position + Vector3.new(0, height, 0))
	end
end

------------------------------------------------------------------------
-- HUD UPDATE (every frame)
------------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
	local phase = raceState:GetAttribute("Phase")
	local racing = player:GetAttribute("Racing") == true
	local finished = player:GetAttribute("Finished") == true
	local now = workspace:GetServerTimeNow()

	if phase == "Waiting" then
		statusLabel.Text = "Waiting for players..."
	elseif phase == "Intermission" then
		statusLabel.Text = string.format("Next race in %d — vote for a track!", numberAttr(raceState, "Countdown"))
	elseif phase == "Reveal" then
		statusLabel.Text = "Next track: " .. tostring(raceState:GetAttribute("TrackName") or "?")
	elseif phase == "Countdown" then
		statusLabel.Text = if racing then "Get ready!" else "Race starting — you're in the next one!"
	elseif phase == "Racing" then
		local left = formatClock(numberAttr(raceState, "RaceEnd") - now)
		if racing and finished then
			statusLabel.Text = "Finished! Heading back to the lobby..."
		elseif racing then
			statusLabel.Text = "Time left: " .. left
		else
			statusLabel.Text = "Race in progress (" .. left .. " left) — you're in the next one!"
		end
	elseif phase == "Results" then
		statusLabel.Text = "Race over!"
	else
		statusLabel.Text = ""
	end

	local showRaceHud = racing and (phase == "Countdown" or phase == "Racing" or phase == "Results")
	timerLabel.Visible = showRaceHud
	placeLabel.Visible = showRaceHud
	placeSubLabel.Visible = showRaceHud
	if showRaceHud then
		if myFinishTime then
			timerLabel.Text = formatTime(myFinishTime)
		elseif phase == "Racing" then
			timerLabel.Text = formatTime(now - numberAttr(raceState, "RaceStart"))
		elseif phase == "Countdown" then
			timerLabel.Text = formatTime(0)
		end
		local place = numberAttr(player, "Place")
		if place > 0 then
			placeLabel.Text = ordinal(place)
			placeLabel.TextColor3 = PLACE_COLORS[place] or WHITE
		end
		placeSubLabel.Text = "of " .. numberAttr(raceState, "RacerCount")
	end

	updateVote(phase, racing)
	updateWeather()
end)

------------------------------------------------------------------------
-- ENGINE SOUNDS on every kart (yours and everyone else's). The faster a
-- kart goes, the higher its engine sounds.
------------------------------------------------------------------------
local engines: { [Instance]: Sound } = {}

local function addEngine(kart: Instance)
	if not kart:IsA("Model") then
		return
	end
	local hitbox = kart.PrimaryPart or kart:WaitForChild("Hitbox", 5)
	if hitbox and kart.Parent then
		engines[kart] = loopSound("Engine", hitbox, true)
	end
end

task.spawn(function()
	local karts = workspace:WaitForChild("Karts")
	karts.ChildAdded:Connect(addEngine)
	karts.ChildRemoved:Connect(function(kart)
		engines[kart] = nil -- the sound was inside the kart, so it's gone with it
	end)
	for _, kart in karts:GetChildren() do
		task.spawn(addEngine, kart)
	end
end)

RunService.Heartbeat:Connect(function()
	for kart, sound in engines do
		local hitbox = (kart :: Model).PrimaryPart
		if hitbox then
			local speed = hitbox.AssemblyLinearVelocity.Magnitude
			sound.PlaybackSpeed = 0.75 + math.min(speed / HANDLING.MAX_SPEED, 1.4) * 0.55
			local mine = drive ~= nil and drive.kart == kart
			sound.Volume = soundTemplates.Engine.Volume * (if mine then 1 else 0.7)
		end
	end
end)

------------------------------------------------------------------------
-- FOOTSTEPS while walking around the lobby, matching the ground (soft on
-- grass, harder on stone). They replace Roblox's built-in footstep sound.
------------------------------------------------------------------------
local stepTimer = 0

RunService.Heartbeat:Connect(function(dt)
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if not humanoid or not root or humanoid.SeatPart or humanoid.FloorMaterial == Enum.Material.Air or humanoid.MoveDirection.Magnitude < 0.1 then
		stepTimer = 0
		return
	end
	stepTimer -= dt
	if stepTimer <= 0 then
		stepTimer = 5 / math.max(humanoid.WalkSpeed, 1) -- about three steps a second at walking speed
		playSound(if GRASSY[humanoid.FloorMaterial] then "StepGrass" else "StepStone", root, 0.85 + math.random() * 0.3)
	end
end)

-- Turn off Roblox's own footstep sound on your character, so you don't hear both
local function muteDefaultFootsteps(character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local running = if root then root:WaitForChild("Running", 10) else nil
	if running and running:IsA("Sound") then
		running.Volume = 0
	end
end
player.CharacterAdded:Connect(muteDefaultFootsteps)
if player.Character then
	task.spawn(muteDefaultFootsteps, player.Character)
end

------------------------------------------------------------------------
-- LOBBY (bounce pads, spinning display karts)
------------------------------------------------------------------------
local lastBounce = 0
local function hookBouncePad(pad: BasePart)
	pad.Touched:Connect(function(hit)
		local character = player.Character
		if not character or not hit:IsDescendantOf(character) or os.clock() - lastBounce < 0.5 then
			return
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local root = character:FindFirstChild("HumanoidRootPart")
		local power = pad:GetAttribute("BouncePower")
		if not humanoid or humanoid.SeatPart or not root or not root:IsA("BasePart") or typeof(power) ~= "number" then
			return
		end
		lastBounce = os.clock()
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
	end)
end

task.spawn(function()
	local lobby = workspace:WaitForChild("RaceLobby", 30)
	if not lobby then
		return
	end
	local spinners: { Model } = {}
	for _, item in lobby:GetDescendants() do
		if item:IsA("Model") and typeof(item:GetAttribute("Spin")) == "number" then
			table.insert(spinners, item)
		elseif item:IsA("BasePart") and item:GetAttribute("BouncePower") then
			hookBouncePad(item)
		end
	end
	-- Spinning them here (not on the server) keeps the motion perfectly smooth
	RunService.RenderStepped:Connect(function(dt)
		for _, model in spinners do
			local speed = model:GetAttribute("Spin")
			if model.Parent and typeof(speed) == "number" then
				model:PivotTo(model:GetPivot() * CFrame.Angles(0, math.rad(speed) * dt, 0))
			end
		end
	end)
end)
]]></ProtectedString>
