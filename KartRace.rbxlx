make("UICorner", { CornerRadius = UDim.new(0, 14) }, trackMenu)
make("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12), PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }, trackMenu)
textLabel({ Text = "PICK A TRACK", Size = UDim2.new(1, -50, 0, 34), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = PLACE_COLORS[1] }, trackMenu)
