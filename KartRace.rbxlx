				<string name="Name">RaceServer</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">00539dfaaa2021f70ad4d4470000186c</UniqueId>
			</Properties>
			<Item class="ModuleScript" referent="RBXE54C16CC51B44B8DACC47D96790B1BA0">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--[[
	TRACKS  —  every track players can vote for. RaceServer builds them.

	Each one should feel like a level in a video game: a string of named areas,
	each with its own look, hazards and route choices (see "Track design" in
	CLAUDE.md). Rainbow Skyway is the one plain "vanilla" track. A race should
	take about 1.5-2 minutes, which is around 7000-8500 studs of road.
	To check a layout, run this in Studio's command bar (with the game stopped):
		print(require(game.ServerStorage.TrackCheck:Clone())("Magma"))

	POINTS: the main road is a smooth curve through these, in order. X/Z move
	it around the map, Y makes hills. Keep neighbouring points roughly 100-160
	apart. Every track starts at (0, 0, -80) heading the same way, so its
	start line is next to the lobby. Everyone finishes at the end of it.

	BRANCHES: side routes that split off the main road and join it again
	(a risky shortcut, a secret cave...). A branch has its own POINTS, optional
	`width` and its own FEATURES (their `point` numbers count along the branch).
	Its first and last points must sit inside a main-road Room, on flat road at
	the same height, so there's space for the junction. Walls open up by
	themselves where the roads meet.

	Every road has slow OFF-ROAD strips (grass, ash, snow, mud) between the
	road and the walls, except where there are no walls.

	FEATURES are things placed on a road. Single spots use `point` (which POINT),
	`ahead` (studs further along the road from that point; negative = before it)
	and `lane` (sideways from the middle of the road; negative = left):
	  "Boost"     speed pad
	  "Ramp"      jump. Optional `angle` and `length`, plus `gap` = studs of
	              missing road after the lip. Too slow and you fall through!
	  "Banner"    arch over the road with `text` on it (name each area!)
	  "Sign"      signpost with `text`, just outside the wall on `side` ("left"/"right")
	  "Waterfall" a curtain of water right across the road (drive through it)
	  "Rock" / "Crystal" / "Snowman"   solid obstacle to steer around. `size`
	  "LavaPool"  touch it and you're back at your last checkpoint. `radius`
	  "Geyser"    vent (lava, or water in the jungle) that erupts every few
	              seconds and throws karts in the air. `radius`, `height`,
	              `period` (seconds per cycle), `active` (seconds it erupts),
	              `offset` (shifts its timing)
	  "FireBar"   spinning bar of fireballs that knocks karts aside.
	              `length`, `speed` (degrees per second, negative = other way)
	  "Snowball" / "Boulder"   rolls from side to side across the road.
	              `radius`, `period`, `offset`, optional `span` (how far it rolls)
	Sections of road use `from` and `to` points instead:
	  "Room"      the road opens out to `width`: an arena, plaza or cavern
	  "NoWalls"   no barriers (or off-road), so you can drive or get pushed off
	  "Ice"       slippery road. Optional `grip` (default ICE_GRIP)
	  "Rough"     the whole road is slow off-road (a grass or mud cut)
	  "Bridge"    wooden planks instead of road (pair it with NoWalls for a rope bridge)
	  "Tunnel"    a cave over the road
	  "Wind"      gusts that blow karts sideways. `push` (+ = to the right),
	              `period`, `active`, `offset`
	  "Skippable" main road that a drop or jump shortcut lets racers skip, so
	              no checkpoints go there (branches do this by themselves)
]]

return {
	--------------------------------------------------------------------
	-- RAINBOW SKYWAY: the "vanilla" track. Wide, gentle and nearly straight,
	-- with grass verges, boost pads and one grassy shortcut. All about clean
	-- racing lines and drifting, in the prettiest setting.
	--------------------------------------------------------------------
	{
		id = "Skyway",
		name = "Rainbow Skyway",
		blurb = "A wide, speedy race through the clouds. Simple, fast and fun!",
		theme = "Sky",
		color = Color3.fromRGB(80, 190, 255), -- colour of its card in the vote
		ROAD_WIDTH = 54,
		ARCH_SPACING = 170,
		-- a giant rainbow over the road at the top of the first climb (`yaw` turns it to face the road)
		RAINBOW_ARC = { center = Vector3.new(340, -20, 680), radius = 100, yaw = 90 },
		POINTS = {
			Vector3.new(0, 0, -80), --  1 back of the starting grid
			Vector3.new(0, 0, 80), --  2 start straight
			Vector3.new(0, 0, 240), --  3
			Vector3.new(15, 2, 390), --  4 INTO THE CLOUDS: one long sweeping climb
			Vector3.new(80, 6, 520), --  5
			Vector3.new(190, 12, 620), --  6
			Vector3.new(340, 18, 680), --  7 under the giant rainbow
			Vector3.new(500, 18, 680), --  8 a little hop
			Vector3.new(640, 12, 620), --  9 sweeping back down
			Vector3.new(740, 6, 510), -- 10
			Vector3.new(790, 0, 370), -- 11
			Vector3.new(800, 0, 220), -- 12 the long boost straight
			Vector3.new(800, 0, 70), -- 13
			Vector3.new(790, 0, -80), -- 14
			Vector3.new(820, 0, -220), -- 15 gentle S-bend
			Vector3.new(900, 0, -330), -- 16
			Vector3.new(1020, 0, -390), -- 17
			Vector3.new(1160, 0, -410), -- 18
			Vector3.new(1320, 0, -410), -- 19
			Vector3.new(1480, 0, -380), -- 20 SUNRISE CURVE: a huge sweeping left-hander
			Vector3.new(1610, 4, -290), -- 21
			Vector3.new(1690, 10, -160), -- 22
			Vector3.new(1720, 16, -10), -- 23
			Vector3.new(1720, 22, 150), -- 24 CLOUD BRIDGE: climbing straight into the sky
			Vector3.new(1715, 26, 310), -- 25
			Vector3.new(1700, 28, 470), -- 26
			Vector3.new(1650, 28, 610), -- 27 STARLIGHT BEND
			Vector3.new(1550, 26, 720), -- 28
			Vector3.new(1410, 22, 780), -- 29
			Vector3.new(1260, 18, 800), -- 30
			Vector3.new(1110, 14, 840), -- 31 STARLIGHT STRAIGHT: weave between cloud pillars
			Vector3.new(960, 10, 900), -- 32
			Vector3.new(810, 8, 960), -- 33
			Vector3.new(650, 6, 1000), -- 34
			Vector3.new(490, 6, 1020), -- 35
			Vector3.new(330, 8, 1010), -- 36
			Vector3.new(180, 12, 980), -- 37
			Vector3.new(40, 17, 960), -- 38 MEADOW CORNER: the road swings out wide (or cut across the grass!)
			Vector3.new(-100, 17, 980), -- 39
			Vector3.new(-230, 19, 940), -- 40
			Vector3.new(-320, 21, 840), -- 41
			Vector3.new(-350, 21, 700), -- 42
			Vector3.new(-320, 19, 560), -- 43
			Vector3.new(-270, 19, 430), -- 44
			Vector3.new(-260, 16, 290), -- 45
			Vector3.new(-330, 12, 170), -- 46 SUNSET SWEEP
			Vector3.new(-450, 8, 90), -- 47
			Vector3.new(-580, 4, 50), -- 48
			Vector3.new(-700, 0, -30), -- 49
			Vector3.new(-750, 0, -160), -- 50
			Vector3.new(-730, 0, -310), -- 51
			Vector3.new(-640, 0, -430), -- 52
			Vector3.new(-520, 0, -500), -- 53 HOME STRETCH
			Vector3.new(-370, 0, -530), -- 54
			Vector3.new(-220, 0, -545), -- 55
			Vector3.new(-70, 0, -550), -- 56
			Vector3.new(80, 0, -550), -- 57
			Vector3.new(210, 0, -550), -- 58 end of the run-off
		},
		FEATURES = {
			{ kind = "Boost", point = 2, ahead = 70, lane = -14 },
			{ kind = "Boost", point = 2, ahead = 70, lane = 14 },
			{ kind = "Banner", point = 5, text = "INTO THE CLOUDS" },
			{ kind = "Ramp", point = 8, ahead = 30, lane = 0, angle = 10, length = 24 }, -- just a hop: no gap
			{ kind = "Boost", point = 11, ahead = 70, lane = 0 },
			{ kind = "Boost", point = 12, ahead = 70, lane = -14 },
			{ kind = "Boost", point = 12, ahead = 70, lane = 14 },
			{ kind = "Boost", point = 17, ahead = 60, lane = 0 },
			{ kind = "Banner", point = 20, text = "SUNRISE CURVE" },
			{ kind = "Banner", point = 24, text = "CLOUD BRIDGE" },
			{ kind = "Boost", point = 25, lane = -12 },
			{ kind = "Boost", point = 25, lane = 12 },
			{ kind = "Banner", point = 27, ahead = 20, text = "STARLIGHT BEND" },
			{ kind = "Rock", point = 32, lane = -12, size = 9 },
			{ kind = "Rock", point = 32, ahead = 60, lane = 14, size = 9 },
			{ kind = "Rock", point = 33, lane = -6, size = 10 },
			{ kind = "Rock", point = 33, ahead = 70, lane = 16, size = 9 },
			{ kind = "Rock", point = 34, ahead = 20, lane = -14, size = 9 },
			{ kind = "Boost", point = 35, ahead = 40, lane = -12 },
			{ kind = "Boost", point = 35, ahead = 40, lane = 12 },
			{ kind = "Room", from = 38, to = 39, width = 90 },
			{ kind = "Sign", point = 38, ahead = -30, side = "left", text = "< MEADOW CUT\nboost through!" },
			{ kind = "Room", from = 43, to = 44, width = 90 },
			{ kind = "Banner", point = 46, text = "SUNSET SWEEP" },
			{ kind = "Boost", point = 48, lane = 0 },
			{ kind = "Banner", point = 53, text = "HOME STRETCH" },
			{ kind = "Boost", point = 54, ahead = 40, lane = -12 },
			{ kind = "Boost", point = 54, ahead = 40, lane = 12 },
		},
		BRANCHES = {
			{
				name = "Meadow Cut", -- straight across the grass inside Meadow Corner: shorter, but slow unless you're boosting
				width = 34,
				POINTS = {
					Vector3.new(-30, 17, 965), -- 1 leaves Meadow Corner
					Vector3.new(-90, 17, 870), -- 2
					Vector3.new(-150, 18, 760), -- 3
					Vector3.new(-210, 18, 650), -- 4
					Vector3.new(-255, 19, 545), -- 5
					Vector3.new(-285, 19, 490), -- 6 joins again
				},
				FEATURES = {
					{ kind = "Boost", point = 1, ahead = 20, lane = 0 },
					{ kind = "Rough", from = 2, to = 5 },
				},
			},
		},
	},

	--------------------------------------------------------------------
	-- MAGMA MOUNTAIN: a fire temple inside a volcano
	--------------------------------------------------------------------
	{
		id = "Magma",
		name = "Magma Mountain",
		blurb = "Race through a fire temple inside a volcano, and dare to drop through the lava river jump!",
		theme = "Lava",
		color = Color3.fromRGB(255, 120, 40),
		-- The hollow volcano around Crater Hall: `radius` of its rim, `rim` = height
		-- of its top edge, `lake` = height of the lava lake inside it
		CRATER = { center = Vector3.new(230, 0, 1000), radius = 170, rim = 100, lake = 22 },
		POINTS = {
			Vector3.new(0, 0, -80), --  1 back of the starting grid
			Vector3.new(0, 0, 60), --  2 start: the Obsidian Causeway across the lava sea
			Vector3.new(0, 0, 180), --  3 EMBER FIELDS: a wide plateau dotted with lava pools
			Vector3.new(0, 0, 300), --  4
			Vector3.new(0, 0, 420), --  5 the road splits: Cinder Ridge (right) or the Lava Tube (left, a BRANCH)
