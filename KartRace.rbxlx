		<Item class="StarterPlayerScripts" referent="RBXBCD274BB279D4E769D64A9979D416E1C">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">StarterPlayerScripts</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">00539dfaaa2021f70ad4d4470000186e</UniqueId>
			</Properties>
			<Item class="LocalScript" referent="RBX9DE78A3AB98A4D15BA4CD5A865C47DF0">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--[[
	RaceClient  —  a LocalScript that goes in StarterPlayer > StarterPlayerScripts

	Runs on each player's own device:
	  • arcade kart driving (gas, brake, steer, drift + mini-turbo, boost pads, jumps)
	    The kart floats just above the road on raycast "springs" instead of
	    scraping along it, which keeps it smooth over seams, hills and banked turns.
	  • chase camera
	  • race HUD: status bar, countdown, position, timer, results
	  • lobby fun: bounce pads and the spinning display karts
	  • the track vote cards you tap while waiting in the lobby
	  • weather (falling snow / floating embers) on tracks that have it

	The server (RaceServer) owns the rules: who races, checkpoints, finishing, wins.
	This script only drives *your* kart. The server hands your kart's physics to
	your device at GO, which is why steering feels instant instead of laggy.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")

local player = Players.LocalPlayer
local raceState = ReplicatedStorage:WaitForChild("RaceState")
local raceEvent = ReplicatedStorage:WaitForChild("RaceEvent") :: RemoteEvent
-- (The race track itself, workspace.RaceTrack, is replaced whenever a
-- different track wins the vote, so it's looked up fresh when needed.)

------------------------------------------------------------------------
-- HANDLING  (tweak these to change how karts feel)
------------------------------------------------------------------------
local HANDLING = {
	MAX_SPEED = 80, -- studs per second (a walking character is 16)
	ACCELERATION = 40,
	BRAKE = 90,
	REVERSE_SPEED = 25,
	COAST_DECEL = 18, -- slow-down when you let go of the gas
	TURN_RATE = 2.4, -- radians per second at full steer
	GRIP = 10, -- how quickly sideways sliding dies out
	DRIFT_GRIP = 2.5,
	DRIFT_MIN_SPEED = 40,
	DRIFT_TURN = 1.15,
	DRIFT_BODY_ANGLE = 22, -- degrees the kart swings out while drifting (looks only)
	MINI_TURBO_1 = 0.8, -- seconds of drifting for a small boost (blue sparks)
	MINI_TURBO_2 = 1.7, -- seconds of drifting for a big boost (orange sparks)
	BOOST_SPEED = 115,
	OFFROAD_SPEED = 0.55, -- top speed on off-road (grass, ash, snow, mud), as a share of normal. Boosting ignores it!
	PAD_BOOST_TIME = 1.2,
	AIR_GRAVITY = 0.55, -- fraction of normal gravity in the air (floatier jumps)
	AIR_STEER = 0.35,
	-- Suspension: the kart rides on invisible springs just above the road, so
	-- seams, hills and banked corners feel smooth instead of bumpy.
	HOVER_STIFFNESS = 14, -- how firmly the kart holds its ride height
	STICK_DISTANCE = 1.75, -- how far the road can drop away before the kart counts as airborne
	TILT_SPEED = 12, -- how quickly the kart leans to match slopes and banked corners
	WALL_BOUNCE = 0.3, -- how much karts bounce off walls (0 = not at all)
	WALL_SLIDE = 0.6, -- how much a wall hit turns the kart to slide along it (0 = none, 1 = fully)
	-- Hazards on the track (fire bars, snowballs, geysers)
	BONK_SPEED = 45, -- how hard fire bars and snowballs knock you aside
	LAUNCH_SPEED = 55, -- how hard a lava geyser throws you upwards
	SPIN_TIME = 0.7, -- seconds you spin out (and can't drive) after a hit
	HAZARD_GRACE = 1.2, -- seconds after a hit or a respawn before the next hit counts
	-- Bumping into other karts (only on tracks that turn it on, like Frosty Peaks)
	BUMP_RADIUS = 6.5, -- karts closer than this (centre to centre, in studs) bump
	BUMP_SPEED = 16, -- the smallest shove a bump gives
	BUMP_TRANSFER = 0.7, -- how much of the speed someone hits you with turns into your shove
	BUMP_MAX = 60, -- the biggest shove a bump can give
	BUMP_LEAD = 0.1, -- other karts' positions arrive a little late, so look this many seconds ahead
}

-- Points under the kart (x = right, z = back) where it feels for the road,
-- so it tilts to the average of the surface instead of jolting at every seam.
local GROUND_PROBES = {
	Vector3.new(-1.8, 0, -2.4), -- front left
	Vector3.new(1.8, 0, -2.4), -- front right
	Vector3.new(-1.8, 0, 2.4), -- back left
	Vector3.new(1.8, 0, 2.4), -- back right
}
local WALL_HIT_MIN = 6 -- a sideways shove bigger than this (studs/s) in one frame counts as hitting a wall

local CAMERA = {
	DISTANCE = 17,
	HEIGHT = 6.5,
	LOOK_AHEAD = 10,
	SMOOTHING = 9,
	FOV = 70,
	BOOST_FOV = 84,
}

------------------------------------------------------------------------
-- SOUNDS  { id, volume, stretch }. To swap one, find a sound in the Creator
-- Store (Toolbox > Audio) and paste its number after rbxassetid://
-- `stretch` (optional) makes a sound last longer without changing its
-- pitch: 1.5 = half as long again.
------------------------------------------------------------------------
local SOUNDS = {
	Engine = { "rbxassetid://80317022777602", 0.8 }, -- loops on every kart; pitch rises with speed
	Drift = { "rbxassetid://109487442763183", 0.35 }, -- tyre squeal, loops while you drift
	Boost = { "rbxassetid://9126047023", 1.3 }, -- boost pads and mini-turbos
	Land = { "rbxasset://sounds/action_jump_land.mp3", 0.8 }, -- touching down after a jump
	WallHit = { "rbxassetid://7836644875", 0.5 }, -- bumping into walls and obstacles (louder for harder hits)
	KartBump = { "rbxassetid://133564751966469", 0.9 }, -- bumping into another kart (a springy boing)
	Fire = { "rbxassetid://9066038215", 0.6 }, -- lava and fire bars (a sizzle)
	Snowball = { "rbxasset://sounds/splat.wav", 0.9 },
	Geyser = { "rbxasset://sounds/Launching rocket.wav", 0.6 },
	Respawn = { "rbxassetid://130378474223829", 0.6 }, -- a small, happy ding
	CountdownBeep = { "rbxassetid://124455167265111", 0.6, 1.5 }, -- 3, 2, 1 (and higher for GO!)
	Victory = { "rbxassetid://1836473422", 0.6 }, -- you crossed the finish line!
	TimeUp = { "rbxassetid://190705984", 0.6 }, -- the race ended before you finished
	StepGrass = { "rbxassetid://133687456650659", 0.25 }, -- walking on grass, dirt, sand or snow
	StepStone = { "rbxassetid://87061775498714", 1.1 }, -- walking on anything else
}
-- Floors that get the soft grassy footstep
local GRASSY = {
	[Enum.Material.Grass] = true,
	[Enum.Material.LeafyGrass] = true,
	[Enum.Material.Ground] = true,
	[Enum.Material.Mud] = true,
	[Enum.Material.Sand] = true,
	[Enum.Material.Snow] = true,
}

local SPARK_COLORS = {
	Color3.fromRGB(235, 235, 235), -- charging
	Color3.fromRGB(70, 170, 255), -- small boost ready
	Color3.fromRGB(255, 140, 30), -- big boost ready
}

local PLACE_COLORS = {
	Color3.fromRGB(255, 215, 70),
	Color3.fromRGB(210, 215, 225),
	Color3.fromRGB(225, 150, 90),
}
local WHITE = Color3.new(1, 1, 1)
local FONT = Enum.Font.FredokaOne

------------------------------------------------------------------------
-- Helpers
------------------------------------------------------------------------
-- Which way a direction points around the vertical axis (the kart's "heading")
local function headingOfDirection(dir: Vector3): number
	return math.atan2(-dir.X, -dir.Z)
end

local function headingOf(cf: CFrame): number
	return headingOfDirection(cf.LookVector)
end

-- Shortest signed difference between two angles, in radians
local function angleDiff(a: number, b: number): number
	return (a - b + math.pi) % (2 * math.pi) - math.pi
end

local function moveToward(value: number, target: number, step: number): number
	if value < target then
		return math.min(value + step, target)
	end
	return math.max(value - step, target)
end

local function ordinal(n: number): string
	local lastTwo = n % 100
	local last = n % 10
	if lastTwo < 11 or lastTwo > 13 then
		if last == 1 then
			return n .. "st"
		elseif last == 2 then
			return n .. "nd"
		elseif last == 3 then
			return n .. "rd"
		end
	end
	return n .. "th"
end

local function formatTime(seconds: number): string
	seconds = math.max(0, seconds)
	local minutes = math.floor(seconds / 60)
	return string.format("%d:%05.2f", minutes, seconds - minutes * 60)
end

local function formatClock(seconds: number): string
	local whole = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", math.floor(whole / 60), whole % 60)
end

local function numberAttr(instance: Instance, name: string): number
	local value = instance:GetAttribute(name)
	return if typeof(value) == "number" then value else 0
end

-- A track's name, description and colour (the server lists them in RaceState.Tracks)
local function trackInfo(id: any): Instance?
	local folder = raceState:FindFirstChild("Tracks")
	return if folder and typeof(id) == "string" then folder:FindFirstChild(id) else nil
end

local function trackColor(info: Instance?): Color3
	local color = if info then info:GetAttribute("Color") else nil
	return if typeof(color) == "Color3" then color else WHITE
end

------------------------------------------------------------------------
-- AUDIO
------------------------------------------------------------------------
local soundTemplates: { [string]: Sound } = {}
for name, info in SOUNDS do
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = info[1]
	sound.Volume = info[2]
	sound.RollOffMinDistance = 15
	sound.RollOffMaxDistance = 200
	soundTemplates[name] = sound
end
task.spawn(function() -- load them all now, so nothing lags the first time it plays
	local list = {}
	for _, sound in soundTemplates do
		table.insert(list, sound)
	end
	pcall(function()
		ContentProvider:PreloadAsync(list)
	end)
end)

-- Plays a one-off sound. Given a part, it comes from that spot in the world;
-- without one it plays straight in your ears (music, beeps, dings).
local function playSound(name: string, parent: Instance?, pitch: number?, volumeScale: number?)
	local template = soundTemplates[name]
	if not template then
		return
	end
	local sound = template:Clone()
	sound.PlaybackSpeed = pitch or 1
	sound.Volume = template.Volume * (volumeScale or 1)
	local stretch = SOUNDS[name][3]
	if stretch then
		-- Play it slower so it lasts longer, then shift the pitch back up so it
		-- doesn't sound deeper
		sound.PlaybackSpeed /= stretch
		local shift = Instance.new("PitchShiftSoundEffect")
		shift.Octave = math.clamp(stretch, 0.5, 2)
		shift.Parent = sound
	end
	sound.Parent = parent or SoundService
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
end

-- A looping sound on a part (engines, tyre squeal). Starts playing if `play`.
local function loopSound(name: string, parent: Instance, play: boolean): Sound
	local sound = soundTemplates[name]:Clone()
	sound.Looped = true
	sound.Parent = parent
	if play then
		sound:Play()
	end
	return sound
end

------------------------------------------------------------------------
-- HUD
------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "RaceHUD"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local function make(className: string, props: { [string]: any }, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in props do
		(instance :: any)[key] = value
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local function textLabel(props: { [string]: any }, parent: Instance): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextColor3 = WHITE,
		TextScaled = true,
		TextStrokeTransparency = 0.4,
		Text = "",
	}
	for key, value in props do
		defaults[key] = value
	end
	return make("TextLabel", defaults, parent)
end

local statusLabel = textLabel({
	Name = "Status",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 8),
	Size = UDim2.new(0.5, 0, 0, 36),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 0.45,
	TextStrokeTransparency = 1,
}, gui)
