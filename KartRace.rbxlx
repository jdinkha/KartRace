		<Item class="ModuleScript" referent="RBXC8E0CC50D2BB4899B2215DC7736128E8">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--[[
	Garage  —  every kart and wheel set a player can pick (ModuleScript in ReplicatedStorage)

	Karts (the body) and wheels are separate, so any kart works with any wheels.
	They only change the looks: every combo uses the same hitbox and seat, so
	they all drive the same. The server builds racers' karts with Garage.build,
	and the GarageClient menu uses it for its 3D previews.

	The looks are template Models in the Karts and Wheels folders under this module:
	  • Kart templates are centred on the kart's hitbox centre, front = -Z.
	    The road is 1.1 studs below the centre (the kart's RideHeight).
	  • Wheel templates are 2 studs across, centred on the axle, axle along X.
	    Garage.build scales them to each kart's front/rear sizes.
	  • Parts with a "Paint" attribute take the racer's colour.
	To add a kart or wheels: put its template in the folder and add a line below.
]]

export type Kart = { id: string, name: string, front: { x: number, z: number }, rear: { x: number, z: number } }
export type Wheels = { id: string, name: string, front: number, rear: number }

local Garage = {}

-- Where each kart's wheels go: x = how far out from the middle, z = forward (-) / back (+)
Garage.KARTS = {
	{ id = "Classic", name = "Classic", front = { x = 2.35, z = -2.3 }, rear = { x = 2.35, z = 2.3 } },
	{ id = "F1", name = "Formula", front = { x = 2.35, z = -2.6 }, rear = { x = 2.35, z = 2.3 } },
} :: { Kart }

-- How big each wheel set's front and back wheels are (studs across)
Garage.WHEELS = {
	{ id = "Classic", name = "Chunky", front = 1.7, rear = 2 },
	{ id = "Slick", name = "Slicks", front = 1.8, rear = 2.1 },
} :: { Wheels }

Garage.DEFAULT_KART = "Classic"
Garage.DEFAULT_WHEELS = "Classic"

-- The item in `list` with this id, or nil. Safe to call with anything a client sends.
function Garage.find<T>(list: { T }, id: any): T?
	for _, item in list do
		if (item :: any).id == id then
			return item
		end
	end
	return nil
end

-- A looks-only model of a kart with its wheels, centred where the hitbox goes.
-- Unknown ids fall back to the defaults.
function Garage.build(kartId: string?, wheelsId: string?, color: Color3): Model
	local kart = (Garage.find(Garage.KARTS, kartId) or Garage.find(Garage.KARTS, Garage.DEFAULT_KART)) :: Kart
	local wheels = (Garage.find(Garage.WHEELS, wheelsId) or Garage.find(Garage.WHEELS, Garage.DEFAULT_WHEELS)) :: Wheels
	local model = (script.Karts :: Folder)[kart.id]:Clone() :: Model
	model:PivotTo(CFrame.identity)
	for _, axle in { "front", "rear" } do
		local size: number = (wheels :: any)[axle]
		local mount = (kart :: any)[axle]
		for _, side in { 1, -1 } do
			local wheel = (script.Wheels :: Folder)[wheels.id]:Clone() :: Model
			wheel:ScaleTo(size / 2)
			-- bottom of the wheel 1 stud under the centre, just above the road; left wheels turned to face out
			wheel:PivotTo(CFrame.new(side * mount.x, -1 + size / 2, mount.z) * CFrame.Angles(0, if side < 0 then math.pi else 0, 0))
			for _, part in wheel:GetChildren() do
				part.Parent = model
			end
			wheel:Destroy()
		end
	end
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") and part:GetAttribute("Paint") then
			part.Color = color
		end
	end
	return model
end

return Garage
]]></ProtectedString>
