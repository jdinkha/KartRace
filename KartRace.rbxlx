			{ s = "Egg", size = V(0.9, 0.8, 0.5), at = V(0.55, 0.5, -0.6), color = C(240, 150, 60) }, -- ginger patch
			{ s = "Wedge", size = V(0.27, 0.86, 0.76), at = V(0.6, 0.95, 0.01), rot = V(0, -90, 0), color = C(240, 150, 60) }, -- (a ginger ear)
			{ s = "Cylinder", size = V(0.3, 1.9, 1.9), at = V(0, -0.9, 0), rot = V(0, 0, 90), color = C(60, 150, 230) }, -- collar
			{ s = "Ball", size = V(0.4, 0.4, 0.4), at = V(0, -1.1, -0.92), color = C(255, 210, 60) }, -- bell
			{ s = "Egg", size = V(0.35, 0.35, 2), at = V(0, -1.9, 1.3), rot = V(-55, 0, 0), color = "Fur" }, -- tail
		},
	},
	Bear = {
		kart = C(180, 80, 40),
		fur = C(170, 95, 50),
		extras = {
			{ s = "Egg", size = V(0.75, 0.75, 0.4), at = V(0.8, 0.85, 0), color = "Fur", pair = true }, -- round ears
			{ s = "Egg", size = V(0.4, 0.4, 0.42), at = V(0.8, 0.85, -0.03), color = C(230, 180, 140), pair = true },
			{ s = "Egg", size = V(1.05, 0.75, 0.7), at = V(0, -0.42, -0.78), color = C(230, 180, 140) }, -- muzzle
			{ s = "Egg", size = V(0.5, 0.32, 0.3), at = V(0, -0.22, -1.12), color = BLACK }, -- nose
			{ s = "Egg", size = V(0.35, 0.1, 0.1), at = V(0, -0.62, -1.1), color = DARK_MOUTH }, -- mouth
		},
	},
}

type Options = {
	parent: Instance,
	scale: number?, -- 1 = driver size
	suit: Color3?, -- racing suit colour (default: the character's kart colour)
	cheer: boolean?, -- arms up, cheering (the crowd), instead of holding a steering wheel
	weldTo: BasePart?, -- weld everything to this part (a kart). Otherwise every part is anchored where it stands
}

local function newShape(shape: string, size: Vector3, color: Color3, material: Enum.Material?): BasePart
	local part: BasePart
	if shape == "Wedge" then
		part = Instance.new("WedgePart")
	else
		local p = Instance.new("Part")
		if shape == "Ball" then
			p.Shape = Enum.PartType.Ball
		elseif shape == "Cylinder" then
			p.Shape = Enum.PartType.Cylinder
		elseif shape == "Egg" then
			local mesh = Instance.new("SpecialMesh") -- stretches to the part's size: a smooth egg / ellipsoid
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = p
		end
		part = p
	end
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	return part
end

local Mascots = {
	KINDS = KINDS,
	SEAT = CFrame.new(0, 0.75, 0.8), -- where a driver sits, from the middle of a kart's hitbox (the seat's top is 0.75 up, 0.8 back)
}

-- Builds a character sitting (or standing) at `cf`, facing cf's LookVector.
-- Returns its model and its head (for a name tag).
function Mascots.build(kind: string, cf: CFrame, options: Options): (Model, BasePart)
	local spec = KINDS[kind] or KINDS.Bear
	local scale = options.scale or 1
	local suit = options.suit or spec.kart
	local bodyColor = spec.body or suit
	local model = Instance.new("Model")
	model.Name = kind

	local function add(name: string, shape: string, size: Vector3, at: Vector3, color: any, rot: Vector3?, material: Enum.Material?, alpha: number?): BasePart
		local part = newShape(shape, size * scale, if color == "Fur" then spec.fur else color, material)
		part.Name = name
		part.Transparency = alpha or 0
		part.CastShadow = not options.cheer -- (a whole crowd casting shadows is costly)
		local r = rot or Vector3.zero
		part.CFrame = cf * CFrame.new(at * scale) * CFrame.Angles(math.rad(r.X), math.rad(r.Y), math.rad(r.Z))
		local holder = options.weldTo
		if holder then
			part.Anchored = false
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = holder
			weld.Part1 = part
			weld.Parent = part
		else
			part.Anchored = true
		end
		part.Parent = model
		return part
	end
	-- Adds a part and its mirror image on the other side
	local function pair(name: string, shape: string, size: Vector3, at: Vector3, color: any, rot: Vector3?, material: Enum.Material?, alpha: number?)
		local r = rot or Vector3.zero
		add(name, shape, size, at, color, r, material, alpha)
		add(name, shape, size, Vector3.new(-at.X, at.Y, at.Z), color, Vector3.new(r.X, -r.Y, -r.Z), material, alpha)
	end

	-- The body every character shares (from the middle of its seat: the head is 3 studs up)
	local headAt = Vector3.new(0, 3, 0)
	model.PrimaryPart = add("Body", "Egg", Vector3.new(2.1, 2.2, 1.7), Vector3.new(0, 1.2, 0), bodyColor)
	local head = add("Head", spec.headShape or "Egg", spec.head or Vector3.new(2.2, 2, 2), headAt, spec.fur, nil, spec.mat)
	local hands = spec.hands or spec.fur
	if options.cheer then
		pair("Arm", "Egg", Vector3.new(0.5, 1.7, 0.5), Vector3.new(1.2, 2.75, -0.1), bodyColor, Vector3.new(0, 0, -22))
		pair("Hand", "Ball", Vector3.one * 0.55, Vector3.new(1.5, 3.55, -0.2), hands)
	else
		pair("Arm", "Egg", Vector3.new(0.5, 0.5, 2.2), Vector3.new(0.7, 1.12, -0.85), bodyColor, Vector3.new(-52, 17, 0)) -- reaching for the steering wheel
		pair("Hand", "Ball", Vector3.one * 0.55, Vector3.new(0.5, 0.3, -1.5), hands)
	end
	if spec.eyes ~= false then
		local es = spec.eyeScale or 1
		local x, y, z = spec.eyeSpread or 0.42, spec.eyeY or 0.2, spec.eyeZ or -0.88
		pair("Eye", "Egg", Vector3.new(0.55, 0.7, 0.3) * es, headAt + Vector3.new(x, y, z), WHITE)
		pair("Pupil", "Ball", Vector3.one * 0.32 * es, headAt + Vector3.new(x * 0.97, y - 0.03, z - 0.14 * es), BLACK)
		if not options.cheer then -- (too small to see on the crowd)
			pair("Shine", "Ball", Vector3.one * 0.11 * es, headAt + Vector3.new(x * 0.9, y + 0.08 * es, z - 0.27 * es), WHITE)
		end
	end
	for _, e in spec.extras or {} do
		local at = headAt + e.at
		if e.pair then
			pair("Detail", e.s, e.size, at, e.color, e.rot, e.mat, e.alpha)
		else
			add("Detail", e.s, e.size, at, e.color, e.rot, e.mat, e.alpha)
		end
	end
	model.Parent = options.parent
	return model, head
end

return Mascots
]]></ProtectedString>
