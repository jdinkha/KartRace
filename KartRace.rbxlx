local raceState = Instance.new("Folder")
raceState.Name = "RaceState"
raceState:SetAttribute("Phase", "Waiting") -- Waiting / Intermission (track vote) / Reveal / Countdown / Racing / Results
raceState:SetAttribute("Countdown", 0)
raceState:SetAttribute("RaceStart", 0)
raceState:SetAttribute("RaceEnd", 0)
raceState:SetAttribute("RacerCount", 0)
-- Name, description and colour of every track, for the vote cards on players' screens
local trackInfoFolder = Instance.new("Folder")
trackInfoFolder.Name = "Tracks"
for _, def in TRACKS do
	local info = Instance.new("Folder")
	info.Name = def.id
	info:SetAttribute("DisplayName", def.name)
	info:SetAttribute("Blurb", def.blurb)
	info:SetAttribute("Color", def.color)
	info.Parent = trackInfoFolder
end
trackInfoFolder.Parent = raceState
raceState.Parent = ReplicatedStorage

local raceEvent = Instance.new("RemoteEvent")
raceEvent.Name = "RaceEvent"
raceEvent.Parent = ReplicatedStorage

------------------------------------------------------------------------
-- Small helpers
------------------------------------------------------------------------
local function newPart(className: string, props: { [string]: any }, parent: Instance): BasePart
	local part = (Instance.new(className) :: any) :: BasePart
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	if props.Shape then
		(part :: any).Shape = props.Shape -- set first: changing Shape can reset Size
	end
	for key, value in props do
		if key == "Attributes" then -- e.g. Attributes = { Grip = 0.3 }
			for name, attribute in value do
				part:SetAttribute(name, attribute)
			end
		else
			(part :: any)[key] = value
		end
	end
	part.Parent = parent
	return part
end

-- A part you can't bump into, stand on, or hit with raycasts (pure decoration/markers)
local function ghost(props: { [string]: any }): { [string]: any }
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	return props
end

local function newLabel(props: { [string]: any }, parent: Instance): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.TextColor3 = COLORS.White
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextWrapped = true
	for key, value in props do
		(label :: any)[key] = value
	end
	label.Parent = parent
	return label
end

local function newSurfaceGui(part: BasePart, face: Enum.NormalId, name: string?): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name = name or "SurfaceGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = part
	return gui
end

local function newFolder(name: string, parent: Instance): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

-- CFrame at `pos` facing along `dir`, kept level (no tilt)
local function flatCFrame(pos: Vector3, dir: Vector3): CFrame
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.zAxis
	end
	return CFrame.lookAt(pos, pos + flat.Unit)
end

-- Cylinder parts lie on their side; this stands one up (round face on top)
local function upright(cf: CFrame): CFrame
	return cf * CFrame.Angles(0, 0, math.rad(90))
end

-- A flat triangle a-b-c made from two WedgeParts, `thickness` deep below the
-- triangle. Neighbouring triangles share exact edges, so a road built from
-- them has no steps or overlapping lips for karts to catch on.
local function buildTriangle(a: Vector3, b: Vector3, c: Vector3, thickness: number, props: { [string]: any }, parent: Instance)
	-- Rename the corners so b-c is the longest edge (then `a` sits right above it)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		a, c = c, a
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b

	local normal = ac:Cross(ab)
	if normal.Magnitude < 1e-4 then
		return -- squashed flat, nothing to draw
	end
	normal = normal.Unit
	local up = bc:Cross(normal).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	-- shift both wedges down so their top faces sit exactly on the triangle
	local sink = (if normal.Y >= 0 then normal else -normal) * (thickness / 2)

	for _, half in {
		{ center = (a + b) / 2, depth = math.abs(ab:Dot(back)), x = normal, z = back },
		{ center = (a + c) / 2, depth = math.abs(ac:Dot(back)), x = -normal, z = -back },
	} do
		if half.depth < 0.01 or height < 0.01 then
			continue
		end
		local wedge = table.clone(props)
		wedge.Size = Vector3.new(thickness, height, half.depth)
		wedge.CFrame = CFrame.fromMatrix(half.center - sink, half.x, up, half.z)
		newPart("WedgePart", wedge, parent)
	end
end

local function buildTree(base: Vector3, scale: number, leafColor: Color3, parent: Instance, solidTrunk: boolean)
	local trunkHeight = 7 * scale
	local trunk = {
		Name = "TreeTrunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(trunkHeight, 1.6 * scale, 1.6 * scale),
		CFrame = upright(CFrame.new(base + Vector3.new(0, trunkHeight / 2, 0))),
		Color = COLORS.Trunk,
		Material = Enum.Material.Wood,
	}
	newPart("Part", if solidTrunk then trunk else ghost(trunk), parent)
	newPart("Part", ghost({
		Name = "TreeLeaves",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * (8 * scale),
		CFrame = CFrame.new(base + Vector3.new(0, trunkHeight + 1.5 * scale, 0)),
		Color = leafColor,
		Material = Enum.Material.Grass,
	}), parent)
	newPart("Part", ghost({
		Name = "TreeLeaves",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * (5.5 * scale),
		CFrame = CFrame.new(base + Vector3.new(1.6 * scale, trunkHeight + 4.6 * scale, 0.8 * scale)),
		Color = leafColor,
		Material = Enum.Material.Grass,
	}), parent)
end

------------------------------------------------------------------------
-- TRACK BUILDER
------------------------------------------------------------------------
local function catmullRom(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, t: number): Vector3
	local t2 = t * t
	local t3 = t2 * t
	return (
		(p1 * 2)
		+ (p2 - p0) * t
		+ (p0 * 2 - p1 * 5 + p2 * 4 - p3) * t2
		+ (p1 * 3 - p0 - p2 * 3 + p3) * t3
	) * 0.5
end

-- Turns a road's control points into evenly spaced points along a smooth
-- curve. Also returns, for each control point, the index of its sample.
local function sampleCurve(points: { Vector3 }, step: number): ({ Vector3 }, { number })
	local samples: { Vector3 } = {}
	local pointToSample: { number } = {}
	for i = 1, #points - 1 do
		local p1, p2 = points[i], points[i + 1]
		local p0 = points[i - 1] or (p1 * 2 - p2)
		local p3 = points[i + 2] or (p2 * 2 - p1)
		pointToSample[i] = #samples + 1
		local steps = math.max(1, math.ceil((p2 - p1).Magnitude / step))
		for s = 0, steps - 1 do
			table.insert(samples, catmullRom(p0, p1, p2, p3, s / steps))
		end
	end
	table.insert(samples, points[#points])
	pointToSample[#points] = #samples
	return samples, pointToSample
end

-- Two posts and a banner across the road. `cf` = centre of the road, facing along it.
local function buildArch(cfg, cf: CFrame, text: string, parent: Instance, roadWidth: number?)
	local width = roadWidth or cfg.ROAD_WIDTH
	for _, side in { -1, 1 } do
		newPart("Part", {
			Name = "ArchPost",
			Size = Vector3.new(2, 18, 2),
			CFrame = cf * CFrame.new(side * (width / 2 + cfg.WALL_THICKNESS + 1), 9, 0),
			Color = COLORS.White,
		}, parent)
	end
	local banner = newPart("Part", {
		Name = "ArchBanner",
		Size = Vector3.new(width + 7, 4, 1.5),
		CFrame = cf * CFrame.new(0, 17, 0),
		Color = COLORS.Board,
	}, parent)
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = newSurfaceGui(banner, face)
		newLabel({ Size = UDim2.fromScale(1, 1), Text = text, TextColor3 = COLORS.Gold }, gui)
	end
end

-- Countdown lights hanging under the START banner (the race loop switches them on)
local function buildStartLights(cf: CFrame, parent: Instance)
	local folder = newFolder("StartLights", parent)
	local count = SETTINGS.COUNTDOWN_TIME
	newPart("Part", ghost({
		Name = "LightBar",
		Size = Vector3.new(count * 4 + 2, 0.6, 0.6),
		CFrame = cf * CFrame.new(0, 14.7, 0),
		Color = COLORS.Dark,
	}), folder)
	for k = 1, count do
		newPart("Part", ghost({
			Name = tostring(k),
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.6, 2.6, 2.6),
			CFrame = cf * CFrame.new((k - (count + 1) / 2) * 4, 13.1, 0),
			Color = COLORS.LightOff,
		}), folder)
	end
end

-- A glowing arch over the road
local function buildGate(cfg, cf: CFrame, color: Color3, parent: Instance, roadWidth: number?)
	local x = (roadWidth or cfg.ROAD_WIDTH) / 2 + cfg.WALL_THICKNESS + 1.5
	local height = 16
	for _, side in { -1, 1 } do
		newPart("Part", ghost({
			Name = "GatePost",
			Size = Vector3.new(1.6, height, 1.6),
			CFrame = cf * CFrame.new(side * x, height / 2 - 1, 0),
			Color = color,
			Material = Enum.Material.Neon,
		}), parent)
	end
	newPart("Part", ghost({
		Name = "GateBeam",
		Size = Vector3.new(x * 2 + 1.6, 1.6, 1.6),
		CFrame = cf * CFrame.new(0, height - 1.8, 0),
		Color = color,
		Material = Enum.Material.Neon,
	}), parent)
end

local function buildBoostPad(cf: CFrame, road: Instance, decor: Instance)
	local pad = newPart("Part", {
		Name = "BoostPad",
		Size = Vector3.new(10, 0.1, 16),
		CFrame = cf * CFrame.new(0, 0.1, 0),
		Color = COLORS.Boost,
		Material = Enum.Material.Neon,
		CanCollide = false, -- karts drive over it; the client detects it with a raycast
	}, road)
	pad:SetAttribute("BoostPad", true)
	-- three yellow arrows pointing the way to go
	for _, z in { -5.5, -1, 3.5 } do
		for _, side in { -1, 1 } do
			newPart("Part", ghost({
				Name = "BoostArrow",
				Size = Vector3.new(0.9, 0.05, 4.2),
				CFrame = cf * CFrame.new(side * 1.35, 0.175, z + 1.6) * CFrame.Angles(0, math.rad(side * 40), 0),
				Color = COLORS.BoostArrow,
				Material = Enum.Material.Neon,
			}), decor)
		end
	end
end

local RAMP_PIECES = 5

-- How far along the road a ramp reaches (its pieces tilt upwards, so a bit less than its length)
local function rampReach(angleDegrees: number, length: number): number
	local reach = 0
	for k = 1, RAMP_PIECES do
		reach += math.cos(math.rad(angleDegrees) * (k - 0.5) / RAMP_PIECES) * length / RAMP_PIECES
	end
	return reach
end

-- A jump ramp that curves up gradually, so karts glide onto it instead of
-- slamming into a sharp edge. `cf` = where it starts, on the road surface.
local function buildRamp(cfg, cf: CFrame, angleDegrees: number, length: number, road: Instance, walls: Instance, roadWidth: number?)
	local width = (roadWidth or cfg.ROAD_WIDTH) - 2
	local pieceLength = length / RAMP_PIECES
	local point = Vector3.zero -- top surface, in the ramp's own space (forward = -Z)
	for k = 1, RAMP_PIECES do
		local angle = math.rad(angleDegrees) * (k - 0.5) / RAMP_PIECES
		local nextPoint = point + Vector3.new(0, math.sin(angle), -math.cos(angle)) * pieceLength
		local mid = (point + nextPoint) / 2
		newPart("Part", {
			Name = "Ramp",
			Size = Vector3.new(width, 1, pieceLength),
			CFrame = cf * CFrame.new(mid) * CFrame.Angles(angle, 0, 0) * CFrame.new(0, -0.5, 0),
			Color = if k % 2 == 1 then COLORS.Ramp else COLORS.RampStripe,
		}, road)
		-- solid block underneath so the ramp isn't hollow
		local fill = point.Y - 0.9
		if fill > 0.3 then
			newPart("Part", {
				Name = "RampSupport",
				Size = Vector3.new(width, fill, math.abs(nextPoint.Z - point.Z)),
				CFrame = cf * CFrame.new(0, fill / 2, mid.Z),
				Color = COLORS.Dark,
			}, walls)
		end
		point = nextPoint
	end
	-- closes off the front, so a big ramp doesn't look hollow from the side
	local front = point.Y - 1
	if front > 0.5 then
		newPart("Part", {
			Name = "RampFront",
			Size = Vector3.new(width, front, 1),
			CFrame = cf * CFrame.new(0, front / 2, point.Z + 0.5),
			Color = COLORS.Dark,
		}, walls)
	end
end

-- Arrow board on top of the outside wall, warning that a sharp corner is coming
local function buildCornerSign(cfg, frame: CFrame, turnRight: boolean, parent: Instance, halfWidth: number?)
	local side = if turnRight then -1 else 1 -- outside of the corner
	local pos = frame:PointToWorldSpace(Vector3.new(side * ((halfWidth or cfg.ROAD_WIDTH / 2) + cfg.WALL_THICKNESS / 2), cfg.WALL_HEIGHT + 1.8, 0))
	local sign = newPart("Part", ghost({
		Name = "CornerSign",
		Size = Vector3.new(9, 3.6, 0.5),
		CFrame = CFrame.lookAt(pos, pos - frame.LookVector, frame.UpVector), -- faces oncoming karts
		Color = cfg.style.CurbA,
	}), parent)
	local gui = newSurfaceGui(sign, Enum.NormalId.Front)
	newLabel({ Size = UDim2.fromScale(1, 1), Text = if turnRight then ">>>" else "<<<" }, gui)
end

-- Grandstand full of fans on the left side of the start line
local function buildGrandstand(cfg, cf: CFrame, parent: Instance)
	local rng = Random.new(5)
	local length = 70
	local rows = 4
	local depth = 4
	local inner = cfg.ROAD_WIDTH / 2 + cfg.WALL_THICKNESS + 4 -- gap between the wall and the front row
	local outer = inner + rows * depth
	newPart("Part", ghost({
		Name = "StandBase",
		Size = Vector3.new(outer - inner + 4, 2, length + 4),
		CFrame = cf * CFrame.new(-(inner + outer) / 2, -2, 0),
		Color = COLORS.Pillar,
		Material = Enum.Material.Concrete,
	}), parent)
	for r = 0, rows - 1 do
		local x = -(inner + depth * (r + 0.5))
		local h = 1 + r * 1.8
		newPart("Part", ghost({
			Name = "StandRow",
			Size = Vector3.new(depth, h, length),
			CFrame = cf * CFrame.new(x, h / 2 - 1, 0),
			Color = if r % 2 == 0 then cfg.style.Wall else cfg.style.WallStripe,
		}), parent)
		for z = -length / 2 + 1.5, length / 2 - 1.5, 2.6 do
			if rng:NextNumber() < 0.75 then
				local fanHeight = rng:NextNumber(1.8, 2.4)
				newPart("Part", ghost({
					Name = "Fan",
					Size = Vector3.new(1.2, fanHeight, 1.4),
					CFrame = cf * CFrame.new(x + 0.6, h - 1 + fanHeight / 2, z + rng:NextNumber(-0.3, 0.3)),
					Color = KART_COLORS[rng:NextInteger(1, #KART_COLORS)],
				}), parent)
			end
		end
	end
	local roofHeight = 1 + rows * 1.8 + 6
	for _, z in { -length / 2 + 1, length / 2 - 1 } do
		newPart("Part", ghost({
			Name = "StandPost",
			Size = Vector3.new(1, roofHeight, 1),
			CFrame = cf * CFrame.new(-(outer - 0.5), roofHeight / 2 - 1, z),
			Color = COLORS.White,
		}), parent)
	end
	newPart("Part", ghost({
		Name = "StandRoof",
		Size = Vector3.new(outer - inner + 4, 0.8, length + 2),
		CFrame = cf * CFrame.new(-(inner + outer) / 2, roofHeight - 1, 0),
		Color = COLORS.White,
	}), parent)
end

-- Snow theme: a snowman with a carrot nose, a scarf and a top hat
local function buildSnowman(base: Vector3, yaw: number, scale: number, parent: Instance)
	local cf = CFrame.new(base) * CFrame.Angles(0, yaw, 0)
	local function piece(name: string, shape: Enum.PartType, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?)
		newPart("Part", ghost({
			Name = name,
			Shape = shape,
			Size = size * scale,
			CFrame = cf * CFrame.new(offset.Position * scale) * offset.Rotation,
			Color = color,
			Material = material or Enum.Material.SmoothPlastic,
		}), parent)
	end
	local ball, block, cylinder = Enum.PartType.Ball, Enum.PartType.Block, Enum.PartType.Cylinder
	local standUp = CFrame.Angles(0, 0, math.rad(90))
	piece("SnowmanBody", ball, Vector3.one * 5, CFrame.new(0, 2.3, 0), COLORS.White, Enum.Material.Snow)
	piece("SnowmanBody", ball, Vector3.one * 3.8, CFrame.new(0, 5.8, 0), COLORS.White, Enum.Material.Snow)
	piece("SnowmanHead", ball, Vector3.one * 2.8, CFrame.new(0, 8.6, 0), COLORS.White, Enum.Material.Snow)
	piece("SnowmanEye", ball, Vector3.one * 0.45, CFrame.new(-0.5, 9, -1.2), COLORS.Black)
	piece("SnowmanEye", ball, Vector3.one * 0.45, CFrame.new(0.5, 9, -1.2), COLORS.Black)
	piece("SnowmanNose", block, Vector3.new(0.4, 0.4, 1.4), CFrame.new(0, 8.6, -1.6), Color3.fromRGB(255, 140, 30))
	piece("SnowmanScarf", cylinder, Vector3.new(0.7, 3.3, 3.3), CFrame.new(0, 7.3, 0) * standUp, COLORS.CurbA)
	piece("SnowmanHatBrim", cylinder, Vector3.new(0.25, 3, 3), CFrame.new(0, 9.9, 0) * standUp, COLORS.Black)
	piece("SnowmanHat", cylinder, Vector3.new(1.8, 2, 2), CFrame.new(0, 10.9, 0) * standUp, COLORS.Black)
end

-- Signpost beside the road, facing oncoming karts. `cf` = its foot, facing along the road.
local function buildSign(cf: CFrame, text: string, parent: Instance)
	for _, x in { -4, 4 } do
		newPart("Part", ghost({
			Name = "SignPost",
			Size = Vector3.new(0.6, 9, 0.6),
			CFrame = cf * CFrame.new(x, 4.5, 0),
			Color = COLORS.Dark,
		}), parent)
	end
	local board = newPart("Part", ghost({
		Name = "SignBoard",
		Size = Vector3.new(11, 5, 0.5),
		CFrame = cf * CFrame.new(0, 8, 0) * CFrame.Angles(0, math.pi, 0), -- front faces back down the road
		Color = COLORS.Board,
	}), parent)
	local gui = newSurfaceGui(board, Enum.NormalId.Front)
	newLabel({ Size = UDim2.fromScale(1, 1), Text = text, TextColor3 = COLORS.Gold }, gui)
end

-- A glowing pool of lava on the road. Touch it and you're put back at your last checkpoint.
local function buildLavaPool(cf: CFrame, radius: number, hazards: Instance, decor: Instance)
	newPart("Part", ghost({
		Name = "PoolCrust",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, radius * 2 + 4, radius * 2 + 4),
		CFrame = upright(cf * CFrame.new(0, 0.06, 0)),
		Color = Color3.fromRGB(35, 26, 26),
		Material = Enum.Material.Basalt,
	}), decor)
	local lava = newPart("Part", ghost({
		Name = "LavaPool",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, radius * 2, radius * 2),
		CFrame = upright(cf * CFrame.new(0, 0.12, 0)),
		Color = COLORS.Lava,
		Material = Enum.Material.Neon,
	}), decor)
	local embers = Instance.new("ParticleEmitter")
	embers.Name = "Embers"
	embers.Color = ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 70, 20))
	embers.LightEmission = 1
	embers.Size = NumberSequence.new(0.5, 0)
	embers.Lifetime = NumberRange.new(0.8, 1.6)
	embers.Rate = radius
	embers.Speed = NumberRange.new(4, 9)
	embers.SpreadAngle = Vector2.new(25, 25)
	embers.EmissionDirection = Enum.NormalId.Right -- straight up (the cylinder lies on its side)
	embers.Parent = lava
	-- What karts actually feel: a little smaller than the glow, so a near miss doesn't count
	newPart("Part", {
		Name = "LavaHeat",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(4, (radius - 1.5) * 2, (radius - 1.5) * 2),
		CFrame = upright(cf * CFrame.new(0, 1.5, 0)),
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		Attributes = { Hazard = "Burn" },
	}, hazards)
end

-- A lava vent in the road. Near the end of every `period` seconds it bubbles
-- as a warning, then erupts for `active` seconds and throws karts in the air.
-- The client animates it in step with the server clock, so everyone sees the
-- same eruptions at the same time.
local function buildGeyser(cf: CFrame, feature, hazards: Instance, decor: Instance)
	local radius = feature.radius or 6
	local height = feature.height or 24
	newPart("Part", ghost({
		Name = "GeyserRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, radius * 2 + 5, radius * 2 + 5),
		CFrame = upright(cf * CFrame.new(0, 0.1, 0)),
		Color = Color3.fromRGB(45, 34, 32),
		Material = Enum.Material.Basalt,
	}), decor)
	local geyser = Instance.new("Model")
	geyser.Name = "Geyser"
	geyser:SetAttribute("Origin", cf)
	geyser:SetAttribute("Height", height)
	geyser:SetAttribute("Period", feature.period or 3.6)
	geyser:SetAttribute("Active", feature.active or 1.2)
	geyser:SetAttribute("Offset", feature.offset or 0)
	local vent = newPart("Part", ghost({
		Name = "Vent",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, radius * 2, radius * 2),
		CFrame = upright(cf * CFrame.new(0, 0.35, 0)),
		Color = Color3.fromRGB(150, 50, 20),
		Material = Enum.Material.Neon,
	}), geyser)
	local bubbles = Instance.new("ParticleEmitter")
	bubbles.Name = "Warning"
	bubbles.Color = ColorSequence.new(Color3.fromRGB(255, 170, 60), Color3.fromRGB(255, 60, 20))
	bubbles.LightEmission = 1
	bubbles.Size = NumberSequence.new(1.2, 0)
	bubbles.Lifetime = NumberRange.new(0.3, 0.6)
	bubbles.Rate = 40
	bubbles.Speed = NumberRange.new(8, 16)
	bubbles.SpreadAngle = Vector2.new(15, 15)
	bubbles.EmissionDirection = Enum.NormalId.Right -- up
	bubbles.Enabled = false -- the client switches it on just before each eruption
	bubbles.Parent = vent
	newPart("Part", {
		Name = "Column",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, radius * 2 - 1, radius * 2 - 1),
		CFrame = upright(cf * CFrame.new(0, height / 2, 0)),
		Color = COLORS.Lava,
		Material = Enum.Material.Neon,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false, -- the client switches this on while it erupts
		CanTouch = false,
		Attributes = { Hazard = "Launch" },
	}, geyser)
	geyser.Parent = hazards
end

-- A post with two arms of fireballs spinning around it. They knock karts aside.
local function buildFireBar(cf: CFrame, feature, hazards: Instance, walls: Instance)
	local reach = (feature.length or 44) / 2
	newPart("Part", {
		Name = "FireBarPost",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(6, 5, 5),
		CFrame = upright(cf * CFrame.new(0, 2.5, 0)),
		Color = Color3.fromRGB(50, 40, 40),
		Material = Enum.Material.Basalt,
	}, walls)
	local origin = cf * CFrame.new(0, 2.4, 0)
	local bar = Instance.new("Model")
	bar.Name = "FireBar"
	bar:SetAttribute("Origin", origin)
	bar:SetAttribute("Speed", feature.speed or 70) -- the client spins it
	for k = 1, math.max(1, math.floor((reach - 2) / 4)) do
		for _, side in { -1, 1 } do
			newPart("Part", {
				Name = "Fireball",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * 3.8,
				CFrame = origin * CFrame.new(side * (2 + k * 4), 0, 0),
				Color = if k % 2 == 0 then Color3.fromRGB(255, 200, 60) else Color3.fromRGB(255, 110, 30),
				Material = Enum.Material.Neon,
				CanCollide = false,
				CanTouch = false,
				Attributes = { Hazard = "Bonk" },
			}, bar)
		end
	end
	bar.WorldPivot = origin
	bar.Parent = hazards
end

-- A giant snowball rolling from one side of the road to the other and back.
-- `frame` = the middle of the road, facing along it.
local function buildSnowball(frame: CFrame, halfWidth: number, feature, hazards: Instance)
	local radius = feature.radius or 6
	local span = feature.span or math.max(0, halfWidth - radius - 1.5)
	local from = frame:PointToWorldSpace(Vector3.new(-span, radius - 0.4, 0))
	local to = frame:PointToWorldSpace(Vector3.new(span, radius - 0.4, 0))
	newPart("Part", {
		Name = "Snowball",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * radius * 2,
		CFrame = CFrame.new(from),
		Color = COLORS.White,
		Material = Enum.Material.Snow,
		CanCollide = false,
		CanTouch = false,
		-- the client rolls it between From and To, in step with the server clock
		Attributes = { Hazard = "Bonk", From = from, To = to, Period = feature.period or 4, Offset = feature.offset or 0 },
	}, hazards)
end

-- Something solid to steer around. `cf` = its spot on the road, facing along it.
local function buildObstacle(kind: string, cf: CFrame, size: number, style, walls: Instance, decor: Instance)
	if kind == "Snowman" then
		local scale = size / 5 -- a snowman's bottom ball is 5 studs across at scale 1
		newPart("Part", { -- the invisible solid bit karts bump into
			Name = "SnowmanBlock",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(10 * scale, 4.6 * scale, 4.6 * scale),
			CFrame = upright(cf * CFrame.new(0, 5 * scale - 1, 0)),
			Transparency = 1,
		}, walls)
		local look = cf.LookVector
		buildSnowman(cf.Position, math.atan2(look.X, look.Z), scale, decor) -- facing oncoming karts
	elseif kind == "Crystal" then
		newPart("Part", {
			Name = "Crystal",
			Size = Vector3.new(size * 0.7, size * 2.2, size * 0.7),
			CFrame = cf * CFrame.new(0, size * 1.1 - 1, 0) * CFrame.Angles(0, math.rad(30), math.rad(5)),
			Color = Color3.fromRGB(160, 225, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.15,
		}, walls)
		for _, side in { -1, 1 } do
			newPart("Part", ghost({
				Name = "CrystalShard",
				Size = Vector3.new(size * 0.35, size * 1.2, size * 0.35),
				CFrame = cf * CFrame.new(side * size * 0.45, size * 0.5 - 1, side * size * 0.15) * CFrame.Angles(0, 0, math.rad(-side * 28)),
				Color = Color3.fromRGB(120, 210, 255),
				Material = Enum.Material.Neon,
			}), decor)
		end
	else -- Rock
		local height = size * 1.5
		newPart("Part", {
			Name = "Rock",
			Size = Vector3.new(size, height, size),
			CFrame = cf * CFrame.new(0, height / 2 - 1, 0) * CFrame.Angles(0, math.rad(45), 0),
			Color = style.Rock or COLORS.Rock,
			Material = style.RockMaterial or Enum.Material.Slate,
		}, walls)
		newPart("Part", ghost({
			Name = "RockTop",
			Size = Vector3.new(size * 0.6, size * 0.5, size * 0.6),
			CFrame = cf * CFrame.new(size * 0.1, height - 1 + size * 0.15, 0) * CFrame.Angles(math.rad(12), math.rad(20), math.rad(8)),
			Color = style.Rock or COLORS.Rock,
			Material = style.RockMaterial or Enum.Material.Slate,
		}), decor)
		if style.RockGlow then
			newPart("Part", ghost({
				Name = "RockGlow",
				Size = Vector3.new(size + 1.5, 0.3, size + 1.5),
				CFrame = cf * CFrame.new(0, 0.12, 0) * CFrame.Angles(0, math.rad(45), 0),
				Color = COLORS.Lava,
				Material = Enum.Material.Neon,
			}), decor)
		end
	end
end

-- A flame (or a glowing ice lantern) on top of a wall, lighting up rooms and caves
local function buildTorch(pos: Vector3, style, parent: Instance)
	newPart("Part", ghost({
		Name = "TorchPost",
		Size = Vector3.new(1, 2.4, 1),
		CFrame = CFrame.new(pos + Vector3.new(0, 1.2, 0)),
		Color = style.Pillar,
		Material = style.PillarMaterial,
	}), parent)
	local flame = newPart("Part", ghost({
		Name = "TorchFlame",
		Size = Vector3.new(1.3, 1.3, 1.3),
		CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) * CFrame.Angles(0, math.rad(45), 0),
		Color = style.Torch or COLORS.Gold,
		Material = Enum.Material.Neon,
	}), parent)
	if style.TorchFire then
		local fire = Instance.new("ParticleEmitter")
		fire.Name = "Fire"
		fire.Texture = "rbxasset://textures/particles/fire_main.dds"
		fire.Color = ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 70, 20))
		fire.LightEmission = 1
		fire.Size = NumberSequence.new(1.6, 0.3)
		fire.Lifetime = NumberRange.new(0.4, 0.7)
		fire.Rate = 14
		fire.Speed = NumberRange.new(3, 5)
		fire.Parent = flame
	end
end

-- Feature kinds that cover a stretch of road (`from` / `to`), and the ones
-- that respawn points must keep clear of
local SECTION_KINDS = { Room = true, Ice = true, NoWalls = true, Tunnel = true, Wind = true }
local HAZARD_KINDS = { LavaPool = true, Geyser = true, FireBar = true, Snowball = true, Rock = true, Crystal = true, Snowman = true }

-- Works out the shape of one road (the main road, or a branch): evenly spaced
-- samples along it, how wide it is and how it leans at each one, and which
-- stretches are rooms, icy, open, caves, windy or missing (jump gaps).
local function planRoute(cfg, points: { Vector3 }, features: { any }, roadWidth: number)
	local route: any = { features = features, busy = {} }
	local worldPoints = {}
	for i, p in points do
		worldPoints[i] = cfg.ORIGIN + p
	end
	local samples, pointToSample = sampleCurve(worldPoints, cfg.STEP)
	local count = #samples
	local dist = { 0 }
	for i = 2, count do
		dist[i] = dist[i - 1] + (samples[i] - samples[i - 1]).Magnitude
	end
	local total = dist[count]
	route.samples, route.count, route.dist, route.total = samples, count, dist, total

	local function distAtPoint(point: number?): number?
		local index = if point then pointToSample[point] else nil
		return if index then dist[index] else nil
	end
	-- Distance along the road to a feature's spot (its `point`, moved `ahead`)
	function route.spotDist(feature): number?
		local d = distAtPoint(feature.point)
		return if d then math.clamp(d + (feature.ahead or 0), 0, total) else nil
	end

	-- Stretches of road (as distances along it), each remembering its feature
	local sections: { [string]: { any } } = { Room = {}, Ice = {}, NoWalls = {}, Tunnel = {}, Wind = {}, Gap = {} }
	route.sections = sections
	route.jumpZones = {} -- from the run-up of each gap jump to its landing
	route.hazardZones = {} -- around each hazard and obstacle
	for _, feature in features do
		local kind = feature.kind
		if SECTION_KINDS[kind] then
			local from, to = distAtPoint(feature.from), distAtPoint(feature.to)
			if from and to then
				table.insert(sections[kind], { from, to, feature = feature })
			end
		elseif kind == "Ramp" then
			local start = route.spotDist(feature)
			if start and feature.gap then
				local lip = start + rampReach(feature.angle or cfg.RAMP_ANGLE, feature.length or cfg.RAMP_LENGTH)
				table.insert(sections.Gap, { lip, lip + feature.gap })
				table.insert(route.jumpZones, { start - cfg.JUMP_RUNWAY, lip + feature.gap })
			end
		elseif HAZARD_KINDS[kind] then
			-- Respawned karts appear in the middle of the road, so only hazards that
			-- reach the middle matter (snowballs roll right across it)
			local d = route.spotDist(feature)
			local reach = feature.radius or feature.size or (if feature.length then feature.length / 2 else 10)
			if d and (kind == "Snowball" or math.abs(feature.lane or 0) - reach < 8) then
				table.insert(route.hazardZones, { d - reach - cfg.HAZARD_CLEARANCE, d + reach + cfg.HAZARD_CLEARANCE })
			end
		end
	end
	-- The stretch of a kind that covers distance `d` (give or take `margin`), or nil
	function route.section(kind: string, d: number, margin: number?): any
		local extra = margin or 0
		for _, range in sections[kind] do
			if d >= range[1] - extra and d <= range[2] + extra then
				return range
			end
		end
		return nil
	end
	-- How grippy the road is at `d`, or nil if it isn't icy
	function route.gripAt(d: number): number?
		local grip = nil
		for _, range in sections.Ice do
			if d >= range[1] and d <= range[2] then
				grip = math.min(grip or 1, range.feature.grip or cfg.ICE_GRIP)
			end
		end
		return grip
	end

	-- Half the road's width at `d`. It eases out into each Room and back again.
	local baseHalf = roadWidth / 2
	route.baseHalf = baseHalf
	function route.halfWidthAt(d: number): number
		local half = baseHalf
		for _, range in sections.Room do
			local outside = math.max(range[1] - d, d - range[2], 0)
			if outside < cfg.ROOM_EASE then
				local t = 1 - outside / cfg.ROOM_EASE
				half += ((range.feature.width or roadWidth) / 2 - baseHalf) * t * t * (3 - 2 * t)
			end
		end
		return half
	end
	local halfWidth: { number } = {}
	for i = 1, count do
		halfWidth[i] = route.halfWidthAt(dist[i])
	end
	route.halfWidth = halfWidth

	-- How sharply the road turns at each sample (+ = right turn, - = left)
	local bend: { number } = table.create(count, 0) -- radians per stud
	for i = 2, count - 1 do
		local inDir = samples[i] - samples[i - 1]
		local outDir = samples[i + 1] - samples[i]
		local flatIn = Vector3.new(inDir.X, 0, inDir.Z)
		local flatOut = Vector3.new(outDir.X, 0, outDir.Z)
		if flatIn.Magnitude > 1e-3 and flatOut.Magnitude > 1e-3 then
			local angle = math.asin(math.clamp(-flatIn.Unit:Cross(flatOut.Unit).Y, -1, 1))
			bend[i] = angle / ((flatIn.Magnitude + flatOut.Magnitude) / 2)
		end
	end

	-- Average the bend over nearby samples so banking and curbs ease in and out,
	-- then make a "frame" at every sample: its position plus which way is
	-- right / up / forward on the (possibly banked) road. Rooms stay flat, and
	-- so do both ends of the road (that's where branches join the main road).
	local corner: { number } = {}
	local frames: { CFrame } = {}
	for i = 1, count do
		local sum, n = 0, 0
		for j = math.max(1, i - 4), math.min(count, i + 4) do
			sum += bend[j]
			n += 1
		end
		corner[i] = sum / n
		local lean = math.min(1, baseHalf / halfWidth[i]) ^ 2 * math.clamp(math.min(dist[i], total - dist[i]) / 40, 0, 1)
		local bank = math.rad(cfg.MAX_BANK) * math.clamp(corner[i] * cfg.BANK_RADIUS, -1, 1) * lean

		local look = (samples[math.min(i + 1, count)] - samples[math.max(i - 1, 1)]).Unit
		local flatRight = look:Cross(Vector3.yAxis)
		flatRight = if flatRight.Magnitude > 1e-3 then flatRight.Unit else Vector3.xAxis
		local level = flatRight:Cross(look).Unit -- straight up from the road before it leans
		local right = flatRight * math.cos(bank) - level * math.sin(bank)
		local up = level * math.cos(bank) + flatRight * math.sin(bank)
		frames[i] = CFrame.fromMatrix(samples[i], right, up)
	end
	route.corner, route.frames = corner, frames

	-- Road frame at a given distance along the road
	function route.frameAt(d: number): CFrame
		d = math.clamp(d, 0, total)
		for i = 1, count - 1 do
			if dist[i + 1] >= d then
				local segLen = dist[i + 1] - dist[i]
				local alpha = if segLen > 0 then (d - dist[i]) / segLen else 0
				return frames[i]:Lerp(frames[i + 1], alpha)
			end
		end
		return frames[count]
	end
	-- A point on the road at sample i: `x` = sideways from the centre line, `y` = height above the surface
	function route.roadPoint(i: number, x: number, y: number?): Vector3
		return frames[i]:PointToWorldSpace(Vector3.new(x, y or 0, 0))
	end
	-- Distance along the road to the middle of piece i (between samples i and i + 1)
	function route.middle(i: number): number
		return (dist[i] + dist[i + 1]) / 2
	end
	-- The sample nearest to `pos` (height counts extra, so a road passing over or under isn't mixed up)
	function route.nearest(pos: Vector3): number
		local best, bestScore = 1, math.huge
		for i, s in samples do
			local dx, dy, dz = s.X - pos.X, (s.Y - pos.Y) * 3, s.Z - pos.Z
			local score = dx * dx + dy * dy + dz * dz
			if score < bestScore then
				best, bestScore = i, score
			end
		end
		return best
	end
	-- Is `pos` on this road's surface (give or take `margin` studs at its edges)?
	function route.covers(pos: Vector3, margin: number): boolean
		local i = route.nearest(pos)
		local rel = frames[i]:PointToObjectSpace(pos)
		return math.abs(rel.X) <= halfWidth[i] + margin and math.abs(rel.Y) < 3 and math.abs(rel.Z) <= cfg.STEP
	end
	return route
end

-- Builds one road (the main road or a branch) and everything on it. `others`
-- = the roads it joins; walls, curbs and pillars are left out where they'd
-- be in the way of one of those.
local function buildRoute(cfg, route, others: { any }, everyRoute: { any }, folders: { [string]: Folder })
	local style = cfg.style
	local road, walls, decor, hazards = folders.Road, folders.Walls, folders.Decor, folders.Hazards
	local samples, dist, frames, halfWidth = route.samples, route.dist, route.frames, route.halfWidth
	local count = route.count
	local thick = cfg.WALL_THICKNESS
	local function onOtherRoad(pos: Vector3, margin: number): boolean
		for _, other in others do
			if other.covers(pos, margin) then
				return true
			end
		end
		return false
	end
	local function inRoom(i: number): boolean
		return halfWidth[i] > route.baseHalf + 2
	end

	-- Road surface. Every piece is cut to fit exactly against its neighbours
	-- (two triangles on bends, one block on straights), so there are no
	-- overlapping edges or little steps for karts to snag on. Where a branch
	-- runs onto the main road its pieces sit a hair lower, so they don't flicker.
	local roadProps = { Name = "Road", Color = style.Road, Material = style.RoadMaterial }
	for i = 1, count - 1 do
		local m = route.middle(i)
		if route.section("Gap", m) then
			continue -- the hole a jump flies over
		end
		local grip = route.gripAt(m)
		local props = if grip then { Name = "IceRoad", Color = style.Ice, Material = Enum.Material.Ice, Attributes = { Grip = grip } } else roadProps
		local l1, r1 = route.roadPoint(i, -halfWidth[i]), route.roadPoint(i, halfWidth[i])
		local l2, r2 = route.roadPoint(i + 1, -halfWidth[i + 1]), route.roadPoint(i + 1, halfWidth[i + 1])
		if route.isBranch then
			local covered = 0
			for _, spot in { l1, r1, l2, r2 } do
				if onOtherRoad(spot, -0.5) then
					covered += 1
				end
			end
			if covered == 4 then
				continue -- the main road is already here
			elseif covered > 0 then
				local sink = Vector3.new(0, -0.05, 0)
				l1, r1, l2, r2 = l1 + sink, r1 + sink, l2 + sink, r2 + sink
			end
		end
		local across, along = r1 - l1, l2 - l1
		if along.Magnitude < 0.05 then
			continue
		end
		if ((r2 - l2) - across).Magnitude < 0.01 and math.abs(across.Unit:Dot(along.Unit)) < 0.001 then
			local center = (l1 + r1 + l2 + r2) / 4
			local block = table.clone(props)
			block.Size = Vector3.new(across.Magnitude, 1, along.Magnitude)
			block.CFrame = CFrame.lookAt(center, center + along, across:Cross(along)) * CFrame.new(0, -0.5, 0)
			newPart("Part", block, road)
		else
			buildTriangle(l1, r1, r2, 1, props, road)
			buildTriangle(l1, r2, l2, 1, props, road)
		end
	end

	-- Curbs on corners, thin white lines along the straights, and yellow &
	-- black hazard stripes with glowing posts where there are no walls
	for i = 1, count - 1 do
		local m = route.middle(i)
		if route.section("Gap", m) then
			continue
		end
		local open = route.section("NoWalls", m) ~= nil
		local rainbow = style.RainbowCurbs and not open
		local cornering = open or rainbow or math.abs(route.corner[i]) > 1 / 200 or math.abs(route.corner[i + 1]) > 1 / 200
		local stripWidth = if cornering then 2.5 else 0.8
		local inset = if cornering then 1.25 else 1.4
		local lift = 0.08 + (i % 2) * 0.01 -- neighbours sit at slightly different heights so they don't flicker
		local up = (frames[i].UpVector + frames[i + 1].UpVector).Unit
		local stripeA = if open then style.Hazard else style.CurbA
		local stripeB = if open then style.HazardDark else style.CurbB
		for _, side in { -1, 1 } do
			local a = route.roadPoint(i, side * (halfWidth[i] - inset), lift)
			local b = route.roadPoint(i + 1, side * (halfWidth[i + 1] - inset), lift)
			if (b - a).Magnitude < 0.05 or onOtherRoad((a + b) / 2, 1) then
				continue
			end
			newPart("Part", ghost({
				Name = if cornering then "Curb" else "EdgeLine",
				Size = Vector3.new(stripWidth, 0.1, (b - a).Magnitude + 0.4),
				CFrame = CFrame.lookAt((a + b) / 2, b, up),
				Color = if rainbow then RAINBOW[i % #RAINBOW + 1] elseif not cornering then COLORS.White elseif i % 2 == 0 then stripeA else stripeB,
			}), decor)
			if open and i % 3 == 0 then
				newPart("Part", ghost({
					Name = "EdgePost",
					Size = Vector3.new(0.6, 2.4, 0.6),
					CFrame = frames[i] * CFrame.new(side * (halfWidth[i] + 0.4), 1.2, 0),
					Color = style.Hazard,
					Material = Enum.Material.Neon,
				}), decor)
			end
		end
	end

	-- Walls. Pieces meet exactly at the road's edge, so the side karts scrape
	-- along is smooth. On the outside of a bend each piece is stretched a touch
	-- so there's no notch at the back. Open sections, gaps and the spots where
	-- another road joins this one get none.
	local wallTall = cfg.WALL_HEIGHT + 1 -- also reaches 1 stud below the road so nothing slips underneath
	local hasWall: { [number]: { [number]: boolean } } = { [-1] = {}, [1] = {} }
	for _, side in { -1, 1 } do
		local edge: { Vector3 } = {}
		for i = 1, count do
			edge[i] = route.roadPoint(i, side * halfWidth[i])
		end
		-- How much to stretch the piece at sample j, from how sharply the edge
		-- itself turns there (it bends extra where a room flares out)
		local function stretch(j: number): number
			if j <= 1 or j >= count then
				return 0
			end
			local inDir, outDir = edge[j] - edge[j - 1], edge[j + 1] - edge[j]
			local flatIn, flatOut = Vector3.new(inDir.X, 0, inDir.Z), Vector3.new(outDir.X, 0, outDir.Z)
			if flatIn.Magnitude < 1e-3 or flatOut.Magnitude < 1e-3 then
				return 0
			end
			local angle = math.asin(math.clamp(-flatIn.Unit:Cross(flatOut.Unit).Y, -1, 1))
			return if side * angle < 0 then thick * math.tan(math.abs(angle) / 2) + 0.02 else 0
		end
		for i = 1, count - 1 do
			local a, b = edge[i], edge[i + 1]
			local len = (b - a).Magnitude
			local m = route.middle(i)
			if len < 0.05 or route.section("Gap", m) or route.section("NoWalls", m) or onOtherRoad((a + b) / 2, 1) then
				continue
			end
			hasWall[side][i] = true
			local extraBack, extraFront = stretch(i), stretch(i + 1)
			local up = (frames[i].UpVector + frames[i + 1].UpVector).Unit
			newPart("Part", {
				Name = "Wall",
				Size = Vector3.new(thick, wallTall, len + extraBack + extraFront),
				CFrame = CFrame.lookAt((a + b) / 2, b, up) * CFrame.new(side * thick / 2, wallTall / 2 - 1, (extraBack - extraFront) / 2),
				Color = if math.floor(i / 2) % 2 == 0 then style.Wall else style.WallStripe,
				Material = style.WallMaterial,
			}, walls)
		end
	end

	-- Torches along the walls of rooms and caves
	for i = 3, count - 1, 5 do
		if inRoom(i) or route.section("Tunnel", dist[i]) then
			for _, side in { -1, 1 } do
				if hasWall[side][i] then
					buildTorch(route.roadPoint(i, side * (halfWidth[i] + thick / 2), cfg.WALL_HEIGHT), style, decor)
				end
			end
		end
	end

	-- Support pillars down to the ground (skipped where another bit of road is
	-- underneath). Wide rooms get a row of three.
	local function roadUnderneath(pos: Vector3, self: number): boolean
		for _, other in everyRoute do
			for j, below in other.samples do
				if (other ~= route or math.abs(j - self) > 6) and below.Y < pos.Y - 4 and Vector3.new(below.X - pos.X, 0, below.Z - pos.Z).Magnitude < other.halfWidth[j] + 8 then
					return true
				end
			end
		end
		return false
	end
	for i = 10, count, 20 do
		if route.section("Gap", dist[i], 10) or (route.isBranch and onOtherRoad(samples[i], 0)) then
			continue
		end
		local lanes = if halfWidth[i] > 34 then { -(halfWidth[i] - 12), 0, halfWidth[i] - 12 } else { 0 }
		for _, lane in lanes do
			local top = route.roadPoint(i, lane)
			local height = top.Y - 1.5
			if height > 6 and not roadUnderneath(top, i) then
				newPart("Part", ghost({
					Name = "Pillar",
					Size = Vector3.new(6, height, 6),
					CFrame = CFrame.new(top.X, height / 2, top.Z),
					Color = style.Pillar,
					Material = style.PillarMaterial,
				}), decor)
				newPart("Part", ghost({
					Name = "PillarCap",
					Size = Vector3.new(10, 1, 10),
					CFrame = frames[i] * CFrame.new(lane, -1.5, 0),
					Color = style.Pillar,
					Material = style.PillarMaterial,
				}), decor)
			end
		end
	end

	-- Things placed on the road
	for _, feature in route.features do
		local d = route.spotDist(feature)
		if not d then
			continue -- a stretch of road (from/to): built above
		end
		local frame = route.frameAt(d)
		local half = route.halfWidthAt(d)
		local spot = frame * CFrame.new(feature.lane or 0, 0, 0)
		local kind = feature.kind
		if kind == "Boost" then
			buildBoostPad(spot, road, decor)
		elseif kind == "Ramp" then
			buildRamp(cfg, spot, feature.angle or cfg.RAMP_ANGLE, feature.length or cfg.RAMP_LENGTH, road, walls, half * 2)
			table.insert(route.busy, d)
		elseif kind == "Banner" then
			buildArch(cfg, frame, feature.text or "", decor, half * 2)
			table.insert(route.busy, d)
		elseif kind == "Sign" then
			buildSign(flatCFrame(spot.Position, frame.LookVector), feature.text or "", decor)
		elseif kind == "LavaPool" then
			buildLavaPool(spot, feature.radius or 9, hazards, decor)
		elseif kind == "Geyser" then
			buildGeyser(spot, feature, hazards, decor)
		elseif kind == "FireBar" then
			buildFireBar(spot, feature, hazards, walls)
		elseif kind == "Snowball" then
			buildSnowball(frame, half, feature, hazards)
		elseif kind == "Rock" or kind == "Crystal" or kind == "Snowman" then
			buildObstacle(kind, spot, feature.size or 8, style, walls, decor)
		end
	end
	-- Glowing warning posts on both edges of every gap
	for _, gap in route.sections.Gap do
		table.insert(route.busy, (gap[1] + gap[2]) / 2)
		for _, d in { gap[1], gap[2] } do
			for _, side in { -1, 1 } do
				newPart("Part", ghost({
					Name = "GapPost",
					Size = Vector3.new(1.2, 12, 1.2),
					CFrame = route.frameAt(d) * CFrame.new(side * (route.halfWidthAt(d) + 1), 5, 0),
					Color = style.Hazard,
					Material = Enum.Material.Neon,
				}), decor)
			end
		end
	end

	-- Arrow signs before the sharpest corners (they sit on the outside wall, so only where there is one)
	local lastSign = -math.huge
	for i = 3, count do
		local turnRight = route.corner[i] > 0
		local j = i - 2
		local racingPart = route.isBranch or (dist[i] > cfg.PRE_START and dist[i] < route.total - cfg.RUN_OFF)
		if math.abs(route.corner[i]) > 1 / 150 and i - lastSign > 15 and racingPart and hasWall[if turnRight then -1 else 1][j] and not inRoom(j) then
			lastSign = i
			buildCornerSign(cfg, frames[j], turnRight, decor, halfWidth[j])
		end
	end

	-- Caves over "Tunnel" sections: walls and a roof, glowing crystals, and
	-- icicles or rocky stalactites. Wide caverns get higher ceilings.
	local caveRng = Random.new(cfg.SCENERY_SEED)
	local caveMaterial = style.TunnelMaterial or Enum.Material.Rock
	for i = 1, count - 1 do
		if not route.section("Tunnel", route.middle(i)) then
			continue
		end
		local a, b = samples[i], samples[i + 1]
		local cf = CFrame.lookAt((a + b) / 2, b, (frames[i].UpVector + frames[i + 1].UpVector).Unit)
		local len = (b - a).Magnitude + 0.5
		local half = (halfWidth[i] + halfWidth[i + 1]) / 2
		local caveSide = half + thick + 2.5
		local roof = 19 + math.max(0, half - 21) * 0.4
		newPart("Part", ghost({
			Name = "CaveRoof",
			Size = Vector3.new(caveSide * 2 + 4, 3, len),
			CFrame = cf * CFrame.new(0, roof, 0),
			Color = style.Tunnel,
			Material = caveMaterial,
		}), decor)
		for _, side in { -1, 1 } do
			newPart("Part", ghost({
				Name = "CaveWall",
				Size = Vector3.new(4, roof + 3, len),
				CFrame = cf * CFrame.new(side * caveSide, (roof + 3) / 2 - 2, 0),
				Color = style.Tunnel,
				Material = caveMaterial,
			}), decor)
			if i % 3 == 0 then
				newPart("Part", ghost({
					Name = "CaveCrystal",
					Size = Vector3.new(1.2, 4, 1.6),
					CFrame = cf * CFrame.new(side * (caveSide - 2.4), 8, 0) * CFrame.Angles(0, 0, math.rad(side * 20)),
					Color = style.TunnelLight,
					Material = Enum.Material.Neon,
				}), decor)
			end
		end
		if i % 2 == 0 then
			local drip = caveRng:NextNumber(2, 5)
			local thickness = if style.Icicles then 0.9 else 1.8
			newPart("Part", ghost({
				Name = if style.Icicles then "Icicle" else "Stalactite",
				Size = Vector3.new(thickness, drip, thickness),
				CFrame = cf * CFrame.new(caveRng:NextNumber(-half, half), roof - 1.5 - drip / 2, 0),
				Color = if style.Icicles then style.TunnelLight else style.Tunnel,
				Material = if style.Icicles then Enum.Material.Ice else caveMaterial,
				Transparency = if style.Icicles then 0.2 else 0,
			}), decor)
		end
	end

	-- "Wind" sections: invisible boxes the karts feel (the client pushes them
	-- sideways during each gust), with snow streaks that show when it blows
	for i = 1, count - 1 do
		local wind = route.section("Wind", route.middle(i))
		if not wind then
			continue
		end
		local feature = wind.feature
		local a, b = samples[i], samples[i + 1]
		local cf = CFrame.lookAt((a + b) / 2, b, (frames[i].UpVector + frames[i + 1].UpVector).Unit)
		local push = feature.push or 30
		local zone = newPart("Part", {
			Name = "Wind",
			Size = Vector3.new((halfWidth[i] + halfWidth[i + 1]) + 10, 16, (b - a).Magnitude + 0.5),
			CFrame = cf * CFrame.new(0, 7, 0),
			Transparency = 1,
			CanCollide = false,
			CanTouch = false,
			Attributes = {
				Hazard = "Wind",
				Push = cf.RightVector * push,
				Period = feature.period or 4,
				Active = feature.active or 1.5,
				Offset = feature.offset or 0,
			},
		}, hazards)
		if i % 3 == 0 then
			local streaks = Instance.new("ParticleEmitter")
			streaks.Name = "Gust"
			streaks.Color = ColorSequence.new(COLORS.White)
			streaks.LightEmission = 0.3
			streaks.Size = NumberSequence.new(0.35)
			streaks.Transparency = NumberSequence.new(0.2, 1)
			streaks.Lifetime = NumberRange.new(0.4, 0.7)
			streaks.Rate = 35
			streaks.Speed = NumberRange.new(70, 90)
			streaks.Orientation = Enum.ParticleOrientation.VelocityParallel
			streaks.Squash = NumberSequence.new(2.5) -- long thin streaks
			streaks.EmissionDirection = if push >= 0 then Enum.NormalId.Right else Enum.NormalId.Left
			streaks.Enabled = false -- the client switches it on during gusts
			streaks.Parent = zone
		end
	end
end

local function buildTrack(cfg): (Folder, { Vector3 }, { number })
	local style = cfg.style
	local track = Instance.new("Folder")
	track.Name = "RaceTrack"
	track:SetAttribute("TrackId", cfg.id)
	track:SetAttribute("Weather", style.Weather) -- the client adds falling snow / floating embers
	track:SetAttribute("Bumping", cfg.BUMPING) -- above 0, the client makes karts shove each other
	local folders = {
		Road = newFolder("Road", track), -- surfaces karts drive on (the client's ground sensor only looks in here)
		Walls = newFolder("Walls", track), -- barriers and obstacles karts bump into
		Decor = newFolder("Decor", track), -- visuals only
		Hazards = newFolder("Hazards", track), -- lava, fire bars, snowballs, wind... (the client feels for these)
	}
	local decor, walls = folders.Decor, folders.Walls
	local checkpointFolder = newFolder("Checkpoints", track)
	local slotFolder = newFolder("StartSlots", track)

	local main = planRoute(cfg, cfg.POINTS, cfg.FEATURES, cfg.ROAD_WIDTH)
	local branches = {}
	for _, branch in cfg.BRANCHES or {} do
		local route = planRoute(cfg, branch.POINTS, branch.FEATURES or {}, branch.width or cfg.BRANCH_WIDTH)
		route.isBranch = true
		table.insert(branches, route)
	end
	local everyRoute = { main }
	for _, route in branches do
		table.insert(everyRoute, route)
	end
	buildRoute(cfg, main, branches, everyRoute, folders)
	for _, route in branches do
		buildRoute(cfg, route, { main }, everyRoute, folders)
	end

	local width = cfg.ROAD_WIDTH
	local thick = cfg.WALL_THICKNESS
	local count = main.count

	-- Start line, finish line, arches and end walls
	local startDist = cfg.PRE_START
	local finishDist = main.total - cfg.RUN_OFF
	table.insert(main.busy, startDist)
	table.insert(main.busy, finishDist)

	local startFrame = main.frameAt(startDist)
	local startCF = flatCFrame(startFrame.Position, startFrame.LookVector)
	newPart("Part", ghost({
		Name = "StartLine",
		Size = Vector3.new(width, 0.1, 2),
		CFrame = startFrame * CFrame.new(0, 0.1, 0),
		Color = COLORS.White,
	}), track)
	buildArch(cfg, startCF, "START", decor)
	buildStartLights(startCF, track)
	buildGrandstand(cfg, startCF, decor)

	local finishFrame = main.frameAt(finishDist)
	local finishWidth = main.halfWidthAt(finishDist) * 2
	local tiles = 12
	local tileWidth = finishWidth / tiles
	for row = 0, 1 do
		for col = 0, tiles - 1 do
			newPart("Part", ghost({
				Name = "FinishTile",
				Size = Vector3.new(tileWidth, 0.1, 2),
				CFrame = finishFrame * CFrame.new(-finishWidth / 2 + tileWidth * (col + 0.5), 0.1, (row - 0.5) * 2),
				Color = if (row + col) % 2 == 0 then COLORS.Black else COLORS.White,
			}), decor)
		end
	end
	buildArch(cfg, flatCFrame(finishFrame.Position, finishFrame.LookVector), "FINISH", decor, finishWidth)

	local endHeight = cfg.WALL_HEIGHT + 4
	newPart("Part", {
		Name = "EndWall",
		Size = Vector3.new(main.halfWidth[count] * 2 + thick * 2, endHeight, 2),
		CFrame = flatCFrame(main.samples[count], main.frames[count].LookVector) * CFrame.new(0, endHeight / 2 - 1, 1),
		Color = style.Wall,
		Material = style.WallMaterial,
	}, walls)
	newPart("Part", {
		Name = "BackWall",
		Size = Vector3.new(main.halfWidth[1] * 2 + thick * 2, endHeight, 2),
		CFrame = flatCFrame(main.samples[1], main.frames[1].LookVector) * CFrame.new(0, endHeight / 2 - 1, 1),
		Color = style.Wall,
		Material = style.WallMaterial,
	}, walls)

	-- Glowing arches every so often (not in rooms or caves, or where something else stands)
	if cfg.ARCH_SPACING > 0 then
		local colors = style.Gates or RAINBOW
		local gateCount = 0
		local d = startDist + cfg.ARCH_SPACING
		while d < finishDist - 40 do
			local clear = not main.section("Tunnel", d, 30) and main.halfWidthAt(d) <= width / 2 + 1
			for _, spot in main.busy do
				if math.abs(d - spot) < 60 then
					clear = false
					break
				end
			end
			if clear then
				gateCount += 1
				buildGate(cfg, main.frameAt(d), colors[(gateCount - 1) % #colors + 1], decor)
			end
			d += cfg.ARCH_SPACING
		end
	end

	-- Invisible checkpoint "gates". Racers must pass them in order; the last one is the finish.
	local raceLength = finishDist - startDist
	local gates = math.max(1, math.floor(raceLength / cfg.CHECKPOINT_SPACING))
	local gateDists: { number } = {}
	for k = 1, gates do
		table.insert(gateDists, startDist + raceLength * (k / gates))
	end
	-- You respawn at your last checkpoint, so none go where that would be a bad
	-- place to land: the run-up to a gap jump (no room to get back up to speed)
	-- or right by a hazard. None go on main road that a branch skips, either
	-- (racers who took the branch would miss them). One goes just after each
	-- such zone instead, to catch everyone coming out of it.
	local zones: { { number } } = {}
	for _, zone in main.jumpZones do
		table.insert(zones, { zone[1], zone[2] })
	end
	for _, zone in main.hazardZones do
		table.insert(zones, { zone[1], zone[2] })
	end
	for _, route in branches do
		local from = main.dist[main.nearest(route.samples[1])]
		local to = main.dist[main.nearest(route.samples[route.count])]
		table.insert(zones, { math.min(from, to) - 10, math.max(from, to) + 10 })
	end
	table.sort(zones, function(a, b)
		return a[1] < b[1]
	end)
	local merged: { { number } } = {}
	for _, zone in zones do
		local last = merged[#merged]
		if last and zone[1] <= last[2] + 40 then
			last[2] = math.max(last[2], zone[2])
		else
			table.insert(merged, { zone[1], zone[2] })
		end
	end
	local kept: { number } = {}
	local emptied: { [{ number }]: boolean } = {} -- zones that had a gate taken out
	for _, d in gateDists do
		local blocked = nil
		if d < finishDist then
			for _, zone in merged do
				if d > zone[1] and d < zone[2] + 20 then
					blocked = zone
					break
				end
			end
		end
		if blocked then
			emptied[blocked] = true
		else
			table.insert(kept, d)
		end
	end
	for zone in emptied do
		local d = zone[2] + 20
		local tooClose = false
		for _, other in kept do
			tooClose = tooClose or math.abs(other - d) < 30
		end
		if d < finishDist and not tooClose then
			table.insert(kept, d)
		end
	end
	table.sort(kept)
	for k, d in kept do
		local frame = main.frameAt(d)
		newPart("Part", ghost({
			Name = tostring(k),
			Size = Vector3.new(main.halfWidthAt(d) * 2 + 24, 40, 2),
			CFrame = CFrame.lookAt(frame.Position, frame.Position + frame.LookVector),
			Transparency = 1,
		}), checkpointFolder)
	end

	-- Respawn points: where you're put back after falling off or driving into
	-- lava (whichever one you passed last). You don't have to pass them, so
	-- unlike checkpoints they go on every route, branches included, anywhere
	-- that's a safe place to land.
	local respawnFolder = newFolder("RespawnPoints", track)
	for _, route in everyRoute do
		local last = if route.isBranch then route.total else finishDist
		local d = if route.isBranch then cfg.RESPAWN_SPACING / 2 else startDist + cfg.RESPAWN_SPACING
		while d < last do
			local safe = not route.section("Gap", d, 10)
			for _, zone in route.jumpZones do
				safe = safe and not (d > zone[1] and d < zone[2])
			end
			for _, zone in route.hazardZones do
				safe = safe and not (d > zone[1] and d < zone[2])
			end
			local frame = route.frameAt(d)
			if safe and not (route.isBranch and main.covers(frame.Position, 0)) then
				newPart("Part", ghost({
					Name = "RespawnPoint",
					Size = Vector3.new(route.halfWidthAt(d) * 2 + 24, 40, 2),
					CFrame = CFrame.lookAt(frame.Position, frame.Position + frame.LookVector),
					Transparency = 1,
				}), respawnFolder)
			end
			d += cfg.RESPAWN_SPACING
		end
	end

	-- Starting grid: rows of three (four on a wide road) behind the start line
	local columns = if width >= 52 then 4 else 3
	for k = 1, SETTINGS.MAX_RACERS do
		local row = math.floor((k - 1) / columns)
		local col = (k - 1) % columns
		local back = 12 + row * 12 + (if col % 2 == 1 then 5 else 0)
		local frame = main.frameAt(startDist - back)
		local slotCF = flatCFrame(frame.Position, frame.LookVector) * CFrame.new((col - (columns - 1) / 2) * 11, 0, 0)
		newPart("Part", ghost({
			Name = tostring(k),
			Size = Vector3.new(6, 0.1, 8),
			CFrame = slotCF,
			Transparency = 1,
		}), slotFolder)
		newPart("Part", ghost({
			Name = "GridMark",
			Size = Vector3.new(6, 0.1, 0.6),
			CFrame = slotCF * CFrame.new(0, 0.1, -4.5),
			Color = COLORS.White,
		}), decor)
	end

	-- Every road's samples (for the scenery to keep clear of) and how low they go
	local allSamples: { Vector3 } = {}
	local allHalfWidths: { number } = {}
	local minY = math.huge
	for _, route in everyRoute do
		for i, p in route.samples do
			table.insert(allSamples, p)
			table.insert(allHalfWidths, route.halfWidth[i])
			minY = math.min(minY, p.Y)
		end
	end
	track:SetAttribute("KillY", minY - cfg.FALL_DEPTH) -- fall below this = put back at your last checkpoint
	return track, allSamples, allHalfWidths
end

------------------------------------------------------------------------
-- KART BUILDER
------------------------------------------------------------------------
-- How high the kart's centre floats above the road. At 1.1 the wheels just
-- touch it. The client reads this from the kart's "RideHeight" attribute.
local KART_RIDE_HEIGHT = 1.1

local function setupCollisionGroups()
	pcall(function()
		PhysicsService:RegisterCollisionGroup("Karts")
		PhysicsService:RegisterCollisionGroup("Racers")
	end)
	-- Karts and characters pass through each other. Bumping between karts
	-- that are simulated on different players' devices is laggy and glitchy,
	-- and "ghost" karts also stop people from griefing each other.
	PhysicsService:CollisionGroupSetCollidable("Karts", "Karts", false)
	PhysicsService:CollisionGroupSetCollidable("Karts", "Racers", false)
	PhysicsService:CollisionGroupSetCollidable("Racers", "Racers", false)
end

local function buildKart(color: Color3, cframe: CFrame): (Model, BasePart, VehicleSeat)
	local kart = Instance.new("Model")
	kart.Name = "Kart"
	kart.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	kart:SetAttribute("RideHeight", KART_RIDE_HEIGHT)

	-- The invisible box that bumps into walls. It floats a little above the
	-- road (the client holds it up with raycast "springs"), so seams and slopes
	-- never scrape it. Zero friction because the client controls speed directly.
	local hitbox = Instance.new("Part")
	hitbox.Name = "Hitbox"
	hitbox.Size = Vector3.new(5.6, 1.2, 7.2)
	hitbox.Transparency = 1
	hitbox.CFrame = cframe
	hitbox.Anchored = true -- frozen until GO!
	hitbox.CustomPhysicalProperties = PhysicalProperties.new(1, 0, 0, 100, 100)
	hitbox.CollisionGroup = "Karts"
	hitbox.Parent = kart
	kart.PrimaryPart = hitbox

	local function piece(size: Vector3, offset: CFrame, pieceColor: Color3, cylinder: boolean?): BasePart
		local p = Instance.new("Part")
		if cylinder then
			p.Shape = Enum.PartType.Cylinder
		end
		p.Size = size
		p.CFrame = cframe * offset
		p.Color = pieceColor
		p.Material = Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CollisionGroup = "Karts"
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = hitbox
		weld.Part1 = p
		weld.Parent = p
		p.Parent = kart
		return p
	end

	-- Front of the kart is -Z (the way it faces)
	piece(Vector3.new(4.4, 0.9, 6.4), CFrame.new(0, -0.2, 0), color) -- body
	piece(Vector3.new(3.2, 0.7, 1.8), CFrame.new(0, 0.35, -2.1), color) -- hood
	piece(Vector3.new(4.8, 0.6, 0.8), CFrame.new(0, -0.45, -3.4), COLORS.Dark) -- front bumper
	piece(Vector3.new(4.6, 0.25, 1.1), CFrame.new(0, 1.35, 3.1), color) -- spoiler
	piece(Vector3.new(0.3, 1.2, 0.3), CFrame.new(-1.6, 0.75, 3.1), COLORS.Dark)
	piece(Vector3.new(0.3, 1.2, 0.3), CFrame.new(1.6, 0.75, 3.1), COLORS.Dark)
	piece(Vector3.new(0.6, 0.6, 0.6), CFrame.new(0, -0.1, 3.4), COLORS.Dark) -- exhaust
	piece(Vector3.new(0.2, 1.1, 1.1), CFrame.new(0, 0.9, -0.8) * CFrame.Angles(math.rad(35), math.rad(90), 0), COLORS.Dark, true) -- steering wheel
	for _, x in { -2.35, 2.35 } do
		for _, z in { -2.3, 2.3 } do
			piece(Vector3.new(1, 1.8, 1.8), CFrame.new(x, -0.1, z), COLORS.Black, true) -- wheels
		end
	end

	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2, 0.5, 2)
	seat.CFrame = cframe * CFrame.new(0, 0.5, 0.8)
	seat.Color = COLORS.Dark
	seat.TopSurface = Enum.SurfaceType.Smooth
	seat.HeadsUpDisplay = false
	seat.CanCollide = false
	seat.Massless = true
	seat.CollisionGroup = "Karts"
	seat:SetAttribute("KartSeat", true)
	local seatWeld = Instance.new("WeldConstraint")
	seatWeld.Part0 = hitbox
	seatWeld.Part1 = seat
	seatWeld.Parent = seat
	seat.Parent = kart

	-- Keeps the kart upright; the client script points it where it should face.
	local center = Instance.new("Attachment")
	center.Name = "Center"
	center.Parent = hitbox
	local align = Instance.new("AlignOrientation")
	align.Name = "KartAlign"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = center
	align.Responsiveness = 25
	align.MaxTorque = math.huge
	align.CFrame = cframe.Rotation
	align.Parent = hitbox

	-- Attachment points for drift sparks / boost flames (the client adds the effects)
	local effectPoints: { [string]: Vector3 } = {
		RearLeft = Vector3.new(-2.35, -1, 2.6),
		RearRight = Vector3.new(2.35, -1, 2.6),
		Exhaust = Vector3.new(0, -0.1, 3.7),
	}
	for name, offset in effectPoints do
		local att = Instance.new("Attachment")
		att.Name = name
		att.Position = offset
		att.Parent = hitbox
	end

	return kart, hitbox, seat
end

------------------------------------------------------------------------
-- LOBBY BUILDER
------------------------------------------------------------------------
local function buildLobby(): Folder
	local lobby = Instance.new("Folder")
	lobby.Name = "RaceLobby"
	local center = TRACK.ORIGIN + Vector3.new(-110, 0, 0)
	local radius = LOBBY.RADIUS

	local function spot(x: number, y: number, z: number): Vector3
		return center + Vector3.new(x, y, z)
	end
	local function facingCenter(x: number, y: number, z: number): CFrame
		local p = spot(x, y, z)
		return CFrame.lookAt(p, Vector3.new(center.X, p.Y, center.Z))
	end
	-- x/z of a spot on a circle around the middle. 0° = towards the track (east),
	-- 90° = south, 180° = west, 270° = north (where players face when they spawn).
	local function onRing(degrees: number, distance: number): (number, number)
		local a = math.rad(degrees)
		return math.cos(a) * distance, math.sin(a) * distance
	end
	local function disk(name: string, diameter: number, thickness: number, y: number, x: number?, z: number?): { [string]: any }
		return {
			Name = name,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(thickness, diameter, diameter),
			CFrame = upright(CFrame.new(spot(x or 0, y, z or 0))),
		}
	end

	-- The floating island: grassy top, rocky underside
	local floor = disk("Floor", radius * 2, 4, -2)
	floor.Color = COLORS.LobbyFloor
	floor.Material = Enum.Material.Grass
	newPart("Part", floor, lobby)
	local depth = -4
	for k, tier in { { 0.96, 4 }, { 0.78, 7 }, { 0.56, 8 }, { 0.34, 9 }, { 0.14, 9 } } do
		local rock = ghost(disk("IslandRock", radius * 2 * tier[1], tier[2], depth - tier[2] / 2))
		rock.Color = if k == 1 then COLORS.Dirt else COLORS.Rock
		rock.Material = if k == 1 then Enum.Material.Ground else Enum.Material.Slate
		newPart("Part", rock, lobby)
		depth -= tier[2]
	end

	-- Stone plaza with a gold ring around it
	local ring = disk("PlazaRing", 46, 0.3, 0)
	ring.Color = COLORS.Gold
	newPart("Part", ring, lobby)
	local plaza = disk("Plaza", 42, 0.4, 0.05)
	plaza.Color = COLORS.Plaza
	plaza.Material = Enum.Material.Pavement
	newPart("Part", plaza, lobby)

	local spawn = newPart("SpawnLocation", {
		Name = "LobbySpawn",
		Size = Vector3.new(12, 1, 12),
		CFrame = CFrame.new(spot(0, 0.75, 0)),
		Color = COLORS.White,
	}, lobby) :: SpawnLocation
	spawn.Neutral = true
	spawn.Duration = 0 -- no spawn force field

	-- See-through railing around the edge so nobody falls off
	local panels = 28
	for k = 0, panels - 1 do
		local x, z = onRing((k + 0.5) * 360 / panels, radius - 0.6)
		newPart("Part", {
			Name = "Railing",
			Size = Vector3.new(2 * math.pi * radius / panels + 0.2, 5, 0.6),
			CFrame = facingCenter(x, 2.5, z),
			Color = Color3.fromRGB(200, 230, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.6,
		}, lobby)
		local px, pz = onRing(k * 360 / panels, radius - 0.6)
		local post = ghost(disk("RailPost", 0.9, 5.6, 2.8, px, pz))
		post.Color = COLORS.White
		newPart("Part", post, lobby)
	end

	-- Trees and lamp posts
	local rng = Random.new(11)
	for _, angle in { 25, 65, 115, 155, 205, 240, 300, 335 } do
		local x, z = onRing(angle, 46)
		buildTree(spot(x, 0, z), rng:NextNumber(0.9, 1.25), LEAF_COLORS[rng:NextInteger(1, #LEAF_COLORS)], lobby, true)
	end
	for k = 0, 7 do
		local x, z = onRing(22.5 + k * 45, 24)
		local pole = disk("LampPost", 0.6, 9, 4.5, x, z)
		pole.Color = COLORS.Dark
		newPart("Part", pole, lobby)
		newPart("Part", ghost({
			Name = "Lamp",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 1.8,
			CFrame = CFrame.new(spot(x, 9.4, z)),
			Color = Color3.fromRGB(255, 240, 200),
			Material = Enum.Material.Neon,
		}), lobby)
	end

	-- Big status screen (north). The server updates the text as races come and go.
	local screen = newPart("Part", {
		Name = "StatusScreen",
		Size = Vector3.new(32, 12, 1),
		CFrame = facingCenter(0, 15, -49),
		Color = COLORS.Board,
	}, lobby)
	local screenGui = newSurfaceGui(screen, Enum.NormalId.Front, "Screen")
	newLabel({ Name = "Title", Size = UDim2.fromScale(0.94, 0.5), Position = UDim2.fromScale(0.03, 0.1), Text = "WELCOME TO KARTRACE!", TextColor3 = COLORS.Gold }, screenGui)
	newLabel({ Name = "Subtitle", Size = UDim2.fromScale(0.9, 0.24), Position = UDim2.fromScale(0.05, 0.64), Text = "" }, screenGui)
	for _, side in { -1, 1 } do
		newPart("Part", {
			Name = "ScreenLeg",
			Size = Vector3.new(1.5, 9, 1.5),
			CFrame = screen.CFrame * CFrame.new(side * 14, -10.5, 0.5),
			Color = COLORS.Dark,
		}, lobby)
	end
	for _, edge in { { 0, 6.3, 33.2, 0.6 }, { 0, -6.3, 33.2, 0.6 }, { 16.3, 0, 0.6, 12 }, { -16.3, 0, 0.6, 12 } } do
		newPart("Part", ghost({
			Name = "ScreenGlow",
			Size = Vector3.new(edge[3], edge[4], 1.2),
			CFrame = screen.CFrame * CFrame.new(edge[1], edge[2], 0),
			Color = COLORS.Wall,
			Material = Enum.Material.Neon,
		}), lobby)
	end

	-- Kart showroom: display karts slowly turning on pedestals (the client spins them)
	local showroom = newFolder("Showroom", lobby)
	for k, x in { -15, 0, 15 } do
		local color = KART_COLORS[k]
		local pedestal = disk("Pedestal", 10, 1.6, 0.8, x, -28)
		pedestal.Color = COLORS.Dark
		newPart("Part", pedestal, showroom)
		local glow = ghost(disk("PedestalGlow", 10.8, 0.4, 0.2, x, -28))
		glow.Color = color
		glow.Material = Enum.Material.Neon
		newPart("Part", glow, showroom)
		local kart, hitbox, seat = buildKart(color, CFrame.new(spot(x, 1.6 + KART_RIDE_HEIGHT, -28)) * CFrame.Angles(0, math.rad(k * 50), 0))
		seat:Destroy() -- just for looking at
		local align = hitbox:FindFirstChild("KartAlign")
		if align then
			align:Destroy()
		end
		kart.Name = "DisplayKart"
		kart:SetAttribute("Spin", LOBBY.SHOWROOM_SPIN * (if k % 2 == 0 then -1 else 1))
		kart.Parent = showroom
	end

	-- Podium showing the last race's top 3 (south-west)
	local px, pz = onRing(135, 31)
	local podiumCF = facingCenter(px, 0, pz)
	for place, info in { { x = 0, h = 4.5, color = COLORS.Gold }, { x = 6.4, h = 3, color = COLORS.Silver }, { x = -6.4, h = 2, color = COLORS.Bronze } } do
		local block = newPart("Part", {
			Name = "Podium" .. place,
			Size = Vector3.new(6, info.h, 6),
			CFrame = podiumCF * CFrame.new(info.x, info.h / 2, 0),
			Color = info.color,
		}, lobby)
		newLabel({ Size = UDim2.fromScale(1, 1), Text = tostring(place) }, newSurfaceGui(block, Enum.NormalId.Front))
		local nameBoard = newPart("Part", ghost({
			Name = "PodiumName" .. place,
			Size = Vector3.new(7, 1.6, 0.3),
			CFrame = podiumCF * CFrame.new(info.x, info.h + 6.5, 0),
			Color = COLORS.Board,
		}), lobby)
		newLabel({
			Name = "PlayerName",
			Size = UDim2.fromScale(0.94, 0.8),
			Position = UDim2.fromScale(0.03, 0.1),
			Text = "—",
			TextColor3 = info.color,
		}, newSurfaceGui(nameBoard, Enum.NormalId.Front, "NameGui"))
	end
	local header = newPart("Part", ghost({
		Name = "PodiumHeader",
		Size = Vector3.new(11, 2.2, 0.3),
		CFrame = podiumCF * CFrame.new(0, 14, 0),
		Color = COLORS.Board,
	}), lobby)
	newLabel({ Size = UDim2.fromScale(1, 1), Text = "LAST RACE", TextColor3 = COLORS.Gold }, newSurfaceGui(header, Enum.NormalId.Front))

	-- Bounce pads (the client launches you when you step on one)
	for k, angle in { 45, 315 } do
		local x, z = onRing(angle, 30)
		local pad = disk("BouncePad", 7, 0.6, 0.3, x, z)
		pad.Color = if k == 1 then Color3.fromRGB(80, 255, 140) else Color3.fromRGB(255, 90, 200)
		pad.Material = Enum.Material.Neon
		newPart("Part", pad, lobby):SetAttribute("BouncePower", LOBBY.BOUNCE_POWER)
		local padRing = ghost(disk("BouncePadRing", 8.6, 0.4, 0.2, x, z))
		padRing.Color = COLORS.White
		newPart("Part", padRing, lobby)
	end

	-- Global leaderboard board (west)
	local board = newPart("Part", {
		Name = "LeaderboardBoard",
		Size = Vector3.new(28, 18, 1),
		CFrame = facingCenter(-radius + 6, 13, 0),
		Color = COLORS.Board,
	}, lobby)
	for _, side in { -1, 1 } do
		newPart("Part", {
			Name = "BoardLeg",
			Size = Vector3.new(1.2, 4, 1.2),
			CFrame = board.CFrame * CFrame.new(side * 12, -11, 0.4),
			Color = COLORS.Dark,
		}, lobby)
	end
	local gui = newSurfaceGui(board, Enum.NormalId.Front, "Leaderboard")
	newLabel({ Name = "Title", Size = UDim2.fromScale(1, 0.14), Text = "🏆 MOST 1ST PLACES — ALL TIME", TextColor3 = COLORS.Gold }, gui)
	local list = Instance.new("Frame")
	list.Name = "List"
	list.BackgroundTransparency = 1
	list.Position = UDim2.fromScale(0.04, 0.16)
	list.Size = UDim2.fromScale(0.92, 0.76)
	list.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	for rank = 1, SETTINGS.LEADERBOARD_SIZE do
		local row = Instance.new("Frame")
		row.Name = "Row" .. rank
		row.LayoutOrder = rank
		row.Size = UDim2.fromScale(1, 1 / SETTINGS.LEADERBOARD_SIZE)
		row.BackgroundColor3 = COLORS.White
		row.BackgroundTransparency = if rank % 2 == 1 then 0.9 else 1
		row.BorderSizePixel = 0
		row.Parent = list
		newLabel({ Name = "Rank", Size = UDim2.fromScale(0.12, 0.8), Position = UDim2.fromScale(0.01, 0.1), Text = "#" .. rank, TextXAlignment = Enum.TextXAlignment.Left }, row)
		newLabel({ Name = "PlayerName", Size = UDim2.fromScale(0.6, 0.8), Position = UDim2.fromScale(0.14, 0.1), Text = "—", TextXAlignment = Enum.TextXAlignment.Left }, row)
		newLabel({ Name = "Wins", Size = UDim2.fromScale(0.24, 0.8), Position = UDim2.fromScale(0.75, 0.1), Text = "", TextXAlignment = Enum.TextXAlignment.Right }, row)
	end
	newLabel({ Name = "Status", Size = UDim2.fromScale(1, 0.06), Position = UDim2.fromScale(0, 0.93), Text = "Loading...", TextColor3 = Color3.fromRGB(170, 170, 190) }, gui)

	-- How-to-play sign (south)
	local sign = newPart("Part", {
		Name = "HowToPlay",
		Size = Vector3.new(26, 13, 1),
		CFrame = facingCenter(0, 8.5, radius - 7),
		Color = COLORS.Board,
	}, lobby)
	for _, side in { -1, 1 } do
		newPart("Part", {
			Name = "SignLeg",
			Size = Vector3.new(1, 2, 1),
			CFrame = sign.CFrame * CFrame.new(side * 11, -7.5, 0.3),
			Color = COLORS.Dark,
		}, lobby)
	end
	local signGui = newSurfaceGui(sign, Enum.NormalId.Front)
	newLabel({ Size = UDim2.fromScale(1, 0.2), Text = "HOW TO PLAY", TextColor3 = COLORS.Gold }, signGui)
	newLabel({
		Size = UDim2.fromScale(0.9, 0.72),
		Position = UDim2.fromScale(0.05, 0.24),
		Text = "Vote for the next track, then the race starts!\n"
			.. "Orange pads give you a speed boost.\n"
			.. "Hold DRIFT while turning, let go for a mini-turbo.\n"
			.. "Fall off? You respawn at the last checkpoint.\n"
			.. "Waiting? Try the bounce pads!",
	}, signGui)

	lobby.Parent = workspace
	return lobby
end

------------------------------------------------------------------------
-- SCENERY  (sky, ground and decorations around each track — just for looks)
------------------------------------------------------------------------
-- Time of day, haze and clouds to match a track's theme
local function applyLighting(style)
	Lighting.GlobalShadows = true
	Lighting.ClockTime = style.ClockTime or 14.5
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	for key, value in style.Atmosphere or {} do
		(atmosphere :: any)[key] = value
	end
	atmosphere.Parent = Lighting
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
		for key, value in style.Clouds or {} do
			(clouds :: any)[key] = value
		end
		clouds.Parent = terrain
	end
end

-- Finds random open spots for scenery that keep clear of the roads, the lobby
-- and each other. Spots are flat (Y = 0); the caller decides the height.
local function newScatter(samples: { Vector3 }, halfWidths: { number }, rng: Random)
	local road: { Vector3 } = {}
	local roomExtra: { number } = {} -- how much wider than a normal road it is there (rooms)
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for i, p in samples do
		road[i] = Vector3.new(p.X, 0, p.Z)
		roomExtra[i] = math.max(0, halfWidths[i] - TRACK.ROAD_WIDTH / 2)
		minX, maxX = math.min(minX, p.X), math.max(maxX, p.X)
		minZ, maxZ = math.min(minZ, p.Z), math.max(maxZ, p.Z)
	end
	local lobbyCenter = TRACK.ORIGIN + Vector3.new(-110, 0, 0)
	local placed: { { pos: Vector3, radius: number } } = {
		{ pos = Vector3.new(lobbyCenter.X, 0, lobbyCenter.Z), radius = LOBBY.RADIUS + 30 },
	}
	local scatter = {}
	-- Keep an area free (e.g. where a landmark stands)
	function scatter.reserve(pos: Vector3, radius: number)
		table.insert(placed, { pos = Vector3.new(pos.X, 0, pos.Z), radius = radius })
	end
	-- A random spot at least `roadGap` studs from the road's edge and up to
	-- `spread` studs outside the track's area, or nil if nothing fits
	function scatter.find(radius: number, roadGap: number, spread: number): Vector3?
		for _ = 1, 40 do
			local spot = Vector3.new(rng:NextNumber(minX - spread, maxX + spread), 0, rng:NextNumber(minZ - spread, maxZ + spread))
			local clear = true
			for i, p in road do
				if (p - spot).Magnitude < radius + roadGap + roomExtra[i] then
					clear = false
					break
				end
			end
			for _, other in placed do
				if not clear then
					break
				end
				if (other.pos - spot).Magnitude < radius + other.radius + 15 then
					clear = false
				end
			end
			if clear then
				table.insert(placed, { pos = spot, radius = radius })
				return spot
			end
		end
		return nil
	end
	return scatter
end

-- A huge flat sea of lava / field of snow under the whole track and the lobby.
-- It's not solid: fall in and you're put back on the track.
local function buildGround(samples: { Vector3 }, y: number, style, parent: Instance)
	local lobby = TRACK.ORIGIN + Vector3.new(-110, 0, 0)
	local minX, maxX, minZ, maxZ = lobby.X, lobby.X, lobby.Z, lobby.Z
	for _, p in samples do
		minX, maxX = math.min(minX, p.X), math.max(maxX, p.X)
		minZ, maxZ = math.min(minZ, p.Z), math.max(maxZ, p.Z)
	end
	newPart("Part", ghost({
		Name = "Ground",
		Size = Vector3.new(math.min(maxX - minX + 800, 2048), 4, math.min(maxZ - minZ + 800, 2048)),
		CFrame = CFrame.new((minX + maxX) / 2, y - 2, (minZ + maxZ) / 2),
		Color = style.Ground,
		Material = style.GroundMaterial,
	}), parent)
end

-- Sky theme: a floating grassy island with a few trees
local function buildIsland(top: Vector3, radius: number, rng: Random, parent: Instance)
	newPart("Part", ghost({
		Name = "IslandGrass",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3, radius * 2, radius * 2),
		CFrame = upright(CFrame.new(top - Vector3.new(0, 1.5, 0))),
		Color = COLORS.LobbyFloor,
		Material = Enum.Material.Grass,
	}), parent)
	local depth = 3
	for k, tier in { 0.92, 0.7, 0.45, 0.2 } do
		local thickness = radius * (if k == 1 then 0.15 else 0.3)
		newPart("Part", ghost({
			Name = "IslandRock",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(thickness, radius * 2 * tier, radius * 2 * tier),
			CFrame = upright(CFrame.new(top - Vector3.new(0, depth + thickness / 2, 0))),
			Color = if k == 1 then COLORS.Dirt else COLORS.Rock,
			Material = if k == 1 then Enum.Material.Ground else Enum.Material.Slate,
		}), parent)
		depth += thickness
	end
	for _ = 1, rng:NextInteger(1, 3) do
		local angle = rng:NextNumber(0, math.pi * 2)
		local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * rng:NextNumber(0, radius * 0.55)
		buildTree(top + offset, rng:NextNumber(0.9, 1.6), LEAF_COLORS[rng:NextInteger(1, #LEAF_COLORS)], parent, false)
	end
end

-- Sky theme: a giant rainbow arching over the road. `yaw` (degrees) turns it.
local function buildRainbowArc(center: Vector3, radius: number, yaw: number, parent: Instance)
	local across = Vector3.new(math.cos(math.rad(yaw)), 0, math.sin(math.rad(yaw))) -- the way it spans
	local facing = across:Cross(Vector3.yAxis)
	local band = 7
	local pieces = 28
	for k, color in RAINBOW do
		local r = radius - (k - 1) * band
		for p = 1, pieces do
			local a0, a1 = math.pi * (p - 1) / pieces, math.pi * p / pieces
			local p0 = center + (across * math.cos(a0) + Vector3.yAxis * math.sin(a0)) * r
			local p1 = center + (across * math.cos(a1) + Vector3.yAxis * math.sin(a1)) * r
			newPart("Part", ghost({
				Name = "RainbowBand",
				Size = Vector3.new(band, 3, (p1 - p0).Magnitude + 0.6),
				CFrame = CFrame.lookAt((p0 + p1) / 2, p1, facing),
				Color = color,
				Material = Enum.Material.Neon,
			}), parent)
		end
	end
end

-- Sky theme: a fluffy cloud made of a few big white balls
local function buildCloud(pos: Vector3, scale: number, rng: Random, parent: Instance)
	for _ = 1, 5 do
		newPart("Part", ghost({
			Name = "Cloud",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * rng:NextNumber(14, 26) * scale,
			CFrame = CFrame.new(pos + Vector3.new(rng:NextNumber(-22, 22), rng:NextNumber(-3, 5), rng:NextNumber(-12, 12)) * scale),
			Color = COLORS.White,
		}), parent)
	end
end

-- Sky theme: a striped hot-air balloon floating by the track
local function buildBalloon(pos: Vector3, color: Color3, parent: Instance)
	newPart("Part", ghost({
		Name = "Balloon",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 26,
		CFrame = CFrame.new(pos),
		Color = color,
	}), parent)
	for _, y in { 0, -13 } do -- a white stripe round the middle, and the neck at the bottom
		newPart("Part", ghost({
			Name = "BalloonStripe",
			Shape = Enum.PartType.Cylinder,
			Size = if y == 0 then Vector3.new(5, 26.6, 26.6) else Vector3.new(4, 8, 8),
			CFrame = upright(CFrame.new(pos + Vector3.new(0, y, 0))),
			Color = COLORS.White,
		}), parent)
	end
	local basket = pos - Vector3.new(0, 24, 0)
	newPart("Part", ghost({
		Name = "BalloonBasket",
		Size = Vector3.new(5, 4, 5),
		CFrame = CFrame.new(basket),
		Color = COLORS.Trunk,
		Material = Enum.Material.Wood,
	}), parent)
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			local top = pos + Vector3.new(x * 3, -15, z * 3)
			local bottom = basket + Vector3.new(x * 2.2, 2, z * 2.2)
			newPart("Part", ghost({
				Name = "BalloonRope",
				Size = Vector3.new(0.3, 0.3, (top - bottom).Magnitude),
				CFrame = CFrame.lookAt((top + bottom) / 2, top),
				Color = COLORS.Dark,
			}), parent)
		end
	end
end

-- Lava theme: a stepped volcano with a glowing crater, lava running down its sides and smoke on top
local function buildVolcano(base: Vector3, height: number, baseRadius: number, topRadius: number, rng: Random, parent: Instance)
	local tiers = math.max(4, math.floor(height / 14))
	local tierHeight = height / tiers
	for k = 0, tiers - 1 do
		local radius = baseRadius + (topRadius - baseRadius) * (k + 0.5) / tiers
		newPart("Part", ghost({
			Name = "VolcanoRock",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(tierHeight + 0.2, radius * 2, radius * 2),
			CFrame = upright(CFrame.new(base + Vector3.new(0, tierHeight * (k + 0.5), 0))),
			Color = if k % 2 == 0 then Color3.fromRGB(62, 50, 48) else Color3.fromRGB(76, 60, 56),
			Material = Enum.Material.Basalt,
		}), parent)
	end
	local top = base + Vector3.new(0, height, 0)
	newPart("Part", ghost({
		Name = "Crater",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, topRadius * 1.6, topRadius * 1.6),
		CFrame = upright(CFrame.new(top + Vector3.new(0, 0.1, 0))),
		Color = COLORS.Lava,
		Material = Enum.Material.Neon,
	}), parent)

	-- Glowing lava streams running from the crater to the bottom
	local slopeLength = math.sqrt(height * height + (baseRadius - topRadius) ^ 2)
	local offset = rng:NextNumber(0, math.pi * 2)
	for k = 1, 5 do
		local angle = offset + k * math.pi * 2 / 5 + rng:NextNumber(-0.3, 0.3)
		local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local downhill = (out * (baseRadius - topRadius) - Vector3.yAxis * height).Unit
		local outward = (out * height + Vector3.yAxis * (baseRadius - topRadius)).Unit
		local middle = base + Vector3.new(0, height / 2, 0) + out * ((baseRadius + topRadius) / 2) + outward * 2
		newPart("Part", ghost({
			Name = "LavaStream",
			Size = Vector3.new(rng:NextNumber(4, 8), slopeLength, 4),
			CFrame = CFrame.fromMatrix(middle, Vector3.yAxis:Cross(out), -downhill),
			Color = COLORS.Lava,
			Material = Enum.Material.Neon,
		}), parent)
	end

	-- Smoke puffing out of the top
	local vent = newPart("Part", ghost({
		Name = "SmokeVent",
		Size = Vector3.new(topRadius, 1, topRadius),
		CFrame = CFrame.new(top + Vector3.new(0, 3, 0)),
		Transparency = 1,
	}), parent)
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(Color3.fromRGB(80, 70, 70), Color3.fromRGB(160, 150, 150))
	smoke.Size = NumberSequence.new(topRadius * 0.4, topRadius * 1.2)
	smoke.Transparency = NumberSequence.new(0.35, 1)
	smoke.Lifetime = NumberRange.new(6, 9)
	smoke.Rate = 4
	smoke.Speed = NumberRange.new(10, 18)
	smoke.SpreadAngle = Vector2.new(15, 15)
	smoke.RotSpeed = NumberRange.new(-20, 20)
	smoke.Parent = vent
end

-- Lava theme: a jagged rock sticking out of the lava, glowing where it meets it
local function buildSpire(base: Vector3, radius: number, rng: Random, parent: Instance)
	local height = rng:NextNumber(30, 90)
	local cf = CFrame.new(base) * CFrame.Angles(math.rad(rng:NextNumber(-8, 8)), rng:NextNumber(0, math.pi), math.rad(rng:NextNumber(-8, 8)))
	newPart("Part", ghost({
		Name = "Spire",
		Size = Vector3.new(radius, height, radius),
		CFrame = cf * CFrame.new(0, height / 2 - 4, 0),
		Color = Color3.fromRGB(52, 44, 44),
		Material = Enum.Material.Basalt,
	}), parent)
	newPart("Part", ghost({
		Name = "SpireTip",
		Size = Vector3.new(radius * 0.55, height * 0.25, radius * 0.55),
		CFrame = cf * CFrame.new(0, height - 4 + height * 0.1, 0) * CFrame.Angles(0, math.rad(45), 0),
		Color = Color3.fromRGB(64, 52, 50),
		Material = Enum.Material.Basalt,
	}), parent)
	newPart("Part", ghost({
		Name = "SpireGlow",
		Size = Vector3.new(radius + 0.6, 2.5, radius + 0.6),
		CFrame = cf * CFrame.new(0, 1.5, 0),
		Color = COLORS.Lava,
		Material = Enum.Material.Neon,
	}), parent)
end

-- Snow theme: a big stepped mountain, rocky at the bottom and snowy on top
local function buildMountain(base: Vector3, radius: number, height: number, parent: Instance)
	local tiers = 7
	local tierHeight = height / tiers
	for k = 0, tiers - 1 do
		local tierRadius = radius * (1 - 0.85 * k / tiers)
		local snowy = k >= 3
		newPart("Part", ghost({
			Name = "Mountain",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(tierHeight + 0.2, tierRadius * 2, tierRadius * 2),
			CFrame = upright(CFrame.new(base + Vector3.new(0, tierHeight * (k + 0.5), 0))),
			Color = if snowy then Color3.fromRGB(245, 248, 255) else Color3.fromRGB(120, 125, 140),
			Material = if snowy then Enum.Material.Snow else Enum.Material.Slate,
		}), parent)
	end
end

-- Snow theme: a pine tree made of stacked discs, with snow on each layer
local function buildPine(base: Vector3, scale: number, parent: Instance)
	newPart("Part", ghost({
		Name = "PineTrunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3.5 * scale, 1.2 * scale, 1.2 * scale),
		CFrame = upright(CFrame.new(base + Vector3.new(0, 1.75 * scale, 0))),
		Color = COLORS.Trunk,
		Material = Enum.Material.Wood,
	}), parent)
	for _, layer in { { 3, 9 }, { 5.4, 6.6 }, { 7.6, 4.2 } } do -- { height, width }
		local y, w = layer[1], layer[2]
		newPart("Part", ghost({
			Name = "PineLeaves",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(2.4 * scale, w * scale, w * scale),
			CFrame = upright(CFrame.new(base + Vector3.new(0, y * scale, 0))),
			Color = Color3.fromRGB(35, 105, 70),
			Material = Enum.Material.Grass,
		}), parent)
		newPart("Part", ghost({
			Name = "PineSnow",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.5 * scale, w * 0.8 * scale, w * 0.8 * scale),
			CFrame = upright(CFrame.new(base + Vector3.new(0, (y + 1.3) * scale, 0))),
			Color = COLORS.White,
			Material = Enum.Material.Snow,
		}), parent)
	end
end

-- Lava theme: a hollow volcano with a lava lake inside. Roads drive right
-- through its sides, so the rock leaves an opening wherever one passes.
local function buildCrater(center: Vector3, rimRadius: number, rimY: number, lakeY: number, groundY: number, roads: { Vector3 }, roadHalf: { number }, rng: Random, parent: Instance, hazards: Instance?)
	local height = rimY - groundY
	local tiers = math.max(5, math.floor(height / 16))
	local tierHeight = height / tiers
	local function innerAt(y: number): number -- the inside wall leans in a little towards the top
		return rimRadius + (rimY - y) * 0.25
	end
	for k = 0, tiers - 1 do
		local y = groundY + tierHeight * (k + 0.5)
		local inner = innerAt(y)
		local outer = rimRadius + 30 + (rimY - y) * 0.8 -- the outside slopes out like a mountain
		local thickness = outer - inner
		local mid = (inner + outer) / 2
		local blocks = math.ceil(2 * math.pi * mid / 36)
		for b = 1, blocks do
			local angle = (b - 0.5) / blocks * 2 * math.pi
			local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
			local pos = Vector3.new(center.X, y, center.Z) + out * mid
			local open = false
			for i, p in roads do
				if math.abs(p.Y - y) < tierHeight / 2 + 24 and Vector3.new(p.X - pos.X, 0, p.Z - pos.Z).Magnitude < thickness / 2 + roadHalf[i] + 14 then
					open = true
					break
				end
			end
			if not open then
				newPart("Part", ghost({
					Name = "CraterRock",
					Size = Vector3.new(thickness, tierHeight + 0.4, 2 * math.pi * outer / blocks + 2),
					CFrame = CFrame.fromMatrix(pos, out, Vector3.yAxis),
					Color = if (k + b) % 3 == 0 then Color3.fromRGB(76, 60, 56) else Color3.fromRGB(62, 50, 48),
					Material = Enum.Material.Basalt,
				}), parent)
			end
		end
	end

	-- The lava lake. Fall in and you're put straight back on the track.
	local lakeRadius = innerAt(lakeY)
	newPart("Part", ghost({
		Name = "CraterLake",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, lakeRadius * 2, lakeRadius * 2),
		CFrame = upright(CFrame.new(center.X, lakeY - 1, center.Z)),
		Color = COLORS.Lava,
		Material = Enum.Material.Neon,
	}), parent)
	if hazards then
		newPart("Part", {
			Name = "CraterLakeHeat",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(8, lakeRadius * 2, lakeRadius * 2),
			CFrame = upright(CFrame.new(center.X, lakeY + 2, center.Z)),
			Transparency = 1,
			CanCollide = false,
			CanTouch = false,
			Attributes = { Hazard = "Burn" },
		}, hazards)
	end

	-- Lava pouring down the inside walls into the lake (not where a road comes in)
	for _ = 1, 7 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local midY = (rimY + lakeY) / 2
		local pos = Vector3.new(center.X, midY, center.Z) + out * (innerAt(midY) - 0.6)
		local nearRoad = false
		for i, p in roads do
			if Vector3.new(p.X - pos.X, 0, p.Z - pos.Z).Magnitude < roadHalf[i] + 30 then
				nearRoad = true
				break
			end
		end
		if not nearRoad then
			local upTheWall = (Vector3.yAxis - out * 0.25).Unit -- the wall leans in, so the lava does too
			newPart("Part", ghost({
				Name = "LavaFall",
				Size = Vector3.new(1, (rimY - lakeY) * 1.03, rng:NextNumber(6, 12)),
				CFrame = CFrame.fromMatrix(pos, (out + Vector3.yAxis * 0.25).Unit, upTheWall),
				Color = COLORS.Lava,
				Material = Enum.Material.Neon,
			}), parent)
		end
	end

	-- Smoke rising from the rim
	for k = 1, 3 do
		local angle = k * math.pi * 2 / 3 + rng:NextNumber(-0.4, 0.4)
		local vent = newPart("Part", ghost({
			Name = "SmokeVent",
			Size = Vector3.new(30, 1, 30),
			CFrame = CFrame.new(Vector3.new(center.X, rimY + 4, center.Z) + Vector3.new(math.cos(angle), 0, math.sin(angle)) * (rimRadius + 10)),
			Transparency = 1,
		}), parent)
		local smoke = Instance.new("ParticleEmitter")
		smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
		smoke.Color = ColorSequence.new(Color3.fromRGB(80, 70, 70), Color3.fromRGB(160, 150, 150))
		smoke.Size = NumberSequence.new(14, 40)
		smoke.Transparency = NumberSequence.new(0.35, 1)
		smoke.Lifetime = NumberRange.new(6, 9)
		smoke.Rate = 2
		smoke.Speed = NumberRange.new(10, 18)
		smoke.SpreadAngle = Vector2.new(15, 15)
		smoke.RotSpeed = NumberRange.new(-20, 20)
		smoke.Parent = vent
	end
end

-- Decorations around a track, depending on its theme
local function buildScenery(cfg, track: Instance, samples: { Vector3 }, halfWidths: { number }, groundY: number)
	local parent = newFolder("Scenery", track)
	local style = cfg.style
	local rng = Random.new(cfg.SCENERY_SEED)
	local scatter = newScatter(samples, halfWidths, rng)
	if style.Ground then
		buildGround(samples, groundY, style, parent)
	end

	if cfg.theme == "Lava" then
		local crater = cfg.CRATER
		if crater then
			local center = cfg.ORIGIN + crater.center
			local rimY = cfg.ORIGIN.Y + crater.rim
			scatter.reserve(center, crater.radius + 30 + (rimY - groundY) * 0.8)
			buildCrater(center, crater.radius, rimY, cfg.ORIGIN.Y + crater.lake, groundY, samples, halfWidths, rng, parent, track:FindFirstChild("Hazards"))
		end
		for _ = 1, 3 do -- volcanoes in the distance
			local radius = rng:NextNumber(70, 100)
			local spot = scatter.find(radius, 150, 450)
			if spot then
				buildVolcano(Vector3.new(spot.X, groundY, spot.Z), rng:NextNumber(70, 120), radius, radius * 0.3, rng, parent)
			end
		end
		for _ = 1, 30 do -- rocks sticking out of the lava
			local radius = rng:NextNumber(6, 14)
			local spot = scatter.find(radius, 45, 300)
			if spot then
				buildSpire(Vector3.new(spot.X, groundY, spot.Z), radius, rng, parent)
			end
		end
	elseif cfg.theme == "Snow" then
		for _ = 1, 12 do -- snowy mountains all around
			local radius = rng:NextNumber(70, 130)
			local spot = scatter.find(radius, 100, 400)
			if spot then
				buildMountain(Vector3.new(spot.X, groundY, spot.Z), radius, rng:NextNumber(140, 260), parent)
			end
		end
		for _ = 1, 50 do -- pine forest in the valley under the road
			local scale = rng:NextNumber(2.6, 4.2)
			local spot = scatter.find(4.5 * scale, 28, 220)
			if spot then
				buildPine(Vector3.new(spot.X, groundY, spot.Z), scale, parent)
			end
		end
	else
		local arc = cfg.RAINBOW_ARC
		if arc then
			buildRainbowArc(cfg.ORIGIN + arc.center, arc.radius, arc.yaw or 0, parent)
		end
		for _ = 1, 22 do -- floating islands
			local radius = rng:NextNumber(14, 32)
			local spot = scatter.find(radius, 60, 250)
			if spot then
				buildIsland(spot + Vector3.new(0, cfg.ORIGIN.Y + rng:NextNumber(-20, 25), 0), radius, rng, parent)
			end
		end
		for _ = 1, 30 do -- clouds, some puffing up out of the cloud sea
			local spot = scatter.find(30, 50, 300)
			if spot then
				buildCloud(Vector3.new(spot.X, rng:NextNumber(groundY - 4, cfg.ORIGIN.Y + 5), spot.Z), rng:NextNumber(0.8, 1.6), rng, parent)
			end
		end
		for k = 1, 7 do -- hot-air balloons
			local spot = scatter.find(16, 70, 250)
			if spot then
				buildBalloon(spot + Vector3.new(0, cfg.ORIGIN.Y + rng:NextNumber(20, 70), 0), RAINBOW[k % #RAINBOW + 1], parent)
			end
		end
	end
end

------------------------------------------------------------------------
-- WORLD SETUP
------------------------------------------------------------------------
setupCollisionGroups()

local lobbyFolder: Instance = workspace:FindFirstChild("RaceLobby") or buildLobby()

-- Remove any other spawn points (like the default one) so everyone spawns in the lobby
for _, descendant in workspace:GetDescendants() do
	if descendant:IsA("SpawnLocation") and not descendant:IsDescendantOf(lobbyFolder) then
		descendant:Destroy()
	end
end

local kartsFolder = newFolder("Karts", workspace)

-- The track in the world right now. Only one exists at a time: it's swapped
-- for a new one whenever a different track wins the vote.
local trackFolder: Instance = nil :: any
local currentTrackDef = nil

-- Builds a track with its scenery and sky, replacing the old one
local function loadTrack(def)
	local cfg = makeConfig(def)
	local ok, result = pcall(function()
		local track, samples, halfWidths = buildTrack(cfg)
		buildScenery(cfg, track, samples, halfWidths, (track:GetAttribute("KillY") :: number) + 6)
		return track
	end)
	if not ok then
		warn("[RaceServer] Couldn't build " .. tostring(def.name) .. ":", result)
		if def ~= TRACKS[1] then
			loadTrack(TRACKS[1])
			return
		end
		error(result)
	end
	if trackFolder then
		trackFolder:Destroy()
	end
	trackFolder = result
	result.Parent = workspace
	currentTrackDef = def
	applyLighting(cfg.style)
	raceState:SetAttribute("TrackId", def.id)
	raceState:SetAttribute("TrackName", def.name)
end

loadTrack(TRACKS[math.random(1, #TRACKS)])

-- Studio testing helper: switch tracks without waiting for a vote. While
-- playing in Studio, switch the command bar to "Server" and run:
--   game.ServerStorage.PreviewTrack:Invoke("Frosty")
if RunService:IsStudio() then
	local preview = Instance.new("BindableFunction")
	preview.Name = "PreviewTrack"
	preview.OnInvoke = function(id: any): boolean
		for _, def in TRACKS do
			if def.id == id then
				loadTrack(def)
				return true
			end
		end
		return false
	end
	preview.Parent = game:GetService("ServerStorage")
end

local function getKillY(): number
	local value = trackFolder:GetAttribute("KillY")
	return if typeof(value) == "number" then value else -math.huge
end

local function sortedByNumber(folder: Instance?): { BasePart }
	local list: { BasePart } = {}
	if not folder then
		return list
	end
	for _, child in folder:GetChildren() do
		if child:IsA("BasePart") and tonumber(child.Name) then
			table.insert(list, child)
		end
	end
	table.sort(list, function(a, b)
		return (tonumber(a.Name) or 0) < (tonumber(b.Name) or 0)
	end)
	return list
end

-- Lights 1..lit glow in `color`, the rest go dark
local function setStartLights(lit: number, color: Color3)
	for k, light in sortedByNumber(trackFolder:FindFirstChild("StartLights")) do
		local on = k <= lit
		light.Color = if on then color else COLORS.LightOff
		light.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
	end
end

-- Finds a TextLabel on one of the lobby's signs (nil if the sign isn't there)
local function lobbyLabel(partName: string, labelName: string): TextLabel?
	local part = lobbyFolder:FindFirstChild(partName)
	local gui = part and part:FindFirstChildWhichIsA("SurfaceGui")
	local label = gui and gui:FindFirstChild(labelName)
	return if label and label:IsA("TextLabel") then label else nil
end

-- Name of the track that's winning the vote right now (nil if nobody has voted yet)
local function leadingTrackName(): string?
	local bestName, bestCount = nil, 0
	for k = 1, SETTINGS.VOTE_CHOICES do
		local count = tonumber(raceState:GetAttribute("Votes" .. k)) or 0
		local id = raceState:GetAttribute("Option" .. k)
		for _, def in TRACKS do
			if def.id == id and count > bestCount then
				bestName, bestCount = def.name, count
			end
		end
	end
	return bestName
end

local function updateLobbyScreen()
	local title = lobbyLabel("StatusScreen", "Title")
	local subtitle = lobbyLabel("StatusScreen", "Subtitle")
	if not (title and subtitle) then
		return
	end
	local phase = raceState:GetAttribute("Phase")
	local trackName = tostring(raceState:GetAttribute("TrackName") or "the track")
	if phase == "Intermission" then
		title.Text = string.format("NEXT RACE IN %d", tonumber(raceState:GetAttribute("Countdown")) or 0)
		local leader = leadingTrackName()
		subtitle.Text = if leader then "Vote for a track!  Winning: " .. leader else "Vote for the next track on your screen!"
	elseif phase == "Reveal" then
		title.Text = string.upper(trackName) .. "!"
		subtitle.Text = "Racers are heading to the track!"
	elseif phase == "Countdown" then
		title.Text = "GET READY..."
		subtitle.Text = "The race on " .. trackName .. " is about to start!"
	elseif phase == "Racing" then
		title.Text = "RACE IN PROGRESS"
		subtitle.Text = string.format("%d racing on %s — you're in the next one!", tonumber(raceState:GetAttribute("RacerCount")) or 0, trackName)
	elseif phase == "Results" then
		title.Text = "RACE OVER!"
		subtitle.Text = "Next race starting soon"
	else
		title.Text = "WAITING FOR PLAYERS"
		subtitle.Text = "Races start automatically"
	end
end
raceState:GetAttributeChangedSignal("Phase"):Connect(updateLobbyScreen)
raceState:GetAttributeChangedSignal("Countdown"):Connect(updateLobbyScreen)
for k = 1, SETTINGS.VOTE_CHOICES do
	raceState:GetAttributeChangedSignal("Votes" .. k):Connect(updateLobbyScreen)
end
updateLobbyScreen()

local function setPodium(results: { { name: string, place: number?, time: number? } })
	for place = 1, 3 do
		local label = lobbyLabel("PodiumName" .. place, "PlayerName")
		if label then
			local name = "—"
			for _, entry in results do
				if entry.place == place then
					name = entry.name
					break
				end
			end
			label.Text = name
		end
	end
end

------------------------------------------------------------------------
-- LEADERBOARD (DataStore)
------------------------------------------------------------------------
local winsStore: OrderedDataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(SETTINGS.DATASTORE_NAME)
	end)
	if ok then
		winsStore = result
	else
		warn("[RaceServer] DataStores unavailable:", result)
	end
end

local nameCache: { [number]: string } = {}
local function getName(userId: number): string
	local cached = nameCache[userId]
	if cached then
		return cached
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and name then name else ("Player " .. userId)
	nameCache[userId] = result
	return result
end

local function setBoard(rows: { { name: string, wins: number } }?, status: string)
	local board = lobbyFolder:FindFirstChild("LeaderboardBoard")
	local gui = board and board:FindFirstChild("Leaderboard")
	local list = gui and gui:FindFirstChild("List")
	if not (gui and list) then
		return
	end
	local statusLabel = gui:FindFirstChild("Status") :: TextLabel?
	if statusLabel then
		statusLabel.Text = status
	end
	for rank = 1, SETTINGS.LEADERBOARD_SIZE do
		local row = list:FindFirstChild("Row" .. rank)
		if not row then
			continue
		end
		local nameLabel = row:FindFirstChild("PlayerName") :: TextLabel?
		local winsLabel = row:FindFirstChild("Wins") :: TextLabel?
		local entry = rows and rows[rank]
		if nameLabel then
			nameLabel.Text = if entry then entry.name else "—"
		end
		if winsLabel then
			winsLabel.Text = if entry then (entry.wins .. (if entry.wins == 1 then " win" else " wins")) else ""
		end
	end
end

local refreshing = false
local function refreshLeaderboard()
	if refreshing then
		return
	end
	refreshing = true
	local store = winsStore
	if not store then
		setBoard(nil, "Leaderboard offline (see the Output window)")
	else
		local ok, pages = pcall(function()
			return store:GetSortedAsync(false, SETTINGS.LEADERBOARD_SIZE)
		end)
		if ok and pages then
			local rows = {}
			for rank, entry in pages:GetCurrentPage() do
				rows[rank] = { name = getName(tonumber(entry.key) or 0), wins = entry.value }
			end
			setBoard(rows, if #rows == 0 then "No winners yet — be the first!" else "Updates every minute")
		else
			setBoard(nil, "Leaderboard offline (see the Output window)")
			warn(
				"[RaceServer] Couldn't load the leaderboard:",
				pages,
				"\nTesting in Studio? Publish the game, then turn on Game Settings > Security > 'Enable Studio Access to API Services'."
			)
		end
	end
	refreshing = false
end

local function awardWin(player: Player)
	local leaderstats = player:FindFirstChild("leaderstats")
	local wins = leaderstats and leaderstats:FindFirstChild("Wins")
	if wins and wins:IsA("IntValue") then
		wins.Value += 1
	end
	local store = winsStore
	-- Studio test players have negative ids; don't put them on the real board
	if not store or player.UserId <= 0 then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			store:IncrementAsync(tostring(player.UserId), 1)
		end)
		if not ok then
			warn("[RaceServer] Couldn't save win for", player.Name, err)
		end
		task.wait(2)
		refreshLeaderboard()
	end)
end

------------------------------------------------------------------------
-- RACERS
------------------------------------------------------------------------
type Racer = {
	player: Player,
	kart: Model,
	hitbox: BasePart,
	seat: VehicleSeat,
	humanoid: Humanoid,
	nextCheckpoint: number,
	respawnCFrame: CFrame,
	progress: number,
	finished: boolean,
	place: number?,
	finishTime: number?,
	returned: boolean,
	lastRespawn: number,
	connections: { RBXScriptConnection },
}

local racers: { [Player]: Racer } = {}

local function setPhase(phase: string)
	raceState:SetAttribute("Phase", phase)
end

-- Players standing in the lobby, alive, and not already in a race
local function getLobbyPlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if racers[player] then
			continue
		end
		local character = player.Character
		if not character or not character:FindFirstChild("HumanoidRootPart") then
			continue
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			table.insert(list, player)
		end
	end
	return list
end

-- Gives the player a fresh character at the lobby spawn
local function respawnInLobby(player: Player)
	local ok = pcall(function()
		player:LoadCharacterAsync()
	end)
	if not ok and player.Parent == Players then
		player:LoadCharacter() -- older name for the same thing
	end
end

-- Removes a racer's kart and (optionally) sends them back to the lobby
local function releaseRacer(racer: Racer, sendToLobby: boolean)
	if racer.returned then
		return
	end
	racer.returned = true
	for _, connection in racer.connections do
		connection:Disconnect()
	end
	table.clear(racer.connections)
	racer.kart:Destroy()

	local player = racer.player
	player:SetAttribute("Racing", false)
	player:SetAttribute("Finished", false)
	player:SetAttribute("Place", nil)
	if sendToLobby and player.Parent == Players then
		task.spawn(respawnInLobby, player)
	end
end

local function seatDriver(racer: Racer)
	local character = racer.player.Character
	if not character or racer.humanoid.Health <= 0 or racer.seat.Occupant == racer.humanoid then
		return
	end
	character:PivotTo(racer.seat.CFrame * CFrame.new(0, 3, 0))
	racer.seat:Sit(racer.humanoid)
end

-- Puts a racer back at their last checkpoint. `reason`: "Fell" (off the track),
-- "Lava" (drove into lava) or nil (they pressed the respawn button).
local function respawnRacer(racer: Racer, reason: string?)
	if racer.finished or racer.returned or raceState:GetAttribute("Phase") ~= "Racing" then
		return
	end
	local now = os.clock()
	local cooldown = if reason then 0.75 else SETTINGS.RESPAWN_COOLDOWN
	if now - racer.lastRespawn < cooldown then
		return
	end
	racer.lastRespawn = now
	local target = racer.respawnCFrame + Vector3.new(0, 2.5, 0)
	racer.kart:PivotTo(target)
	racer.hitbox.AssemblyLinearVelocity = Vector3.zero
	racer.hitbox.AssemblyAngularVelocity = Vector3.zero
	raceEvent:FireClient(racer.player, "Respawned", target, reason)
	seatDriver(racer)
end

local function addRacer(player: Player, gridIndex: number, slot: BasePart): Racer?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end

	local color = KART_COLORS[(gridIndex - 1) % #KART_COLORS + 1]
	local kart, hitbox, seat = buildKart(color, slot.CFrame + Vector3.new(0, KART_RIDE_HEIGHT, 0))
	kart.Name = player.Name .. "_Kart"
	kart:SetAttribute("OwnerUserId", player.UserId)
	kart.Parent = kartsFolder

	humanoid.JumpPower = 0 -- jumping would pop them out of the seat
	humanoid.JumpHeight = 0

	local racer: Racer = {
		player = player,
		kart = kart,
		hitbox = hitbox,
		seat = seat,
		humanoid = humanoid,
		nextCheckpoint = 1,
		respawnCFrame = slot.CFrame,
		progress = 0,
		finished = false,
		place = nil,
		finishTime = nil,
		returned = false,
		lastRespawn = 0,
		connections = {},
	}
	racers[player] = racer
	seatDriver(racer)

	player:SetAttribute("Racing", true)
	player:SetAttribute("Finished", false)
	player:SetAttribute("Place", gridIndex)

	-- If they somehow get out of the kart, put them back in
	table.insert(racer.connections, seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		if seat.Occupant == nil and not racer.finished and not racer.returned then
			task.delay(0.3, function()
				if not racer.returned then
					seatDriver(racer)
				end
			end)
		end
	end))
	-- Died or reset: out of this race, they'll respawn in the lobby automatically
	table.insert(racer.connections, humanoid.Died:Connect(function()
		releaseRacer(racer, false)
	end))
	table.insert(racer.connections, player.CharacterRemoving:Connect(function()
		releaseRacer(racer, false)
	end))
	return racer
end

-- If `pos` has just gone through a gate (checkpoint or respawn point) the
-- right way, how far past it it is. Otherwise nil.
local function distancePast(gate: BasePart, pos: Vector3): number?
	local rel = gate.CFrame:PointToObjectSpace(pos) -- negative Z = in front of the gate
	local half = gate.Size / 2
	if rel.Z <= 0 and rel.Z > -60 and math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y then
		return -rel.Z
	end
	return nil
end

local function passedCheckpoint(checkpoint: BasePart, pos: Vector3): boolean
	return distancePast(checkpoint, pos) ~= nil
end

local function shuffle(list: { any })
	for i = #list, 2, -1 do
		local j = math.random(1, i)
		list[i], list[j] = list[j], list[i]
	end
end

------------------------------------------------------------------------
-- THE RACE
------------------------------------------------------------------------
local function runRace()
	local checkpoints = sortedByNumber(trackFolder:FindFirstChild("Checkpoints"))
	local slots = sortedByNumber(trackFolder:FindFirstChild("StartSlots"))
	local startLine = trackFolder:FindFirstChild("StartLine") :: BasePart?
	if #checkpoints == 0 or #slots == 0 or not startLine then
		warn("[RaceServer] RaceTrack is missing Checkpoints, StartSlots or StartLine")
		task.wait(5)
		return
	end
	local killY = getKillY()
	-- Places you can be put back at: every checkpoint and respawn point
	local respawnGates: { BasePart } = table.clone(checkpoints)
	local respawnFolder = trackFolder:FindFirstChild("RespawnPoints")
	for _, point in if respawnFolder then respawnFolder:GetChildren() else {} do
		if point:IsA("BasePart") then
			table.insert(respawnGates, point)
		end
	end

	-- 1) Put everyone from the lobby into a kart on the grid
	local entrants = getLobbyPlayers()
	shuffle(entrants)
	table.clear(racers)
	local startedCount = 0
	for _, player in entrants do
		if startedCount >= math.min(SETTINGS.MAX_RACERS, #slots) then
			break
		end
		if addRacer(player, startedCount + 1, slots[startedCount + 1]) then
			startedCount += 1
		end
	end
	if startedCount == 0 then
		return
	end
	raceState:SetAttribute("RacerCount", startedCount)

	-- 2) Countdown (the start lights come on one by one)
	raceState:SetAttribute("Countdown", 0)
	setStartLights(0, COLORS.LightRed)
	setPhase("Countdown")
	task.wait(1)
	for n = SETTINGS.COUNTDOWN_TIME, 1, -1 do
		raceState:SetAttribute("Countdown", n)
		setStartLights(SETTINGS.COUNTDOWN_TIME - n + 1, COLORS.LightRed)
		for _, racer in racers do
			if not racer.returned then
				seatDriver(racer)
			end
		end
		task.wait(1)
	end

	-- 3) GO! Unfreeze the karts and hand each one's physics to its driver,
	--    so driving feels instant on their screen.
	local raceStart = workspace:GetServerTimeNow()
	local deadline = raceStart + SETTINGS.RACE_TIME_LIMIT
	raceState:SetAttribute("RaceStart", raceStart)
	raceState:SetAttribute("RaceEnd", deadline)
	for player, racer in racers do
		if not racer.returned then
			racer.hitbox.Anchored = false
			pcall(function()
				racer.hitbox:SetNetworkOwner(player)
			end)
		end
	end
	setStartLights(SETTINGS.COUNTDOWN_TIME, COLORS.LightGreen)
	setPhase("Racing")

	-- 4) Track progress every frame until everyone is done or time runs out
	local finishedCount = 0
	while true do
		RunService.Heartbeat:Wait()
		local now = workspace:GetServerTimeNow()
		local stillRacing = 0

		for player, racer in racers do
			if racer.returned or racer.finished then
				continue
			end
			stillRacing += 1
			local pos = racer.hitbox.Position

			if pos.Y < killY then
				respawnRacer(racer, "Fell")
				continue
			end

			-- Passed the next gate? (also checks the one after, in case a lag spike skipped one)
			local index = racer.nextCheckpoint
			local passed = nil
			if checkpoints[index] and passedCheckpoint(checkpoints[index], pos) then
				passed = index
			elseif checkpoints[index + 1] and passedCheckpoint(checkpoints[index + 1], pos) then
				passed = index + 1
			end
			if passed then
				racer.nextCheckpoint = passed + 1
			end
			-- Respawn at whichever gate they went through most recently
			local latest, latestGap = nil, math.huge
			for _, gate in respawnGates do
				local gap = distancePast(gate, pos)
				if gap and gap < latestGap then
					latest, latestGap = gate, gap
				end
			end
			if latest then
				racer.respawnCFrame = flatCFrame(latest.Position, latest.CFrame.LookVector)
			end

			if racer.nextCheckpoint > #checkpoints then
				-- Crossed the finish line
				finishedCount += 1
				racer.finished = true
				racer.place = finishedCount
				racer.finishTime = now - raceStart
				player:SetAttribute("Finished", true)
				player:SetAttribute("Place", finishedCount)
				raceEvent:FireAllClients("RacerFinished", player.UserId, player.DisplayName, finishedCount, racer.finishTime)

				if finishedCount == 1 then
					if now + SETTINGS.TIME_AFTER_FIRST_FINISH < deadline then
						deadline = now + SETTINGS.TIME_AFTER_FIRST_FINISH
						raceState:SetAttribute("RaceEnd", deadline)
					end
					if startedCount >= SETTINGS.MIN_RACERS_FOR_WIN then
						awardWin(player)
					end
				end
				task.delay(SETTINGS.RETURN_DELAY, function()
					releaseRacer(racer, true)
				end)
			else
				-- How far along the track they are, for live 1st/2nd/3rd...
				local target = checkpoints[racer.nextCheckpoint].Position
				local previous = if racer.nextCheckpoint == 1 then startLine.Position else checkpoints[racer.nextCheckpoint - 1].Position
				local segment = math.max((target - previous).Magnitude, 1)
				local fraction = 1 - math.clamp((target - pos).Magnitude / segment, 0, 1)
				racer.progress = (racer.nextCheckpoint - 1) + fraction
			end
		end

		-- Live positions for everyone still driving
		local order: { Racer } = {}
		for _, racer in racers do
			if not racer.finished and not racer.returned then
				table.insert(order, racer)
			end
		end
		table.sort(order, function(a, b)
			return a.progress > b.progress
		end)
		for rank, racer in order do
			local place = finishedCount + rank
			if racer.player:GetAttribute("Place") ~= place then
				racer.player:SetAttribute("Place", place)
			end
		end

		if stillRacing == 0 or now >= deadline then
			break
		end
	end

	-- 5) Race over
	local anyoneOnTrack = false
	for _, racer in racers do
		if not racer.returned then
			anyoneOnTrack = true
			if not racer.finished then
				raceEvent:FireClient(racer.player, "TimeUp")
			end
		end
	end
	setPhase("Results")
	if anyoneOnTrack then
		task.wait(SETTINGS.RETURN_DELAY)
	end

	local results = {}
	for _, racer in racers do
		table.insert(results, { name = racer.player.DisplayName, place = racer.place, time = racer.finishTime })
	end
	table.sort(results, function(a, b)
		if a.place and b.place then
			return a.place < b.place
		elseif a.place then
			return true
		elseif b.place then
			return false
		end
		return a.name < b.name
	end)
	for _, racer in racers do
		releaseRacer(racer, true)
	end
	raceEvent:FireAllClients("Results", results)
	setPodium(results)
	setStartLights(0, COLORS.LightOff)
	table.clear(racers)
end

------------------------------------------------------------------------
-- TRACK VOTE  (players pick the next track while they wait in the lobby)
------------------------------------------------------------------------
local voteOptions: { any } = {} -- the tracks on offer this time
local votes: { [Player]: number } = {} -- which option each player picked

local function countVotes(): { number }
	local counts = table.create(#voteOptions, 0)
	for player, choice in votes do
		if player.Parent == Players and counts[choice] then
			counts[choice] += 1
		end
	end
	return counts
end

-- Shares the vote totals with everyone's screen (and the lobby's big screen)
local function publishVotes()
	local counts = countVotes()
	for k = 1, SETTINGS.VOTE_CHOICES do
		raceState:SetAttribute("Votes" .. k, counts[k] or 0)
	end
end

-- Picks a few random tracks for players to choose between
local function startVote()
	table.clear(votes)
	local pool = table.clone(TRACKS)
	shuffle(pool)
	voteOptions = {}
	for k = 1, SETTINGS.VOTE_CHOICES do
		voteOptions[k] = pool[k]
		raceState:SetAttribute("Option" .. k, if pool[k] then pool[k].id else nil)
	end
	for _, player in Players:GetPlayers() do
		player:SetAttribute("Vote", nil)
	end
	publishVotes()
end

-- A player tapped a track card. Clients can send anything, so make sure it's a real option.
local function castVote(player: Player, choice: any)
	if raceState:GetAttribute("Phase") ~= "Intermission" or racers[player] then
		return
	end
	if typeof(choice) ~= "number" or choice % 1 ~= 0 or not voteOptions[choice] then
		return
	end
	votes[player] = choice
	player:SetAttribute("Vote", choice)
	publishVotes()
end

-- The option with the most votes wins; a tie (or no votes at all) is decided at random
local function finishVote()
	local counts = countVotes()
	local best, tied = -1, {}
	for k in voteOptions do
		if counts[k] > best then
			best, tied = counts[k], { k }
		elseif counts[k] == best then
			table.insert(tied, k)
		end
	end
	return voteOptions[tied[math.random(1, #tied)]]
end

------------------------------------------------------------------------
-- PLAYERS
------------------------------------------------------------------------
local function onCharacterAdded(character: Model)
	local function setGroup(descendant: Instance)
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = "Racers"
		end
	end
	for _, descendant in character:GetDescendants() do
		setGroup(descendant)
	end
	character.DescendantAdded:Connect(setGroup)
end

local function onPlayerAdded(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats" -- this exact name shows stats in the player list
	local wins = Instance.new("IntValue")
	wins.Name = "Wins"
	wins.Parent = leaderstats
	leaderstats.Parent = player

	player.CharacterAdded:Connect(onCharacterAdded)
	if player.Character then
		onCharacterAdded(player.Character)
	end

	local store = winsStore
	if store and player.UserId > 0 then
		task.spawn(function()
			local ok, value = pcall(function()
				return (store:GetAsync(tostring(player.UserId)))
			end)
			if ok and typeof(value) == "number" then
				wins.Value += value
			end
		end)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	onPlayerAdded(player)
	if player.Character then
		task.spawn(respawnInLobby, player) -- anyone who spawned before the lobby existed
	end
end

Players.PlayerRemoving:Connect(function(player)
	local racer = racers[player]
	if racer then
		releaseRacer(racer, false)
	end
	if votes[player] then
		votes[player] = nil
		publishVotes()
	end
end)

raceEvent.OnServerEvent:Connect(function(player, action, choice)
	if action == "Respawn" then
		local racer = racers[player]
		if racer and not racer.returned then
			-- `choice` is the client's reason. Respawning only ever sends you back,
			-- so trusting "Lava" just shortens the cooldown, which can't be abused.
			local reason = if racer.hitbox.Position.Y < getKillY() then "Fell" elseif choice == "Lava" then "Lava" else nil
			respawnRacer(racer, reason)
		end
	elseif action == "Vote" then
		castVote(player, choice)
	end
end)

task.spawn(function()
	while true do
		refreshLeaderboard()
		task.wait(SETTINGS.LEADERBOARD_REFRESH)
	end
end)

------------------------------------------------------------------------
-- MAIN LOOP
------------------------------------------------------------------------
while true do
	setPhase("Waiting")
	while #getLobbyPlayers() < SETTINGS.MIN_PLAYERS_TO_START do
		task.wait(1)
	end

	-- Lobby time: everyone votes for the next track
	startVote()
	setPhase("Intermission")
	local cancelled = false
	for t = SETTINGS.INTERMISSION_TIME, 1, -1 do
		raceState:SetAttribute("Countdown", t)
		task.wait(1)
		if #getLobbyPlayers() < SETTINGS.MIN_PLAYERS_TO_START then
			cancelled = true
			break
		end
	end

	if not cancelled then
		local ok, err = pcall(function()
			-- Build the winning track (unless it's already there), announce it, then race
			local winner = finishVote()
			if winner ~= currentTrackDef then
				loadTrack(winner)
			end
			setPhase("Reveal")
			task.wait(SETTINGS.TRACK_REVEAL_TIME)
			runRace()
		end)
		if not ok then
			warn("[RaceServer] Race crashed:", err)
			for _, racer in racers do
				releaseRacer(racer, true)
			end
			table.clear(racers)
			setStartLights(0, COLORS.LightOff)
		end
	end
end
]]></ProtectedString>
