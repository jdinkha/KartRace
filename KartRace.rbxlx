		RockMaterial = Enum.Material.Snow,
		Torch = Color3.fromRGB(120, 220, 255), -- glowing ice lanterns on the walls of rooms and caves
		Weather = "Snow",
		ClockTime = 12.5,
		Atmosphere = { Density = 0.38, Offset = 0.2, Color = Color3.fromRGB(225, 238, 255), Decay = Color3.fromRGB(150, 175, 210), Glare = 0, Haze = 2.2 },
