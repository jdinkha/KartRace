		</Item>
		<Item class="ModuleScript" referent="RBXF0C4A85AF55A4B278E93350ADFABEE97">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--[[
	TrackCheck  —  a Studio helper for designing tracks (it isn't used by the game).

	In Studio's command bar (with the game stopped) run:
		print(require(game.ServerStorage.TrackCheck:Clone())("Magma"))
	It measures the track in RaceServer > Tracks and lists any problems:
	  • two bits of road (or road and a branch) overlapping or crashing through
	    each other: they need to be further apart, or one at least 20 studs higher
	  • corners so tight that the inside edge of the road would fold over itself
	  • road running through the lobby
	Positions are in the same numbers as the track's POINTS.
]]

local ROAD_WIDTH, BRANCH_WIDTH, OFFROAD, STEP, ROOM_EASE = 46, 30, 10, 12, 60
local LOBBY = Vector3.new(-110, 0, 0)

local function catmullRom(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, t: number): Vector3
	local t2, t3 = t * t, t * t * t
	return ((p1 * 2) + (p2 - p0) * t + (p0 * 2 - p1 * 5 + p2 * 4 - p3) * t2 + (p1 * 3 - p0 - p2 * 3 + p3) * t3) * 0.5
end

-- Samples a road like the game does, with how wide it is at each sample
local function plan(name: string, points: { Vector3 }, features: { any }, width: number, offroad: number)
	local samples, pointToSample = {}, {}
	for i = 1, #points - 1 do
		local p1, p2 = points[i], points[i + 1]
		local p0, p3 = points[i - 1] or (p1 * 2 - p2), points[i + 2] or (p2 * 2 - p1)
		pointToSample[i] = #samples + 1
		local steps = math.max(1, math.ceil((p2 - p1).Magnitude / STEP))
		for s = 0, steps - 1 do
			table.insert(samples, catmullRom(p0, p1, p2, p3, s / steps))
		end
	end
	table.insert(samples, points[#points])
	pointToSample[#points] = #samples
	local dist = { 0 }
	for i = 2, #samples do
		dist[i] = dist[i - 1] + (samples[i] - samples[i - 1]).Magnitude
	end
	local rooms, open = {}, {}
	for _, f in features do
		local from, to = pointToSample[f.from or -1], pointToSample[f.to or -1]
		if from and to then
			if f.kind == "Room" then
				table.insert(rooms, { dist[from], dist[to], (f.width or width) / 2 })
			elseif f.kind == "NoWalls" then
				table.insert(open, { dist[from], dist[to] })
			end
		end
	end
	local edge = {}
	for i, d in dist do
		local half = width / 2
		for _, room in rooms do
			local outside = math.max(room[1] - d, d - room[2], 0)
			if outside < ROOM_EASE then
				local t = 1 - outside / ROOM_EASE
				half += (room[3] - width / 2) * t * t * (3 - 2 * t)
			end
		end
		local isOpen = false
		for _, range in open do
			isOpen = isOpen or (d >= range[1] and d <= range[2])
		end
		edge[i] = half + (if isOpen then 0 else offroad) + 1.5
	end
	return { name = name, samples = samples, dist = dist, edge = edge, total = dist[#dist] }
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function fmt(v: Vector3): string
	return string.format("(%.0f, %.0f, %.0f)", v.X, v.Y, v.Z)
end

return function(id: string): string
	local tracksModule = game.ServerScriptService.RaceServer.Tracks:Clone()
	local TRACKS = require(tracksModule)
	local def
	for _, t in TRACKS do
		if t.id == id then
			def = t
		end
	end
	if not def then
		return "no track called " .. tostring(id)
	end
	local offroad = def.OFFROAD or OFFROAD
	local routes = { plan("main", def.POINTS, def.FEATURES, def.ROAD_WIDTH or ROAD_WIDTH, offroad) }
	for k, b in def.BRANCHES or {} do
		table.insert(routes, plan("branch " .. k .. " (" .. tostring(b.name) .. ")", b.POINTS, b.FEATURES or {}, b.width or BRANCH_WIDTH, offroad))
	end

	local lines = {}
	local minY, maxY = math.huge, -math.huge
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for _, r in routes do
		for _, p in r.samples do
			minY, maxY = math.min(minY, p.Y), math.max(maxY, p.Y)
			minX, maxX, minZ, maxZ = math.min(minX, p.X), math.max(maxX, p.X), math.min(minZ, p.Z), math.max(maxZ, p.Z)
		end
		table.insert(lines, string.format("%s: %.0f studs long", r.name, r.total))
	end
	table.insert(lines, string.format("height %.0f..%.0f, area x %.0f..%.0f, z %.0f..%.0f", minY, maxY, minX, maxX, minZ, maxZ))

	-- Roads crashing into each other
	local problems = 0
	for a = 1, #routes do
		for b = a, #routes do
			local ra, rb = routes[a], routes[b]
			local lastReported = -math.huge
			for i, pa in ra.samples do
				for j, pb in rb.samples do
					if a == b and j <= i then
						continue
					end
					local reach = ra.edge[i] + rb.edge[j] + 3
					if a == b and math.abs(ra.dist[i] - rb.dist[j]) < reach * 2.5 then
						continue -- just the next bit of the same road
					end
					if b > 1 and a == 1 and (rb.dist[j] < 150 or rb.dist[j] > rb.total - 150) then
						continue -- where a branch joins the main road
					end
					if math.abs(pa.Y - pb.Y) < 20 and (flat(pa) - flat(pb)).Magnitude < reach and ra.dist[i] - lastReported > 60 then
						lastReported = ra.dist[i]
						problems += 1
						if problems <= 15 then
							table.insert(lines, string.format("CRASH: %s %s (at %.0f studs) and %s %s (at %.0f) are %.0f apart and %.0f studs apart in height", ra.name, fmt(pa), ra.dist[i], rb.name, fmt(pb), rb.dist[j], (flat(pa) - flat(pb)).Magnitude, math.abs(pa.Y - pb.Y)))
						end
					end
				end
			end
		end
	end

	-- Corners too tight for the road's width, and the lobby
	for _, r in routes do
		local lastReported = -math.huge
		for i = 4, #r.samples - 3 do
			local a, b, c = flat(r.samples[i - 3]), flat(r.samples[i]), flat(r.samples[i + 3])
			local ab, bc, ca = (b - a).Magnitude, (c - b).Magnitude, (a - c).Magnitude
			local area2 = math.abs((b - a):Cross(c - a).Y)
			local radius = if area2 > 1e-3 then ab * bc * ca / (2 * area2) else math.huge
			if radius < r.edge[i] * 1.1 and r.dist[i] - lastReported > 60 then
				lastReported = r.dist[i]
				problems += 1
				table.insert(lines, string.format("TIGHT: %s corner at %s (%.0f studs) turns in a %.0f-stud circle; it needs at least %.0f", r.name, fmt(r.samples[i]), r.dist[i], radius, r.edge[i] * 1.1))
			end
		end
		for i, p in r.samples do
			if math.abs(p.Y - LOBBY.Y) < 60 and (flat(p) - LOBBY).Magnitude < 60 + r.edge[i] then
				problems += 1
				table.insert(lines, "LOBBY: " .. r.name .. " passes too close to the lobby at " .. fmt(p))
				break
			end
		end
	end
	table.insert(lines, if problems == 0 then "No problems found." else problems .. " problem(s).")
	return table.concat(lines, "\n")
end
]]></ProtectedString>
