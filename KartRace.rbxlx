-- Shows the RACE button, or the banner for the race someone has started
local function updateRaceMenu(phase: any, racing: boolean)
	local pick = raceState:GetAttribute("LobbyMode") == "Pick"
	local info = trackInfo(raceState:GetAttribute("NextTrack"))
	raceButton.Visible = pick and not racing and info == nil
	if not raceButton.Visible then
		trackMenu.Visible = false
	end
	joinBanner.Visible = pick and not racing and info ~= nil
	if not info or not joinBanner.Visible then
		return
	end
	local color = trackColor(info)
	joinTitle.Text = string.upper(tostring(info:GetAttribute("DisplayName")))
	joinTitle.TextColor3 = color
	joinStroke.Color = color
	local when = if phase == "Joining" then string.format("starts in %d", numberAttr(raceState, "Countdown")) else "starts after this race"
	joinInfo.Text = string.format("%s's race %s  •  %d joined", tostring(raceState:GetAttribute("Host")), when, numberAttr(raceState, "JoinedCount"))
	local joined = player:GetAttribute("Joined") == true
	joinButton.Text = if joined then "LEAVE" else "JOIN"
	joinButton.BackgroundColor3 = if joined then Color3.fromRGB(150, 150, 170) else GO_COLOR
end

------------------------------------------------------------------------
-- WEATHER  (falling snow or floating embers around you, on tracks that have it)
------------------------------------------------------------------------
local weatherKind: any = nil
local weatherPart: BasePart? = nil

local function updateWeather()
	local track = workspace:FindFirstChild("RaceTrack")
	local kind = if track then track:GetAttribute("Weather") else nil
	if kind ~= weatherKind then
		weatherKind = kind
		if weatherPart then
			weatherPart:Destroy()
			weatherPart = nil
		end
		if kind == "Snow" or kind == "Embers" or kind == "Fireflies" then
			local snow = kind == "Snow"
			local flies = kind == "Fireflies" -- little glowing dots drifting around in the jungle
			local part = make("Part", {
				Name = "Weather",
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				Transparency = 1,
				Size = if flies then Vector3.new(140, 40, 140) else Vector3.new(160, 1, 160),
			})
			make("ParticleEmitter", {
				Color = if snow then ColorSequence.new(WHITE) elseif flies then ColorSequence.new(Color3.fromRGB(210, 255, 120)) else ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 80, 20)),
				LightEmission = if snow then 0.3 else 1,
				Size = if snow then NumberSequence.new(0.45) elseif flies then NumberSequence.new(0.3) else NumberSequence.new(0.4, 0),
				Lifetime = if snow then NumberRange.new(5, 7) else NumberRange.new(3, 5),
				Rate = if snow then 150 elseif flies then 40 else 60,
				Speed = if snow then NumberRange.new(10, 15) elseif flies then NumberRange.new(0.5, 2) else NumberRange.new(4, 10),
				SpreadAngle = if flies then Vector2.new(180, 180) else Vector2.new(20, 20),
				Acceleration = if snow then Vector3.new(3, 0, 2) elseif flies then Vector3.zero else Vector3.new(0, 3, 0),
				EmissionDirection = if snow then Enum.NormalId.Bottom else Enum.NormalId.Top,
				RotSpeed = NumberRange.new(-90, 90),
			}, part)
			part.Parent = workspace.CurrentCamera -- only you see it, and it follows your camera
			weatherPart = part
		end
	end
	if weatherPart then
		local height = if weatherKind == "Snow" then 35 elseif weatherKind == "Fireflies" then 0 else -25
		weatherPart.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position + Vector3.new(0, height, 0))
	end
end

------------------------------------------------------------------------
-- HUD UPDATE (every frame)
------------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
	local phase = raceState:GetAttribute("Phase")
	local racing = player:GetAttribute("Racing") == true
	local finished = player:GetAttribute("Finished") == true
	local now = workspace:GetServerTimeNow()

	if phase == "Waiting" then
		statusLabel.Text = if raceState:GetAttribute("LobbyMode") == "Pick" then "Press RACE to start a race!" else "Waiting for players..."
	elseif phase == "Joining" then
		statusLabel.Text = string.format("Race starting in %d!", numberAttr(raceState, "Countdown"))
	elseif phase == "Intermission" then
		statusLabel.Text = string.format("Next race in %d — vote for a track!", numberAttr(raceState, "Countdown"))
	elseif phase == "Reveal" then
		statusLabel.Text = "Next track: " .. tostring(raceState:GetAttribute("TrackName") or "?")
	elseif phase == "Countdown" then
		statusLabel.Text = if racing then "Get ready!" else "A race is starting!"
	elseif phase == "Racing" then
		local left = formatClock(numberAttr(raceState, "RaceEnd") - now)
		if racing and finished then
			statusLabel.Text = "Finished! Heading back to the lobby..."
		elseif racing then
			statusLabel.Text = "Time left: " .. left
		else
			statusLabel.Text = "Race in progress (" .. left .. " left)"
		end
	elseif phase == "Results" then
		statusLabel.Text = "Race over!"
	else
		statusLabel.Text = ""
	end

	local showRaceHud = racing and (phase == "Countdown" or phase == "Racing" or phase == "Results")
	timerLabel.Visible = showRaceHud
	placeLabel.Visible = showRaceHud
	placeSubLabel.Visible = showRaceHud
	if showRaceHud then
		if myFinishTime then
			timerLabel.Text = formatTime(myFinishTime)
		elseif phase == "Racing" then
			timerLabel.Text = formatTime(now - numberAttr(raceState, "RaceStart"))
		elseif phase == "Countdown" then
			timerLabel.Text = formatTime(0)
		end
		local place = numberAttr(player, "Place")
		if place > 0 then
			placeLabel.Text = ordinal(place)
			placeLabel.TextColor3 = PLACE_COLORS[place] or WHITE
		end
		placeSubLabel.Text = "of " .. numberAttr(raceState, "RacerCount")
		local coins = shownCoins()
		coinLabel.Text = coins .. " / " .. HANDLING.MAX_COINS
		coinLabel.TextColor3 = if os.clock() < coinFlashUntil then LOST_COLOR elseif coins >= HANDLING.MAX_COINS then COIN_COLOR else WHITE
	end
	coinFrame.Visible = showRaceHud
	local itemId = player:GetAttribute("Item")
	local itemLook = if showRaceHud and typeof(itemId) == "string" then ITEM_LOOKS[itemId] else nil
	itemFrame.Visible = itemLook ~= nil
	if itemLook then
		itemName.Text = itemLook.text
		itemName.TextColor3 = itemLook.color
		itemStroke.Color = itemLook.color
		itemKey.Text = if itemPending then "..." elseif touchOnly() then "Tap ITEM" elseif gamepadOnly() then "Press X" else "Press E"
	end

	updateVote(phase, racing)
	updateRaceMenu(phase, racing)
	updateWeather()
end)

------------------------------------------------------------------------
-- COINS AND ITEM BOXES spin on the spot, burst when someone grabs one, and
-- pop back in when they return (all done here, so it's smooth). The server
-- decides who grabs what: it takes a grabbed one out of the Pickups folder
-- and puts it back later. That news takes a moment to arrive, so when YOU
-- drive through one, this screen shows it straight away instead.
------------------------------------------------------------------------
local BOX_TILT = CFrame.Angles(math.rad(25), 0, math.rad(25))
local POP_TIME = 0.35 -- seconds to grow back in
local pickupFolder: Instance? = nil
local popping: { [Instance]: number } = {} -- growing back in, and since when
local fullSize: { [string]: Vector3 } = {} -- a coin's / box's normal size
local lastSweepPos: Vector3? = nil -- where your kart was last frame

-- Hides or shows a pickup on this screen only
local function showPickup(part: BasePart, visible: boolean)
	part.LocalTransparencyModifier = if visible then 0 else 1
	for _, gui in part:GetChildren() do
		if gui:IsA("SurfaceGui") then
			gui.Enabled = visible
		end
	end
end

-- Other racers' item boxes break with a sound at most this often (a whole
-- pack hitting a row of boxes at once was deafening). Yours always play.
local OTHERS_BOX_SOUND_GAP = 0.2
local lastOthersBoxSound = 0

-- It got grabbed: a copy flies up and shrinks (coin) or bursts outwards
-- (box), fading away in a puff of sparkles. `mine` = you grabbed it (the
-- sound plays in your ears); otherwise the sound comes from that spot.
local function burst(part: BasePart, mine: boolean)
	local size = fullSize[part.Name] or part.Size
	popping[part] = nil
	local coin = part.Name == "Coin"
	local copy = part:Clone()
	copy:ClearAllChildren() -- (no "?" on the copy)
	copy.Size = size
	copy.LocalTransparencyModifier = 0
	copy.Parent = workspace
	if coin then
		playSound("Coin", if mine then nil else copy, if mine then 1 + shownCoins() * 0.015 else 1)
	elseif mine then
		playSound("BoxBreak", nil, 1.1)
	elseif os.clock() - lastOthersBoxSound >= OTHERS_BOX_SOUND_GAP then
		lastOthersBoxSound = os.clock()
		playSound("BoxBreak", copy, 1.1)
	end
	make("ParticleEmitter", {
		Color = ColorSequence.new(part.Color),
		LightEmission = 1,
		Size = NumberSequence.new(0.6, 0),
		Lifetime = NumberRange.new(0.3, 0.6),
		Speed = NumberRange.new(10, 22),
		SpreadAngle = Vector2.new(180, 180),
		Rate = 0,
	}, copy):Emit(if coin then 10 else 20)
	local goal = if coin
		then { CFrame = copy.CFrame * CFrame.new(0, 7, 0) * CFrame.Angles(0, math.pi * 3, 0), Size = size * 0.3, Transparency = 1 }
		else { Size = size * 1.9, Transparency = 1 }
	TweenService:Create(copy, TweenInfo.new(if coin then 0.35 else 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
	task.delay(2.5, function() -- (long enough for its sound to finish)
		copy:Destroy()
	end)
end

-- The server took one out of the folder: someone grabbed it
local function onRemoved(part: Instance)
	local folder = pickupFolder
	if not part:IsA("BasePart") or not folder or not folder:IsDescendantOf(workspace) then
		return -- (the whole track is going away, not one pickup)
	end
	if predicted[part] then -- you did, and this screen already showed it
		predicted[part] = nil
		showPickup(part, true) -- (ready for when it comes back)
	else
		burst(part, false)
	end
end

-- It's back: grow it in from nothing
local function popIn(part: Instance)
	if part:IsA("BasePart") then
		predicted[part] = nil
		showPickup(part, true)
		fullSize[part.Name] = fullSize[part.Name] or part.Size
		popping[part] = os.clock()
		part.Size = fullSize[part.Name] * 0.05
	end
end

RunService.RenderStepped:Connect(function()
	local track = workspace:FindFirstChild("RaceTrack")
	local folder = if track then track:FindFirstChild("Pickups") else nil
	if folder ~= pickupFolder then -- a new track
		pickupFolder = folder
		table.clear(popping)
		table.clear(predicted)
		if folder then
			folder.ChildRemoved:Connect(onRemoved)
			folder.ChildAdded:Connect(popIn)
		end
	end
	if not folder then
		return
	end
	local now = os.clock()
	local spin = CFrame.Angles(0, (now * 2.5) % (math.pi * 2), 0)

	-- The path your kart took since last frame (nil when you're not racing)
	local d = drive
	local racing = d ~= nil and not d.hitbox.Anchored and raceState:GetAttribute("Phase") == "Racing" and player:GetAttribute("Finished") ~= true
	local pos = if d and racing then d.hitbox.Position else nil
	local last = lastSweepPos
	lastSweepPos = pos
	local path = if pos and last and (pos - last).Magnitude < 40 then pos - last else nil
	local lengthSq = if path then math.max(path:Dot(path), 1e-6) else 1

	for _, part in folder:GetChildren() do
		if part:IsA("BasePart") then
			if path and last and not predicted[part] then -- drove through it just now?
				local rel = part.Position - last
				local t = math.clamp(rel:Dot(path) / lengthSq, 0, 1)
				if (rel - path * t).Magnitude < HANDLING.PICKUP_REACH then
					predicted[part] = now
					showPickup(part, false)
					burst(part, true)
				end
			end
			local started = popping[part]
			if started then -- ease out with a little bounce past full size
				local t = math.min((now - started) / POP_TIME, 1)
				local grow = 1 + 2.70158 * (t - 1) ^ 3 + 1.70158 * (t - 1) ^ 2
				part.Size = fullSize[part.Name] * math.max(grow, 0.05)
				if t >= 1 then
					popping[part] = nil
				end
			else
				fullSize[part.Name] = fullSize[part.Name] or part.Size
			end
			part.CFrame = CFrame.new(part.Position) * spin * (if part.Name == "ItemBox" then BOX_TILT else CFrame.identity)
		end
	end
	-- The server never took it after all (it saw you just miss): bring it back
	for part, at in predicted do
		if now - at > 1.5 then
			predicted[part] = nil
			if part.Parent and part:IsA("BasePart") then
				popIn(part)
			end
		end
	end
end)

------------------------------------------------------------------------
-- WRONG WAY warning. Every checkpoint and respawn gate faces the way the
-- race goes (on every route, shortcuts too), so if you keep driving against
-- the nearest one, you've got turned round.
------------------------------------------------------------------------
local wrongFor = 0 -- seconds you've been driving the wrong way
RunService.Heartbeat:Connect(function(dt)
	local d = drive
	local wrong = false
	if d and d.track and not d.hitbox.Anchored and raceState:GetAttribute("Phase") == "Racing" and player:GetAttribute("Finished") ~= true then
		local pos = d.hitbox.Position
		local v = d.hitbox.AssemblyLinearVelocity
		local moving = Vector3.new(v.X, 0, v.Z)
		-- the nearest gate (height counts extra, so roads above and below aren't mixed up)
		local nearest, bestScore = nil, 80 * 80
		for _, name in { "Checkpoints", "RespawnPoints" } do
			local folder = d.track:FindFirstChild(name)
			for _, gate in if folder then folder:GetChildren() else {} do
				local o = (gate :: BasePart).Position - pos
				local score = o.X * o.X + (o.Y * 3) ^ 2 + o.Z * o.Z
				if score < bestScore then
					nearest, bestScore = gate :: BasePart, score
				end
			end
		end
		if nearest and moving.Magnitude > 15 then
			local ahead = nearest.CFrame.LookVector
			wrong = moving.Unit:Dot(Vector3.new(ahead.X, 0, ahead.Z).Unit) < -0.3
		end
	end
	wrongFor = if wrong then wrongFor + dt else 0
	wrongWayLabel.Visible = wrongFor > 1 and os.clock() % 0.6 < 0.4 -- (blinks)
end)

------------------------------------------------------------------------
-- ENGINE SOUNDS on every kart (yours and everyone else's). The faster a
-- kart goes, the higher its engine sounds.
------------------------------------------------------------------------
local engines: { [Instance]: Sound } = {}

local function addEngine(kart: Instance)
	if not kart:IsA("Model") then
		return
	end
	local hitbox = kart.PrimaryPart or kart:WaitForChild("Hitbox", 5)
	if hitbox and kart.Parent then
		engines[kart] = loopSound("Engine", hitbox, true)
	end
end

task.spawn(function()
	local karts = workspace:WaitForChild("Karts")
	karts.ChildAdded:Connect(addEngine)
	karts.ChildRemoved:Connect(function(kart)
		engines[kart] = nil -- the sound was inside the kart, so it's gone with it
	end)
	for _, kart in karts:GetChildren() do
		task.spawn(addEngine, kart)
	end
end)

RunService.Heartbeat:Connect(function()
	for kart, sound in engines do
		local hitbox = (kart :: Model).PrimaryPart
		if hitbox then
			local speed = hitbox.AssemblyLinearVelocity.Magnitude
			sound.PlaybackSpeed = 0.75 + math.min(speed / HANDLING.MAX_SPEED, 1.4) * 0.55
			local mine = drive ~= nil and drive.kart == kart
			-- Quiet when idling (a dozen engines on the grid add up fast), and
			-- other karts' engines fade out quicker with distance than yours
			local revs = 0.35 + 0.65 * math.min(speed / HANDLING.MAX_SPEED, 1)
			sound.Volume = soundTemplates.Engine.Volume * revs * (if mine then 1 else 0.45)
			sound.RollOffMinDistance = if mine then 15 else 6
		end
	end
end)

------------------------------------------------------------------------
-- FOOTSTEPS while walking around the lobby, matching the ground (soft on
-- grass, harder on stone). They replace Roblox's built-in footstep sound.
------------------------------------------------------------------------
local stepTimer = 0

RunService.Heartbeat:Connect(function(dt)
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if not humanoid or not root or humanoid.SeatPart or humanoid.FloorMaterial == Enum.Material.Air or humanoid.MoveDirection.Magnitude < 0.1 then
		stepTimer = 0
		return
	end
	stepTimer -= dt
	if stepTimer <= 0 then
		stepTimer = 5 / math.max(humanoid.WalkSpeed, 1) -- about three steps a second at walking speed
		playSound(if GRASSY[humanoid.FloorMaterial] then "StepGrass" else "StepStone", root, 0.85 + math.random() * 0.3)
	end
end)

-- Turn off Roblox's own footstep sound on your character, so you don't hear both
local function muteDefaultFootsteps(character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local running = if root then root:WaitForChild("Running", 10) else nil
	if running and running:IsA("Sound") then
		running.Volume = 0
	end
end
player.CharacterAdded:Connect(muteDefaultFootsteps)
if player.Character then
	task.spawn(muteDefaultFootsteps, player.Character)
end

------------------------------------------------------------------------
-- LOBBY (bounce pads, spinning display karts)
------------------------------------------------------------------------
local lastBounce = 0
local function hookBouncePad(pad: BasePart)
	pad.Touched:Connect(function(hit)
		local character = player.Character
		if not character or not hit:IsDescendantOf(character) or os.clock() - lastBounce < 0.5 then
			return
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local root = character:FindFirstChild("HumanoidRootPart")
		local power = pad:GetAttribute("BouncePower")
		if not humanoid or humanoid.SeatPart or not root or not root:IsA("BasePart") or typeof(power) ~= "number" then
			return
		end
		lastBounce = os.clock()
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
	end)
end

task.spawn(function()
	local lobby = workspace:WaitForChild("RaceLobby", 30)
	if not lobby then
		return
	end
	local spinners: { Model } = {}
	for _, item in lobby:GetDescendants() do
		if item:IsA("Model") and typeof(item:GetAttribute("Spin")) == "number" then
			table.insert(spinners, item)
		elseif item:IsA("BasePart") and item:GetAttribute("BouncePower") then
			hookBouncePad(item)
		end
	end
	-- Spinning them here (not on the server) keeps the motion perfectly smooth
	RunService.RenderStepped:Connect(function(dt)
		for _, model in spinners do
			local speed = model:GetAttribute("Spin")
			if model.Parent and typeof(speed) == "number" then
				model:PivotTo(model:GetPivot() * CFrame.Angles(0, math.rad(speed) * dt, 0))
			end
		end
	end)
end)
]]></ProtectedString>
