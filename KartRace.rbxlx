				<Properties>
					<ProtectedString name="Source"><![CDATA[--[[
	RaceServer  —  a normal Script that goes in ServerScriptService

	Kart racing MVP, server side. This script:
	  • builds the lobby, plus whichever race track won the vote (with its scenery), out of parts
	  • runs the game loop: lobby + track vote -> race -> back to lobby -> repeat
	  • tracks checkpoints, live race positions, finish times and respawns
	  • keeps a global "most 1st places" leaderboard saved with DataStores

	It pairs with the RaceClient LocalScript (StarterPlayer > StarterPlayerScripts),
	which handles driving, the camera and the on-screen UI.

	Want to decorate the lobby by hand? Press Play, copy Workspace.RaceLobby, press
	Stop, and paste it into Workspace. When that folder already exists, this script
	uses it instead of generating a new one. Tracks are rebuilt every time a
	different one wins the vote, so change those in the TRACKS table below.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")
local DataStoreService = game:GetService("DataStoreService")
local Lighting = game:GetService("Lighting")

------------------------------------------------------------------------
-- SETTINGS  (safe to tweak)
------------------------------------------------------------------------
local SETTINGS = {
	INTERMISSION_TIME = 15, -- seconds in the lobby before each race (players vote for the next track meanwhile)
	VOTE_CHOICES = 3, -- how many randomly picked tracks players can vote between
	TRACK_REVEAL_TIME = 3, -- seconds the winning track is announced before racers are put on it
	COUNTDOWN_TIME = 3, -- 3, 2, 1, GO!
	RACE_TIME_LIMIT = 120, -- hard limit on race length, in seconds
	TIME_AFTER_FIRST_FINISH = 30, -- once 1st place finishes, everyone else gets this long
	RETURN_DELAY = 4, -- seconds a finisher stays on the track before going back to the lobby
	MIN_PLAYERS_TO_START = 1, -- 1 lets you race alone (handy for testing)
	MIN_RACERS_FOR_WIN = 2, -- a 1st place only counts on the leaderboard with at least this many racers
	MAX_RACERS = 12, -- size of the starting grid; extra players wait for the next race
	RESPAWN_COOLDOWN = 1.5, -- seconds between manual respawns
	LEADERBOARD_SIZE = 10,
	LEADERBOARD_REFRESH = 60, -- seconds between leaderboard refreshes
	DATASTORE_NAME = "GlobalWins_v1", -- rename to start a fresh leaderboard
}

------------------------------------------------------------------------
-- TRACK  —  building settings shared by every track. A track in TRACKS
-- (below) can change any of these just for itself by setting the same
-- name inside it, e.g. ROAD_WIDTH = 50.
------------------------------------------------------------------------
local TRACK = {
	ORIGIN = Vector3.new(-800, 120, 0), -- where point (0, 0, 0) sits in the world (right next to the lobby)
	ROAD_WIDTH = 46, -- room for a dozen karts to race (about eight side by side)
	BRANCH_WIDTH = 30, -- side routes (BRANCHES) can be narrower: only part of the pack takes them
	WALL_HEIGHT = 4,
	WALL_THICKNESS = 1.5,
	STEP = 10, -- length of each road piece (smaller = smoother but more parts)
	PRE_START = 80, -- road behind the start line (room for the starting grid)
	RUN_OFF = 70, -- road after the finish line
	CHECKPOINT_SPACING = 100, -- gates racers must pass in order (only on road every route shares)
	RESPAWN_SPACING = 60, -- spots you can be put back at after a fall (on every route, branches too)
	MAX_BANK = 12, -- degrees the road leans into corners, like a real race track (0 = flat). Wide rooms stay flat.
	BANK_RADIUS = 100, -- corners this tight (or tighter) get the full lean
	ROOM_EASE = 60, -- studs over which the road flares out into a Room (and narrows back again)
	RAMP_ANGLE = 16, -- how steep a jump ramp is at its lip, in degrees (a Ramp can set its own `angle`)
	RAMP_LENGTH = 26, -- (a Ramp can set its own `length`)
	JUMP_RUNWAY = 120, -- respawn points stay at least this far before a gap jump, so there's room to speed up again
	HAZARD_CLEARANCE = 25, -- ...and at least this far from lava, fire bars, rocks and other hazards
	ICE_GRIP = 0.3, -- how grippy "Ice" road is (1 = normal road, lower = slidier). An Ice section can set its own `grip`
	BUMPING = 0, -- how hard karts shove each other when they touch (0 = karts drive through each other)
	ARCH_SPACING = 260, -- gap between the glowing arches over the road (0 = no arches)
	SCENERY_SEED = 7, -- change this number to shuffle the scenery around
	FALL_DEPTH = 40, -- drop this far below the lowest bit of road and you're put back at your last checkpoint
}

------------------------------------------------------------------------
-- TRACKS  —  every track players can vote for. Each one should feel like a
-- level in a video game (a string of themed areas with their own hazards and
-- route choices), not a race circuit. See "Track design" in CLAUDE.md.
--
-- POINTS: the main road is a smooth curve through these, in order. X/Z move
-- it around the map, Y makes hills. Keep neighbouring points roughly 100-150
-- apart. Every track starts at (0, 0, -80) heading the same way, so its
-- start line is next to the lobby. Everyone finishes at the end of it.
--
-- BRANCHES: side routes that split off the main road and join it again
-- (a risky shortcut, a cave...). A branch has its own POINTS, optional
-- `width` and its own FEATURES (their `point` numbers count along the branch).
-- Its first and last points must sit inside a main-road Room, on flat road at
-- the same height, so there's space for the junction. Walls open up by
-- themselves where the roads meet.
--
-- FEATURES are things placed on a road. Single spots use `point` (which POINT),
-- `ahead` (studs further along the road from that point; negative = before it)
-- and `lane` (sideways from the middle of the road; negative = left):
--   "Boost"     speed pad
--   "Ramp"      jump. Optional `angle` and `length`, plus `gap` = studs of
--               missing road after the lip. Too slow and you fall off the map!
--   "Banner"    arch over the road with `text` on it (name each area!)
--   "Sign"      signpost with `text`; put its `lane` just outside the road edge
--   "Rock" / "Crystal" / "Snowman"   solid obstacle to steer around. `size`
--   "LavaPool"  touch it and you're back at your last checkpoint. `radius`
--   "Geyser"    lava vent that erupts every few seconds and throws karts in
--               the air. `radius`, `height`, `period` (seconds per cycle),
--               `active` (seconds it erupts), `offset` (shifts its timing)
--   "FireBar"   spinning bar of fireballs that knocks karts aside.
--               `length`, `speed` (degrees per second, negative = other way)
--   "Snowball"  giant snowball rolling from side to side across the road.
--               `radius`, `period`, `offset`, optional `span` (how far it rolls)
-- Sections of road use `from` and `to` points instead:
--   "Room"      the road opens out to `width`: an arena, plaza or cavern
--   "NoWalls"   no barriers, so you can drive (or get pushed) off the edge
--   "Ice"       slippery road. Optional `grip` (default ICE_GRIP)
--   "Tunnel"    a cave over the road
--   "Wind"      gusts that blow karts sideways. `push` (+ = to the right),
--               `period`, `active`, `offset`
------------------------------------------------------------------------
