make("UIPadding", { PaddingTop = UDim.new(0, 3), PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 6) }, trackList)
for _, info in raceState:WaitForChild("Tracks"):GetChildren() do
