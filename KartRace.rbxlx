	Color3.fromRGB(95, 195, 80),
	Color3.fromRGB(60, 150, 90),
	Color3.fromRGB(255, 160, 200), -- blossom
}

local KART_COLORS = {
	Color3.fromRGB(230, 60, 60),
	Color3.fromRGB(60, 130, 240),
	Color3.fromRGB(70, 200, 90),
	Color3.fromRGB(250, 200, 40),
