	WallStripe = Color3.fromRGB(245, 245, 245),
	Pillar = Color3.fromRGB(150, 150, 160),
	Boost = Color3.fromRGB(255, 120, 20),
	BoostArrow = Color3.fromRGB(255, 235, 90),
