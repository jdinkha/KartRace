			<Item class="LocalScript" referent="RBX933044E38D19480A88A502805F15B6FD">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--[[
	GarageClient  —  a LocalScript in StarterPlayer > StarterPlayerScripts

	The GARAGE button (left side, whenever you're not racing) opens a menu where
	you pick who you drive as (your own avatar or one of the characters), your
	kart and your wheels. Every card shows a 3D preview, and the big one at the
	top shows your combo turning round. A pick is sent to the server ("Equip" on
	RaceEvent), which checks it, saves it and uses it from your next race. The
	karts and wheels are listed in the Garage module, the characters in the
	Mascots module (both in ReplicatedStorage).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContentProvider = game:GetService("ContentProvider")

local Garage = require(ReplicatedStorage:WaitForChild("Garage"))
local Mascots = require(ReplicatedStorage:WaitForChild("Mascots"))
-- Load the karts' meshes first: a ViewportFrame never shows a mesh that
-- finished loading after it was put in.
ContentProvider:PreloadAsync({ ReplicatedStorage:WaitForChild("Garage") })
local raceEvent = ReplicatedStorage:WaitForChild("RaceEvent") :: RemoteEvent
local player = Players.LocalPlayer

local PREVIEW_COLOR = Color3.fromRGB(230, 60, 60) -- (your colour in a race depends on your grid spot)
local PICKED = Color3.fromRGB(255, 215, 70)
local PANEL = Color3.fromRGB(20, 20, 32)
local CARD = Color3.fromRGB(42, 42, 60)
local WHITE = Color3.new(1, 1, 1)
local FONT = Enum.Font.FredokaOne
local SPIN_SPEED = 0.6 -- how fast the big preview turns (radians per second)
-- Where the cameras look from (front of a kart is -Z, wheels' axles are along X)
local KART_VIEW = Vector3.new(0.8, 0.55, -1)
local WHEEL_VIEW = Vector3.new(1, 0.3, -0.45)
local CHARACTER_VIEW = Vector3.new(0.45, 0.25, -1) -- (characters face -Z too)

local function make(className: string, props: { [string]: any }, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in props do
		(instance :: any)[key] = value
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local function textLabel(props: { [string]: any }, parent: Instance): TextLabel
	local defaults = { BackgroundTransparency = 1, Font = FONT, TextColor3 = WHITE, TextScaled = true, Text = "" }
	for key, value in props do
		defaults[key] = value
	end
	return make("TextLabel", defaults, parent)
end

local function viewport(props: { [string]: any }, parent: Instance): ViewportFrame
	local defaults = {
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(150, 150, 165),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-1, -2, 1),
	}
	for key, value in props do
		defaults[key] = value
	end
	return make("ViewportFrame", defaults, parent)
end

-- Puts `model` in the viewport (replacing what was there) with a camera that fits it
local function show(view: ViewportFrame, model: Model, from: Vector3)
	for _, child in view:GetChildren() do
		if child:IsA("Model") or child:IsA("Camera") then
			child:Destroy()
		end
	end
	local camera = make("Camera", { FieldOfView = 30 }, view)
	view.CurrentCamera = camera
	model.Parent = view
	local box, size = model:GetBoundingBox()
	local centre = Vector3.new(0, box.Position.Y, 0) -- (round the pivot, so spinning stays in frame)
	local distance = size.Magnitude / 2 / math.sin(math.rad(camera.FieldOfView / 2)) * 0.8
	camera.CFrame = CFrame.lookAt(centre + from.Unit * distance, centre)
end

------------------------------------------------------------------------
-- The menu
------------------------------------------------------------------------
local gui = make("ScreenGui", {
	Name = "Garage",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 5, -- above the race HUD
}, player:WaitForChild("PlayerGui"))

local openButton = make("TextButton", {
	Name = "Open",
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 16, 0.5, 0),
	Size = UDim2.fromOffset(130, 46),
	BackgroundColor3 = PANEL,
	BackgroundTransparency = 0.12,
	Font = FONT,
	Text = "GARAGE",
	TextColor3 = PICKED,
	TextSize = 26,
}, gui) :: TextButton
make("UICorner", { CornerRadius = UDim.new(0, 12) }, openButton)
make("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = PICKED, Thickness = 2 }, openButton)

local panel = make("Frame", {
	Name = "Panel",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromScale(0.92, 0.88),
	BackgroundColor3 = PANEL,
	BackgroundTransparency = 0.06,
	Visible = false,
}, gui) :: Frame
make("UISizeConstraint", { MaxSize = Vector2.new(720, 760) }, panel)
make("UICorner", { CornerRadius = UDim.new(0, 14) }, panel)
make("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12), PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }, panel)

textLabel({ Text = "GARAGE", Size = UDim2.fromScale(0.5, 0.07), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = PICKED }, panel)
local closeButton = make("TextButton", {
	Name = "Close",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.fromScale(1, 0),
	Size = UDim2.fromOffset(36, 36),
	BackgroundColor3 = CARD,
	Font = FONT,
	Text = "X",
	TextColor3 = WHITE,
	TextSize = 22,
}, panel) :: TextButton
make("UICorner", { CornerRadius = UDim.new(0, 10) }, closeButton)

local preview = viewport({
	Name = "Preview",
	Position = UDim2.fromScale(0, 0.09),
	Size = UDim2.fromScale(1, 0.26),
	BackgroundColor3 = Color3.fromRGB(34, 34, 50),
	BackgroundTransparency = 0,
}, panel)
make("UICorner", { CornerRadius = UDim.new(0, 12) }, preview)
local comboLabel = textLabel({ Position = UDim2.fromScale(0, 0.355), Size = UDim2.fromScale(1, 0.05) }, panel)
textLabel({
	Text = "You'll drive it from your next race",
	Position = UDim2.fromScale(0, 0.405),
	Size = UDim2.fromScale(1, 0.035),
	TextColor3 = Color3.fromRGB(180, 180, 200),
}, panel)

-- A titled row of cards you can scroll sideways
local function row(title: string, y: number): ScrollingFrame
	textLabel({
		Text = title,
		Position = UDim2.fromScale(0, y),
		Size = UDim2.fromScale(1, 0.04),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(205, 205, 220),
	}, panel)
	local list = make("ScrollingFrame", {
		Name = title,
		Position = UDim2.fromScale(0, y + 0.045),
		Size = UDim2.fromScale(1, 0.135),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 4,
	}, panel) :: ScrollingFrame
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	make("UIPadding", { PaddingLeft = UDim.new(0, 3), PaddingTop = UDim.new(0, 3) }, list)
	return list
end

type Card = { view: ViewportFrame, stroke: UIStroke }
local function card(list: ScrollingFrame, name: string, order: number, onPick: () -> ()): Card
	local button = make("TextButton", {
		Name = name,
		Size = UDim2.new(0, 100, 0.9, 0),
		BackgroundColor3 = CARD,
		Text = "",
		LayoutOrder = order,
	}, list) :: TextButton
	make("UIAspectRatioConstraint", { AspectRatio = 1.2, DominantAxis = Enum.DominantAxis.Height }, button)
	make("UICorner", { CornerRadius = UDim.new(0, 10) }, button)
	local stroke = make("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = 3, Color = CARD }, button)
	local view = viewport({ Size = UDim2.fromScale(1, 0.74) }, button)
	textLabel({ Text = name, Position = UDim2.fromScale(0.05, 0.74), Size = UDim2.fromScale(0.9, 0.22) }, button)
	button.Activated:Connect(onPick)
	return { view = view, stroke = stroke }
end

-- Characters: your own avatar (its headshot) or one of the Mascots, A to Z
local characterCards: { [string]: Card } = {}
local characterList = row("CHARACTER", 0.445)
local avatarCard = card(characterList, "My Avatar", 0, function()
	raceEvent:FireServer("Equip", "Character", "Avatar")
end)
characterCards.Avatar = avatarCard
task.spawn(function()
	local ok, image = pcall(Players.GetUserThumbnailAsync, Players, player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
	if ok then
		make("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Image = image, ScaleType = Enum.ScaleType.Fit }, avatarCard.view)
	end
end)
local function characterName(kind: string): string
	return Mascots.KINDS[kind].name or kind
end
local kinds = {}
for kind in Mascots.KINDS do
	table.insert(kinds, kind)
end
table.sort(kinds, function(a, b)
	return characterName(a) < characterName(b)
end)
for order, kind in kinds do
	local c = card(characterList, characterName(kind), order, function()
		raceEvent:FireServer("Equip", "Character", kind)
	end)
	characterCards[kind] = c
	show(c.view, Mascots.build(kind, CFrame.identity, {} :: any), CHARACTER_VIEW)
end

local kartCards: { [string]: Card } = {}
local kartList = row("KARTS", 0.63)
for order, kart in Garage.KARTS do
	kartCards[kart.id] = card(kartList, kart.name, order, function()
		raceEvent:FireServer("Equip", "Kart", kart.id)
	end)
end

local wheelCards: { [string]: Card } = {}
local wheelList = row("WHEELS", 0.815)
for order, wheels in Garage.WHEELS do
	local c = card(wheelList, wheels.name, order, function()
		raceEvent:FireServer("Equip", "Wheels", wheels.id)
	end)
	wheelCards[wheels.id] = c
	-- wheel cards show a single wheel close up
	local wheel = (ReplicatedStorage.Garage.Wheels :: Folder)[wheels.id]:Clone() :: Model
	for _, part in wheel:GetChildren() do
		if part:IsA("BasePart") and part:GetAttribute("Paint") then
			part.Color = PREVIEW_COLOR
		end
	end
	show(c.view, wheel, WHEEL_VIEW)
end

local previewModel: Model? = nil

-- Redraws the previews and highlights for the current pick.
-- ponytail: rebuilds every kart card each time; fine for a handful of karts, reuse models if the list gets long
local function refresh()
	local kartId, wheelsId = player:GetAttribute("Kart"), player:GetAttribute("Wheels")
	for id, c in kartCards do
		show(c.view, Garage.build(id, wheelsId, PREVIEW_COLOR), KART_VIEW)
		c.stroke.Color = if id == kartId then PICKED else CARD
	end
	for id, c in wheelCards do
		c.stroke.Color = if id == wheelsId then PICKED else CARD
	end
	local characterId = player:GetAttribute("Character")
	for id, c in characterCards do
		c.stroke.Color = if id == characterId then PICKED else CARD
	end
	previewModel = Garage.build(kartId, wheelsId, PREVIEW_COLOR)
	local character = if typeof(characterId) == "string" then Mascots.KINDS[characterId] else nil
	if character then -- (your own avatar isn't shown: the kart's empty)
		Mascots.build(characterId, Mascots.SEAT, { parent = previewModel :: Model })
	end
	show(preview, previewModel :: Model, KART_VIEW)
	local kart = Garage.find(Garage.KARTS, kartId)
	local wheels = Garage.find(Garage.WHEELS, wheelsId)
	comboLabel.Text = (if character then characterName(characterId) .. "  •  " else "")
		.. (if kart then kart.name else "?") .. "  +  " .. (if wheels then wheels.name else "?") .. " wheels"
end

local function setOpen(open: boolean)
	panel.Visible = open
	if open then
		refresh()
	end
end

openButton.Activated:Connect(function()
	setOpen(not panel.Visible)
end)
closeButton.Activated:Connect(function()
	setOpen(false)
end)
for _, slot in { "Kart", "Wheels", "Character" } do
	player:GetAttributeChangedSignal(slot):Connect(function()
		if panel.Visible then
			refresh()
		end
	end)
end

-- No garage mid-race
local function onRacing()
	local racing = player:GetAttribute("Racing") == true
	openButton.Visible = not racing
	if racing then
		setOpen(false)
	end
end
player:GetAttributeChangedSignal("Racing"):Connect(onRacing)
onRacing()

RunService.RenderStepped:Connect(function()
	local model = previewModel
	if panel.Visible and model then
		model:PivotTo(CFrame.Angles(0, os.clock() * SPIN_SPEED, 0))
	end
end)
]]></ProtectedString>
