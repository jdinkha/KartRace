			{ kind = "Boost", point = 21, lane = 9 },
			{ kind = "Banner", point = 23, text = "FROZEN LAKE — SLIPPERY!" },
			{ kind = "Ice", from = 23, to = 27 },
			{ kind = "Banner", point = 28, text = "ICY BRIDGE — NO RAILS!" },
			{ kind = "Ice", from = 28, to = 30 },
			{ kind = "NoWalls", from = 28, to = 30 },
			{ kind = "Boost", point = 31, lane = 0 },
		},
	},
}

