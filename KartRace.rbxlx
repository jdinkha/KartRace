	StepStone = { "rbxassetid://87061775498714", 1.1 }, -- walking on anything else
	Coin = { "rbxassetid://93529351909119", 0.5 }, -- grabbing a coin (a little higher with every coin)
	ItemGet = { "rbxassetid://17780130154", 0.7 }, -- the item you got from a box
	BoxBreak = { "rbxassetid://9120801590", 1 }, -- an item box cracking open (a wooden snap and splinter)
}
-- Floors that get the soft grassy footstep
